# ===========================================
# Driving School - Production Environment
# ===========================================
# Скопируй в .env.docker и заполни значения

# База данных
DB_PASSWORD=your_secure_password
DATABASE_URL=postgresql://lena_user:your_secure_password@driving-school-postgres:5432/lena_driving_school?schema=public

# Better Auth (обязательно)
# Генерация: openssl rand -base64 32
BETTER_AUTH_SECRET=your_auth_secret
BETTER_AUTH_URL=https://driving-school.yourdomain.com
AUTH_TRUST_HOST=true

# OAuth Providers (опционально)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_YANDEX_ID=
AUTH_YANDEX_SECRET=
AUTH_VK_ID=
AUTH_VK_SECRET=
AUTH_TELEGRAM_BOT_TOKEN=

# Google Calendar (для синхронизации расписания)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Email (SMTP)
SMTP_HOST=mail.letar.best
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@letar.best
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=noreply@driving-school.yourdomain.com
SMTP_FROM_NAME=Автошкола

# Push Notifications (VAPID)
# Генерация: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@driving-school.yourdomain.com

# Telegram Bot (уведомления)
TELEGRAM_BOT_TOKEN=

# Application
NEXT_PUBLIC_APP_URL=https://driving-school.yourdomain.com

# Cron Secret (для защиты cron-эндпоинтов)
# Генерация: openssl rand -base64 32
CRON_SECRET=your_cron_secret

# API Logs retention (дней)
API_LOG_RETENTION_DAYS=30

# External APIs
NEXT_PUBLIC_DADATA_API_KEY=
NEXT_PUBLIC_YM_COUNTER_ID=

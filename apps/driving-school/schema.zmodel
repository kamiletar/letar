// ZenStack schema file for Driving School application
// Платформа для автошкол - управление расписанием занятий

datasource db {
  provider = "postgresql"
}

// Prisma Client generator — генерирует клиент в libs/driving-school-db/src/generated/prisma/
// Путь относительно сгенерированной schema.prisma в libs/driving-school-db/src/generated/
generator client {
  provider = "prisma-client"
  output   = "./prisma"
}

plugin prisma {
  provider = '@core/prisma'
  output = '../../libs/driving-school-db/src/generated/schema.prisma'
}

// TypeScript plugin (v3) - генерирует schema.ts для ZenStackClient
plugin typescript {
  provider = '@core/typescript'
  output = '../../libs/driving-school-db/src/generated'
}

// Access control plugin (v3)
plugin policy {
  provider = '@zenstackhq/plugin-policy'
}

// NOTE: В ZenStack v3 tanstack-query это runtime library, а не плагин генерации.
// Используй useClientQueries(schema) из @zenstackhq/tanstack-query/react

// Генерация Zod схем с UI метаданными для @letar/forms
plugin formSchema {
  provider = '../../libs/zenstack-form-plugin/dist/index.js'
  output = '../../libs/driving-school-db/src/generated/form-schemas'
}

// TODO: OpenAPI plugin не поддерживается в ZenStack v3 (pending redesign)
// Ранее был @zenstackhq/openapi — API работает через REST Handler

// ============================================================================
// AUTH TYPE (ZenStack v3.2.0)
// ============================================================================
// Кастомный тип для auth() - вместо массива roles используем булевые флаги,
// т.к. ZenStack v3 не поддерживает has()/in для массивов enum в auth()
// Баг: "ошибочный литерал массива" при auth().isOwner

type Auth {
  id                  String  @id
  isOwner             Boolean
  isModerator         Boolean
  isFreelanceInstructor Boolean

  @@auth
}

// ============================================================================
// CUSTOM PROCEDURES (ZenStack v3.2.0)
// ============================================================================

// --- Result Types ---

type TransferResult {
  success     Boolean
  transferId  String?
  error       String?
}

type AcceptTransferResult {
  success         Boolean
  newConnectionId String?
  error           String?
}

type ActionResult {
  success Boolean
  error   String?
}

type LessonResult {
  success   Boolean
  lessonId  String?
  error     String?
}

type EnrollmentResult {
  success       Boolean
  connectionId  String?
  requestId     String?
  error         String?
}

// --- Transfer Procedures ---

/// Инициировать передачу ученика другому инструктору
mutation procedure initiateTransfer(
  connectionId: String,
  toInstructorId: String,
  type: String,
  reason: String,
  transferBalance: Boolean
) : TransferResult

/// Принять запрос на передачу ученика
mutation procedure acceptTransfer(transferId: String) : AcceptTransferResult

/// Отклонить запрос на передачу ученика
mutation procedure rejectTransfer(transferId: String) : ActionResult

/// Отменить запрос на передачу (инициатор)
mutation procedure cancelTransfer(transferId: String) : ActionResult

/// Вернуть ученика обратно (для временных передач)
mutation procedure reclaimStudent(transferId: String) : ActionResult

// --- Lesson Procedures ---

/// Подтвердить занятие
mutation procedure confirmLesson(lessonId: String) : LessonResult

/// Отменить занятие
mutation procedure cancelLesson(lessonId: String, reason: String?) : LessonResult

/// Завершить занятие
mutation procedure completeLesson(lessonId: String, notes: String?) : LessonResult

/// Отметить неявку ученика
mutation procedure markNoShow(lessonId: String) : LessonResult

// --- Enrollment Procedures ---

/// Одобрить заявку на обучение
mutation procedure approveEnrollmentRequest(requestId: String) : EnrollmentResult

/// Отклонить заявку на обучение
mutation procedure rejectEnrollmentRequest(requestId: String, reason: String?) : EnrollmentResult


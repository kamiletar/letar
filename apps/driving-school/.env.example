__NEXT_EXPERIMENTAL_MCP_SERVER=true

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/driving_school?schema=public"

# Better Auth Configuration
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth Credentials
# Get from: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Better Auth URL (базовый URL приложения)
BETTER_AUTH_URL=http://localhost:3003

# Yandex OAuth
# Get from: https://oauth.yandex.ru/
AUTH_YANDEX_ID=
AUTH_YANDEX_SECRET=

# Telegram Bot
# Get from: https://t.me/BotFather
AUTH_TELEGRAM_BOT_ID=
AUTH_TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# VK OAuth
# Get from: https://vk.com/apps?act=manage
AUTH_VK_ID=
AUTH_VK_SECRET=

# Email (SMTP)
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=noreply@example.com

# DaData API (для автодополнения адресов)
# Get from: https://dadata.ru/
NEXT_PUBLIC_DADATA_API_KEY=

# Web Push (VAPID keys)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Admin
ADMIN_EMAIL=admin@example.com

# Development
EMAIL_USE_MAILHOG=false

# Cron Jobs
# Secret token for cron endpoints authentication
# Generate with: openssl rand -base64 32
CRON_SECRET=

# API Logs retention period in days (default: 30)
API_LOG_RETENTION_DAYS=30

# Dockerfile.production - для уже собранных приложений
# Build context: workspace root (C:\web\letar)

FROM node:24-slim AS tz

FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# zoneinfo для Alpine — не `apk add tzdata`, причина: .claude/docs/docker-prune-cold-layer-network-flake.md
COPY --from=tz /usr/share/zoneinfo /usr/share/zoneinfo
ENV TZ=Europe/Moscow

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Копируем уже собранный standalone output
COPY --chown=nextjs:nodejs apps/form-example/.next/standalone ./

# Копируем статику и public (не включаются в standalone автоматически)
COPY --chown=nextjs:nodejs apps/form-example/.next/static ./apps/form-example/.next/static
COPY --chown=nextjs:nodejs apps/form-example/public ./apps/form-example/public

USER nextjs

EXPOSE 3022

ENV PORT=3022
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/form-example/server.js"]

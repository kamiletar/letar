{
  "name": "form-example",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/form-example/src",
  "projectType": "application",
  "tags": ["type:app", "scope:form-example", "owner:letar"],
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dprint fmt",
        "cwd": "apps/form-example"
      },
      "cache": false,
      "metadata": {
        "description": "Format files with dprint",
        "technologies": ["dprint"]
      }
    },
    "zenstack:generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "zenstack generate && prisma generate",
        "cwd": "apps/form-example"
      },
      "dependsOn": [
        {
          "projects": ["@letar/zenstack-form-plugin"],
          "target": "build"
        }
      ],
      "cache": true,
      "inputs": [
        "{projectRoot}/schema.zmodel",
        "{projectRoot}/prisma/schema.prisma",
        {
          "runtime": "node -p process.platform"
        }
      ],
      "outputs": ["{projectRoot}/src/generated"]
    },
    "build": {},
    "typecheck:tsgo": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsgo --noEmit",
        "cwd": "apps/form-example"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/tsconfig.base.json", "{projectRoot}/tsconfig.json"],
      "metadata": {
        "description": "Type-check TypeScript files with tsgo (38x faster)",
        "technologies": ["typescript", "tsgo"]
      }
    }
  }
}

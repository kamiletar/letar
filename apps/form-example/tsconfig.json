{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"],
      "@letar/forms": ["../../libs/forms/src/index.ts"],
      "@letar/demo-protection": ["../../libs/demo-protection/src/index.ts"],
      "@letar/analytics": ["../../libs/analytics/src/index.ts"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": ["**/*.ts", "**/*.tsx", "next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "dist", "prisma"],
  "references": [
    {
      "path": "../../libs/demo-protection"
    },
    {
      "path": "../../libs/analytics"
    }
  ]
}

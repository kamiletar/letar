// @letar/forms Example App — schema.zmodel
// Run: npx zenstack generate
// This generates both Prisma client AND form schemas with UI metadata!

// Prisma 7: `url` в datasource-блоке схемы больше не поддерживается (P1012) — соединение
// задаётся только в prisma.config.ts (datasource.url), как у остальных приложений на ZenStack v3.
datasource db {
  provider = 'postgresql'
}

// Прежде здесь был ручной `generator client { provider = 'prisma-client-js' }` — устаревший
// паттерн (устаревший как минимум с мая 2026), который текущий ZenStack CLI молча игнорирует
// (`"generator" is not used by ZenStack and should be removed`), из-за чего `prisma/schema.prisma`
// переставал обновляться. Плагин `@core/prisma` сам вставляет минимальный `generator client` в
// производную схему — см. .claude/docs/zenstack-generated-prisma-client.md.
plugin prisma {
  provider = '@core/prisma'
  output = './prisma/schema.prisma'
}

// @letar/zenstack-form-plugin generates Zod schemas with .meta({ ui: {...} })
// provider — относительный путь к сборке, а не имя пакета: у form-example нет своего
// package.json (не участвует в bun workspaces), поэтому node_modules/@letar не резолвится —
// тот же приём, что и в apps/form-develop-app/schema.zmodel.
plugin formSchema {
  provider = '../../libs/zenstack-form-plugin/dist/index.js'
  output = './src/generated/form-schemas'
}

// ─── Enums ──────────────────────────────────────────────

enum Status {
  /// Active
  ACTIVE
  /// Archived
  ARCHIVED
  /// Draft
  DRAFT
}

enum ContactSubject {
  /// Technical Support
  SUPPORT
  /// Sales Inquiry
  SALES
  /// Feedback
  FEEDBACK
}

// ─── Models ─────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())

  name        String @meta("form.title", "Product Name") @meta("form.placeholder", "Enter product name")

  description String? @meta("form.title", "Description") @meta("form.fieldType", "textarea") @meta("form.placeholder", "Product description...")

  price       Float @meta("form.title", "Price") @meta("form.fieldType", "currency") @meta("form.props.min", 0)

  status      Status   @default(DRAFT) @meta("form.title", "Status")

  tags        String[] @meta("form.title", "Tags") @meta("form.fieldType", "tags") @meta("form.placeholder", "Add tag...")

  rating      Int      @default(0) @meta("form.title", "Rating") @meta("form.fieldType", "rating") @meta("form.props.count", 5)

  sku         String   @default("SKU-0000") @startsWith("SKU-") @trim() @upper() @meta("form.title", "SKU (native @startsWith/@trim/@upper)")

  website     String?  @url() @meta("form.title", "Website (native @url)")

  createdAt   DateTime @default(now()) @meta("form.exclude", true)
  updatedAt   DateTime @updatedAt @meta("form.exclude", true)
}

model Event {
  id        String   @id @default(cuid())

  name      String @meta("form.title", "Event Name")

  startsAt  DateTime @meta("form.title", "Starts At")

  endsAt    DateTime @meta("form.title", "Ends At (@@validate: must be after Starts At)")

  @@validate(endsAt > startsAt, "End date must be after start date", ["endsAt"])

  createdAt DateTime @default(now()) @meta("form.exclude", true)
}

model Contact {
  id        String         @id @default(cuid())

  name      String @meta("form.title", "Your Name") @meta("form.placeholder", "John Doe")

  email     String @meta("form.title", "Email") @meta("form.placeholder", "john@example.com")

  subject   ContactSubject @meta("form.title", "Subject")

  message   String @meta("form.title", "Message") @meta("form.fieldType", "textarea") @meta("form.placeholder", "How can we help?")

  createdAt DateTime       @default(now()) @meta("form.exclude", true)
}

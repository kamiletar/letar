// @letar/forms Example App — schema.zmodel
// Run: npx zenstack generate
// This generates both Prisma client AND form schemas with UI metadata!

// Prisma 7: `url` в datasource-блоке схемы больше не поддерживается (P1012) — соединение
// задаётся только в prisma.config.ts (datasource.url), как у остальных приложений на ZenStack v3.
datasource db {
  provider = 'postgresql'
}

// Прежде здесь был ручной `generator client { provider = 'prisma-client-js' }` — устаревший
// паттерн (устаревший как минимум с мая 2026), который текущий ZenStack CLI молча игнорирует
// (`"generator" is not used by ZenStack and should be removed`), из-за чего `prisma/schema.prisma`
// переставал обновляться. Плагин `@core/prisma` сам вставляет минимальный `generator client` в
// производную схему — см. .claude/docs/zenstack-generated-prisma-client.md.
plugin prisma {
  provider = '@core/prisma'
  output = './prisma/schema.prisma'
}

// @letar/zenstack-form-plugin generates Zod schemas with .meta({ ui: {...} })
// provider — относительный путь к сборке, а не имя пакета: у form-example нет своего
// package.json (не участвует в bun workspaces), поэтому node_modules/@letar не резолвится —
// тот же приём, что и в apps/form-develop-app/schema.zmodel.
plugin formSchema {
  provider = '../../libs/zenstack-form-plugin/dist/index.js'
  output = './src/generated/form-schemas'
}

// ─── Enums ──────────────────────────────────────────────

enum Status {
  /// Active
  ACTIVE
  /// Archived
  ARCHIVED
  /// Draft
  DRAFT
}

enum ContactSubject {
  /// Technical Support
  SUPPORT
  /// Sales Inquiry
  SALES
  /// Feedback
  FEEDBACK
}

// ─── Models ─────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())

  /// @form.title("Product Name")
  /// @form.placeholder("Enter product name")
  name        String

  /// @form.title("Description")
  /// @form.fieldType("textarea")
  /// @form.placeholder("Product description...")
  description String?

  /// @form.title("Price")
  /// @form.fieldType("currency")
  /// @form.props({ min: 0 })
  price       Float

  /// @form.title("Status")
  status      Status   @default(DRAFT)

  /// @form.title("Tags")
  /// @form.fieldType("tags")
  /// @form.placeholder("Add tag...")
  tags        String[]

  /// @form.title("Rating")
  /// @form.fieldType("rating")
  /// @form.props({ count: 5 })
  rating      Int      @default(0)

  /// @form.title("SKU (native @startsWith/@trim/@upper)")
  sku         String   @default("SKU-0000") @startsWith("SKU-") @trim() @upper()

  /// @form.title("Website (native @url)")
  website     String?  @url()

  /// @form.exclude
  createdAt   DateTime @default(now())
  /// @form.exclude
  updatedAt   DateTime @updatedAt
}

model Contact {
  id        String         @id @default(cuid())

  /// @form.title("Your Name")
  /// @form.placeholder("John Doe")
  name      String

  /// @form.title("Email")
  /// @form.placeholder("john@example.com")
  email     String

  /// @form.title("Subject")
  subject   ContactSubject

  /// @form.title("Message")
  /// @form.fieldType("textarea")
  /// @form.placeholder("How can we help?")
  message   String

  /// @form.exclude
  createdAt DateTime       @default(now())
}

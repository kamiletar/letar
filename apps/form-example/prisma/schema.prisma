datasource db {
    provider = "postgresql"
}

generator client {
    provider = "prisma-client-js"
}

enum Status {
    /// Active
    ACTIVE
    /// Archived
    ARCHIVED
    /// Draft
    DRAFT
}

enum ContactSubject {
    /// Technical Support
    SUPPORT
    /// Sales Inquiry
    SALES
    /// Feedback
    FEEDBACK
}

model Product {
    id String @id() @default(cuid())
    name String
    description String?
    price Float
    status Status @default(DRAFT)
    tags String[]
    rating Int @default(0)
    sku String @default("SKU-0000")
    website String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()
}

model Event {
    id String @id() @default(cuid())
    name String
    startsAt DateTime
    endsAt DateTime
    createdAt DateTime @default(now())
}

model Contact {
    id String @id() @default(cuid())
    name String
    email String
    subject ContactSubject
    message String
    createdAt DateTime @default(now())
}
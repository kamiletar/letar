datasource db {
    provider = "postgresql"
}

generator client {
    provider = "prisma-client-js"
}

enum Status {
    /// Active
    ACTIVE
    /// Archived
    ARCHIVED
    /// Draft
    DRAFT
}

enum ContactSubject {
    /// Technical Support
    SUPPORT
    /// Sales Inquiry
    SALES
    /// Feedback
    FEEDBACK
}

model Product {
    id String @id() @default(cuid())
    /// @form.title("Product Name")
    /// @form.placeholder("Enter product name")
    name String
    /// @form.title("Description")
    /// @form.fieldType("textarea")
    /// @form.placeholder("Product description...")
    description String?
    /// @form.title("Price")
    /// @form.fieldType("currency")
    /// @form.props({ min: 0 })
    price Float
    /// @form.title("Status")
    status Status @default(DRAFT)
    /// @form.title("Tags")
    /// @form.fieldType("tags")
    /// @form.placeholder("Add tag...")
    tags String[]
    /// @form.title("Rating")
    /// @form.fieldType("rating")
    /// @form.props({ count: 5 })
    rating Int @default(0)
    /// @form.title("SKU (native @startsWith/@trim/@upper)")
    sku String @default("SKU-0000")
    /// @form.title("Website (native @url)")
    website String?
    /// @form.exclude
    createdAt DateTime @default(now())
    /// @form.exclude
    updatedAt DateTime @updatedAt()
}

model Contact {
    id String @id() @default(cuid())
    /// @form.title("Your Name")
    /// @form.placeholder("John Doe")
    name String
    /// @form.title("Email")
    /// @form.placeholder("john@example.com")
    email String
    /// @form.title("Subject")
    subject ContactSubject
    /// @form.title("Message")
    /// @form.fieldType("textarea")
    /// @form.placeholder("How can we help?")
    message String
    /// @form.exclude
    createdAt DateTime @default(now())
}
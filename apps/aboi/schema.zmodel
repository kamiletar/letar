// ZenStack schema для НейроАбоИ (aboi)
// E1: User + Better Auth модели + UserProfile + Address + ConsentLog

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./prisma"
}

plugin prisma {
  provider = '@core/prisma'
  output = './src/generated/schema.prisma'
}

plugin typescript {
  provider = '@core/typescript'
  output = './src/generated'
}

plugin policy {
  provider = '@zenstackhq/plugin-policy'
}

// Генерация Zod схем с UI метаданными для @letar/forms
plugin formSchema {
  provider = '../../libs/zenstack-form-plugin/dist/index.js'
  output = './src/generated/form-schemas'
}

// ============================================================================
// AUTH TYPE (ZenStack v3.2.0)
// ============================================================================
// ZenStack v3 не поддерживает has()/in для массивов enum в auth(),
// поэтому используем булевые флаги. Заполняются в getEnhancedPrisma.
type Auth {
  id          String  @id
  isAdmin     Boolean
  isManager   Boolean
  isAnonymous Boolean

  @@auth
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  CUSTOMER
  MANAGER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ============================================================================
// AUTH MODELS (Better Auth)
// ============================================================================

/// Пользователь магазина — клиент, менеджер или админ.
/// Гостевые корзины представлены anonymous-юзерами (isAnonymous=true).
model User {
  id            String     @id @default(cuid())
  /// Имя (отображаемое)
  name          String?
  /// Email — уникален для не-anonymous; для anonymous может отсутствовать
  email         String     @unique
  /// Email подтверждён
  emailVerified Boolean    @default(false)
  /// URL аватара
  image         String?
  /// Телефон
  phone         String?
  /// Анонимный гость (Better Auth anonymous plugin)
  isAnonymous   Boolean    @default(false)
  /// Роли (BETTER_AUTH additionalFields: roles)
  roles         UserRole[] @default([CUSTOMER])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Better Auth связи
  accounts Account[]
  sessions Session[]

  // Профиль и адреса
  profile   UserProfile?
  addresses Address[]

  // Корзина
  cart Cart?

  // Заказы
  orders Order[]

  // Избранное
  wishlist Wishlist[]

  // Реферальная программа
  referral Referral?
  balance  UserBalance?

  // Согласие на обработку ПДн
  consentLogs ConsentLog[]

  // Владелец видит/редактирует своё, админ — всё
  @@allow('read,update', auth() != null && auth().id == id)
  @@allow('all', auth().isAdmin)
  // Создание разрешено только через Better Auth handler (не через ZenStack клиент)
  @@deny('create,delete', true)

  @@index([isAnonymous])
}

/// Better Auth — OAuth-аккаунт или email/password credential
model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Только Better Auth handler управляет этой моделью
  @@deny('all', true)
  @@unique([providerId, accountId])
  @@index([userId])
}

/// Better Auth — сессия пользователя
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@deny('all', true)
  @@index([userId])
  @@index([token])
}

/// Better Auth — токены верификации email и сброса пароля
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@deny('all', true)
  @@index([identifier])
}

// ============================================================================
// PROFILE / ADDRESSES
// ============================================================================

/// Расширенный профиль пользователя
model UserProfile {
  id     String @id @default(cuid())
  userId String @unique

  /// @form.title("Имя")
  firstName  String?
  /// @form.title("Фамилия")
  lastName   String?
  /// @form.title("Пол")
  gender     Gender?
  /// @form.title("Дата рождения")
  birthDate  DateTime?
  /// Метки предпочитаемых аффирмаций (мотивация, спокойствие, ...) — заложено для будущей персонализации
  preferredAffirmations String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@allow('all', auth() != null && auth().id == userId)
  @@allow('read', auth().isAdmin)
}

/// Адрес доставки. У одного пользователя может быть несколько адресов; isDefault помечает основной.
model Address {
  id     String @id @default(cuid())
  userId String

  /// @form.title("ФИО получателя")
  fullName   String
  /// @form.title("Телефон")
  phone      String
  /// @form.title("Страна")
  country    String  @default("RU")
  /// @form.title("Регион / область")
  region     String
  /// @form.title("Город")
  city       String
  /// @form.title("Улица")
  street     String
  /// @form.title("Дом")
  building   String
  /// @form.title("Квартира")
  apartment  String?
  /// @form.title("Индекс")
  postalCode String
  /// Адрес по умолчанию
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@allow('all', auth() != null && auth().id == userId)
  @@allow('read', auth().isAdmin)
  @@index([userId])
}

// ============================================================================
// CATALOG (E2)
// ============================================================================

/// Изображение — единая модель для всех загружаемых файлов (продукты, OG, и т.д.).
/// Файлы хранятся в `apps/aboi/uploads/<category>/<id>.<ext>` (bind mount в Docker),
/// сервируются через `/api/files/<category>/<id>.<ext>` с долгосрочным кэшем.
model Image {
  id           String  @id @default(cuid())
  /// Логическая папка (products, og, content, ...)
  category     String
  /// Имя файла как сохранено на диске (без пути)
  filename     String
  /// Путь относительно apps/aboi/uploads/ (например, products/abc123.jpg)
  path         String  @unique
  /// MIME-тип (image/jpeg, image/png, image/webp)
  mimeType     String
  /// Размер файла в байтах
  size         Int
  /// Ширина в пикселях
  width        Int?
  /// Высота в пикселях
  height       Int?
  /// Альт-текст (для a11y и SEO)
  alt          String?
  uploadedById String?

  createdAt DateTime @default(now())

  productImages ProductImage[]

  @@allow('read', true)
  @@allow('all', auth().isAdmin)
  @@index([category])
}

/// Товар — дизайн обоев. Цена в копейках за пог. метр.
/// Soft-delete через deletedAt — никогда не удаляем физически (на товар могут ссылаться заказы).
model Product {
  id              String  @id @default(cuid())
  /// URL-slug (генерится из name через slugify)
  /// @form.title("URL-идентификатор")
  /// @form.placeholder("kosmicheskij-orbit")
  slug            String  @unique
  /// @form.title("Название")
  /// @form.placeholder("Космический Орбит")
  name            String
  /// @form.title("Описание")
  /// @form.multiline
  description     String?
  /// Базовая цена в копейках за погонный метр
  /// @form.title("Цена за пог. метр (копейки)")
  pricePerMeter   Int
  /// Минимальная длина заказа в метрах (Decimal — точность до 1 см)
  /// @form.title("Минимальная длина (м)")
  minLengthMeters Decimal @default(1.0) @db.Decimal(6, 2)
  /// Зашитые в графику слова — для SEO/фильтров
  affirmations    String[] @default([])
  /// Опубликован — виден в каталоге
  published       Boolean  @default(false)
  /// Soft-delete
  deletedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images        ProductImage[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems Wishlist[]

  // Гость видит только опубликованные не-удалённые
  @@allow('read', published == true && deletedAt == null)
  @@allow('all', auth().isAdmin)

  @@index([slug])
  @@index([published, deletedAt])
}

/// Связь Product ↔ Image (m2m с порядком сортировки)
model ProductImage {
  id        String @id @default(cuid())
  productId String
  imageId   String
  /// Порядок сортировки в галерее (0 = первое, главное)
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  image   Image   @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@allow('read', true)
  @@allow('all', auth().isAdmin)

  @@unique([productId, imageId])
  @@index([productId, sortOrder])
}

// ============================================================================
// ORDERS (E4)
// ============================================================================

enum OrderStatus {
  /// Заказ оформлен, ждём подтверждения менеджером
  PLACED
  /// Менеджер подтвердил, ждём оплаты
  CONFIRMED
  /// Оплачен (на MVP — выставляется вручную админом)
  PAID
  /// В печати
  PRINTING
  /// Отгружен в СДЭК
  SHIPPED
  /// Доставлен
  DELIVERED
  /// Отменён
  CANCELLED
  /// Возвращён (с возвратом средств)
  REFUNDED
}

enum ShippingMethod {
  /// СДЭК до пункта выдачи
  CDEK_POINT
  /// СДЭК курьером
  CDEK_DOOR
  /// Менеджер свяжется и согласует доставку (для KZ/BY/нестандартных кейсов)
  MANAGER_CALL
}

enum PaymentMethod {
  /// Способ ещё не выбран (на MVP заказы в этом статусе)
  PENDING
  /// Оплата картой через Tinkoff (W1)
  TINKOFF
  /// По счёту через менеджера
  MANAGER
}

/// Заказ. Данные клиента (имя, email, телефон, адрес) копируются снэпшотом —
/// чтобы изменение профиля не меняло старый заказ.
model Order {
  id String @id @default(cuid())
  /// Человекочитаемый номер ORD-YYYYMMDD-XXXXX (генерится в placeOrder)
  orderNumber String @unique

  /// Owner — может быть null для гостевых заказов (тогда смотрим customerEmail)
  userId String?

  status         OrderStatus    @default(PLACED)
  shippingMethod ShippingMethod
  paymentMethod  PaymentMethod  @default(PENDING)

  // Снэпшоты данных клиента (на момент оформления)
  customerName  String
  customerEmail String
  customerPhone String

  /// Адрес целиком как JSON-снэпшот (страна, регион, город, улица, дом, квартира, индекс, raw для DaData)
  shippingAddressSnapshot Json

  // Итоговые суммы в копейках (Int)
  /// Сумма позиций без скидок и доставки
  itemsTotal      Int
  /// Скидка по промокоду (E6)
  discountTotal   Int @default(0)
  /// Списано с подарочного сертификата (E6)
  certificateApplied Int @default(0)
  /// Стоимость доставки (на MVP — 0, заполняется менеджером)
  shippingCost    Int @default(0)
  /// Итого к оплате (itemsTotal - discount - certificate + shipping)
  totalToPay      Int

  // Опциональные ссылки на промо (E6)
  promoCodeUsed     String?
  giftCertificateId String?

  /// Комментарий клиента
  customerNotes String?
  /// Внутренние заметки менеджера (не показываем клиенту)
  internalNotes String?

  /// Трек-номер СДЭК (W2)
  trackingNumber    String?
  /// UUID заказа в СДЭК (W2) — заполняется автоматически после создания заказа в СДЭК
  cdekOrderUuid     String?
  /// Код ПВЗ СДЭК (W2) — для тарифа CDEK_POINT, сохраняется из выбора клиента
  pvzCode           String?
  /// ID платежа в Tinkoff (W1)
  paymentExternalId String?

  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  // Owner и админ читают, никто не удаляет
  @@allow('read', auth() != null && (auth().id == userId || auth().isAdmin))
  @@allow('create', true)
  @@allow('update', auth().isAdmin)
  @@deny('delete', true)

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/// Позиция заказа со снэпшотом названия/изображения/цены продукта.
/// productId nullable — продукт могут soft-delete, заказ не теряем.
model OrderItem {
  id      String  @id @default(cuid())
  orderId String

  productId            String?
  productNameSnapshot  String
  productImageSnapshot String?
  /// Длина в метрах (Decimal с точностью 0.01)
  lengthMeters         Decimal @db.Decimal(6, 2)
  /// Цена за метр на момент заказа (копейки)
  unitPrice            Int
  /// Итого по позиции = lengthMeters × unitPrice (копейки)
  total                Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@allow('read', auth() != null)
  @@index([orderId])
}

// ============================================================================
// CART (E3)
// ============================================================================

enum CartStatus {
  /// Активная корзина пользователя/гостя
  ACTIVE
  /// Корзина превратилась в Order
  CONVERTED
  /// Заброшена (TTL прошёл, или явно очищена)
  ABANDONED
}

/// Корзина — одна активная на пользователя (anonymous или зарегистрированного).
/// При логине anonymous-юзера → mergeAnonymousAccount переносит userId на нового User.
model Cart {
  id     String     @id @default(cuid())
  userId String     @unique
  status CartStatus @default(ACTIVE)

  /// Когда корзина «протухает» — после TTL её можно ABANDONED, но не удаляем
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  // Только владелец видит/редактирует свою корзину; ZenStack-policies не учитывают
  // anonymous-сессии — они проверяются явно в server actions через requireUser().
  @@allow('all', auth() != null && auth().id == userId)
  @@allow('read', auth().isAdmin)

  @@index([status])
}

/// Позиция в корзине. unitPrice — снэпшот Product.pricePerMeter на момент добавления.
model CartItem {
  id     String @id @default(cuid())
  cartId String

  productId String
  /// Длина в метрах с точностью до 1 см
  lengthMeters Decimal @db.Decimal(6, 2)
  /// Снэпшот цены за пог. метр на момент добавления (копейки)
  unitPrice    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Доступ через cart — server actions проверяют ownership явно
  @@allow('read', auth() != null)
  @@unique([cartId, productId])
  @@index([cartId])
}

// ============================================================================
// REFERRALS (E7)
// ============================================================================

enum ReferralEarningStatus {
  PENDING
  APPROVED
  PAID
  REVERSED
}

enum BalanceTransactionType {
  REFERRAL_PAYOUT
  ORDER_USE
  ADJUST
}

model Referral {
  id          String  @id @default(cuid())
  ownerUserId String  @unique
  /// Уникальный код для ссылки `${BASE_URL}/?ref=<code>`
  code        String  @unique
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())

  owner        User                  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  attributions ReferralAttribution[]
  earnings     ReferralEarning[]

  @@allow('all', auth() != null && auth().id == ownerUserId)
  @@allow('read', auth().isAdmin)
}

/// Факт перехода по реферальной ссылке. До регистрации refereeUserId == null;
/// связка происходит при signup анонимного юзера → User.
model ReferralAttribution {
  id                 String   @id @default(cuid())
  referralId         String
  refereeUserId      String?
  /// Cookie-id анонимного посетителя (Better Auth anonymous user.id)
  visitorAnonymousId String?
  ipHash             String?
  attributedAt       DateTime @default(now())

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@allow('read', auth().isAdmin)
  @@index([referralId])
  @@index([refereeUserId])
  @@index([visitorAnonymousId])
}

model ReferralEarning {
  id             String                @id @default(cuid())
  referralId     String
  refereeUserId  String
  orderId        String                @unique
  /// Сумма бонуса в копейках
  amount         Int
  status         ReferralEarningStatus @default(PENDING)
  /// До какого момента «висит» PENDING (по умолчанию +14 дней с момента создания)
  pendingUntil   DateTime
  approvedAt     DateTime?
  paidAt         DateTime?
  reasonReversed String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@allow('read', auth() != null && (auth().isAdmin || auth().id == refereeUserId))
  @@allow('update', auth().isAdmin)
  @@index([status, pendingUntil])
}

/// Бонусный баланс пользователя.
model UserBalance {
  id             String @id @default(cuid())
  userId         String @unique
  balance        Int    @default(0)
  lifetimeEarned Int    @default(0)

  updatedAt DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions BalanceTransaction[]

  @@allow('read', auth() != null && auth().id == userId)
  @@allow('all', auth().isAdmin)
}

model BalanceTransaction {
  id            String                 @id @default(cuid())
  userBalanceId String
  amount        Int
  type          BalanceTransactionType
  orderId       String?
  performedAt   DateTime               @default(now())

  userBalance UserBalance @relation(fields: [userBalanceId], references: [id], onDelete: Cascade)

  @@allow('read', auth().isAdmin)
  @@index([userBalanceId])
}

// ============================================================================
// PROMO CODES (E6)
// ============================================================================

enum PromoType {
  /// Процентная скидка
  PERCENT
  /// Фиксированная сумма (копейки)
  FIXED
}

model Promo {
  id             String    @id @default(cuid())
  /// Код промокода (вводит клиент в чекауте; нормализуется в верхний регистр)
  code           String    @unique
  type           PromoType
  /// Если PERCENT — целое 1..100; если FIXED — копейки
  value          Int
  /// Минимальная сумма заказа для применения (копейки), null = без ограничения
  minOrderAmount Int?
  /// Максимум использований всего, null = без ограничения
  maxUses        Int?
  usedCount      Int       @default(0)
  validFrom      DateTime  @default(now())
  validUntil     DateTime?
  isActive       Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usages PromoUsage[]

  @@allow('all', auth().isAdmin)
  @@index([code])
}

/// Лог использования промокода — один раз на заказ.
model PromoUsage {
  id      String   @id @default(cuid())
  promoId String
  orderId String   @unique
  userId  String?
  usedAt  DateTime @default(now())

  promo Promo @relation(fields: [promoId], references: [id], onDelete: Cascade)

  @@allow('read', auth().isAdmin)
  @@index([promoId])
}

// ============================================================================
// GIFT CERTIFICATES (E6)
// ============================================================================

enum GiftTransactionReason {
  /// Покупка/выпуск сертификата (положительная сумма)
  PURCHASE
  /// Списание при оплате заказа (отрицательная сумма)
  REDEEM
  /// Корректировка админом
  ADJUST
}

model GiftCertificate {
  id              String   @id @default(cuid())
  /// Crockford Base32, 16 символов
  code            String   @unique
  /// Хэш PIN-а (4 цифры, bcrypt)
  pinHash         String
  /// Изначальный номинал (копейки)
  initialAmount   Int
  /// Текущий баланс (копейки) — UX-валюта, может расходоваться частями
  currentBalance Int
  /// Email получателя — кому был выдан/куплен сертификат
  issuedToEmail  String?
  /// Если был куплен в составе заказа (W6) — ссылка на тот заказ
  issuedByOrderId String?
  expiresAt       DateTime
  isActive        Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions GiftCertificateTransaction[]

  @@allow('all', auth().isAdmin)
  @@index([code])
  @@index([expiresAt, isActive])
}

model GiftCertificateTransaction {
  id            String                @id @default(cuid())
  certificateId String
  orderId       String?
  /// Дельта в копейках — положительная для PURCHASE/ADJUST(+), отрицательная для REDEEM
  amount        Int
  reason        GiftTransactionReason
  performedAt   DateTime              @default(now())

  certificate GiftCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@allow('read', auth().isAdmin)
  @@index([certificateId])
}

// ============================================================================
// WISHLIST (E5)
// ============================================================================

/// Избранное — m2m связь User ↔ Product.
model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@allow('all', auth() != null && auth().id == userId)
  @@allow('read', auth().isAdmin)

  @@unique([userId, productId])
  @@index([userId])
}

// ============================================================================
// 152-ФЗ — Лог согласий на обработку ПДн
// ============================================================================

/// Запись о согласии пользователя на обработку ПДн и cookie-категории.
/// Хранится для соответствия 152-ФЗ — необходимо предъявить при проверке РКН.
model ConsentLog {
  id     String  @id @default(cuid())
  userId String?

  /// Хэш IP (sha256, без соли — для дедупликации, не для деанонимизации)
  ipHash    String
  userAgent String?

  acceptedAnalytics  Boolean @default(false)
  acceptedMarketing  Boolean @default(false)
  acceptedFunctional Boolean @default(true)

  /// Версия текста политики, на которую дано согласие
  consentVersion String

  consentedAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@allow('create', true)
  @@allow('read', auth().isAdmin)
  @@index([userId])
  @@index([consentedAt])
}

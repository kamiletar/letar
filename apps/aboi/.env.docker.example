# Шаблон production env для aboi.
# Реальный .env.docker создаёт DeployAgent через /sync-env (не коммитится).

DB_PASSWORD=__GENERATE__

# Better Auth
BETTER_AUTH_SECRET=__GENERATE_HEX_32_BYTES__
BETTER_AUTH_URL=https://aboi.letar.best
AUTH_TRUST_HOST=true

# SMTP — Maddy
SMTP_HOST=mail.letar.best
SMTP_PORT=587
SMTP_USER=noreply@aboi.letar.best
SMTP_PASSWORD=__FROM_MADDY__
SMTP_FROM_EMAIL=noreply@aboi.letar.best
SMTP_FROM_NAME=НейроАбоИ

# Application
NEXT_PUBLIC_BASE_URL=https://aboi.letar.best

# Реферальная программа
ABOI_REFERRAL_PERCENT=12
ABOI_REFERRAL_PENDING_DAYS=14
ABOI_REFERRAL_COOKIE_TTL_DAYS=60

# Админ для seed (запустить вручную на проде один раз)
ABOI_ADMIN_EMAIL=vitaliy@neyroaboi.ru
ABOI_ADMIN_PASSWORD=__SET_STRONG__
ABOI_ADMIN_NAME=Виталий

# DaData — опционально (без токена адрес работает как обычный input)
NEXT_PUBLIC_DADATA_TOKEN=

# СДЭК API v2 — тестовые credential публичны, боевые выдаёт СДЭК после заключения договора
CDEK_CLIENT_ID=__FROM_CDEK__
CDEK_CLIENT_SECRET=__FROM_CDEK__
CDEK_TEST_MODE=false
CDEK_FROM_POSTAL_CODE=107076
CDEK_FROM_CITY=Москва

# Umami Analytics — staging счётчик создать в Umami (https://stats.letar.best)
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://stats.letar.best/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Я.Метрика — на staging не нужна (закрыто от индексации)
NEXT_PUBLIC_YM_COUNTER_ID=

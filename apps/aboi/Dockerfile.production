# Dockerfile.production — для уже собранных приложений (deploy-affected.sh
# выполняет nx build aboi на сервере перед docker build).
# Build context: workspace root (/home/deploy/lena)

FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Standalone output (включает все необходимые node_modules)
COPY --chown=nextjs:nodejs apps/aboi/.next/standalone ./

# Static и messages (не входят в standalone автоматически)
COPY --chown=nextjs:nodejs apps/aboi/.next/static ./apps/aboi/.next/static
COPY --chown=nextjs:nodejs apps/aboi/messages ./apps/aboi/messages

# Папка uploads — bind-mount в docker-compose, но создадим её на случай первого запуска
RUN mkdir -p ./apps/aboi/uploads && chown -R nextjs:nodejs ./apps/aboi/uploads

USER nextjs

EXPOSE 3018

ENV PORT=3018
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/aboi/server.js"]

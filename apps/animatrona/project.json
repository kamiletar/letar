{
  "name": "animatrona",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": [
    "@letar/query-provider",
    "@letar/electron-storage",
    "@letar/hooks",
    "zenstack-form-plugin"
  ],
  "sourceRoot": "apps/animatrona",
  "projectType": "application",
  "tags": [
    "type:app",
    "scope:animatrona",
    "owner:letar"
  ],
  "targets": {
    "dev": {
      "command": "nextron",
      "options": {
        "cwd": "apps/animatrona"
      }
    },
    "db:template": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Обновляет resources/template.db через prisma db push (используется в build/release таргетами и e2e-тестами)"
      },
      "options": {
        "command": "npx tsx scripts/db-template-safe.ts",
        "cwd": "apps/animatrona"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "db:template"
      ],
      "options": {
        "commands": [
          "npx tsx scripts/update-splash-version.ts",
          "npx tsx scripts/download-ffmpeg.ts",
          "npx tsx scripts/download-fpcalc.ts",
          "cd renderer && next build",
          "npx webpack --config main/webpack.config.js"
        ],
        "cwd": "apps/animatrona",
        "parallel": false,
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=8192"
        }
      }
    },
    "download-ffmpeg": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx scripts/download-ffmpeg.ts",
        "cwd": "apps/animatrona"
      }
    },
    "download-fpcalc": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx scripts/download-fpcalc.ts",
        "cwd": "apps/animatrona"
      }
    },
    "build:win": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx tsx scripts/update-splash-version.ts",
          "npx tsx scripts/download-ffmpeg.ts",
          "npx tsx scripts/download-fpcalc.ts",
          "cd renderer && next build",
          "npx tsx scripts/fix-standalone.ts",
          "npx webpack --config main/webpack.config.js",
          "node web-player/build.mjs --prod",
          "cd mobile-ui && bun run build",
          "npx electron-builder --win --publish never"
        ],
        "cwd": "apps/animatrona",
        "parallel": false,
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=8192"
        }
      }
    },
    "release:win": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "db:template"
      ],
      "options": {
        "commands": [
          "npx tsx scripts/update-splash-version.ts",
          "npx tsx scripts/download-ffmpeg.ts",
          "npx tsx scripts/download-fpcalc.ts",
          "cd renderer && next build",
          "npx tsx scripts/fix-standalone.ts",
          "npx webpack --config main/webpack.config.js",
          "node web-player/build.mjs --prod",
          "cd mobile-ui && bun run build",
          "npx electron-builder --win --publish always"
        ],
        "cwd": "apps/animatrona",
        "parallel": false,
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=8192"
        }
      }
    },
    "build:linux": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "db:template"
      ],
      "options": {
        "commands": [
          "npx tsx scripts/update-splash-version.ts",
          "npx tsx scripts/download-ffmpeg.ts",
          "npx tsx scripts/download-fpcalc.ts",
          "cd renderer && next build",
          "npx webpack --config main/webpack.config.js",
          "node web-player/build.mjs --prod",
          "cd mobile-ui && bun run build",
          "npx electron-builder --linux --publish never"
        ],
        "cwd": "apps/animatrona",
        "parallel": false,
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=8192"
        }
      }
    },
    "release:linux": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "db:template"
      ],
      "options": {
        "commands": [
          "npx tsx scripts/update-splash-version.ts",
          "npx tsx scripts/download-ffmpeg.ts",
          "npx tsx scripts/download-fpcalc.ts",
          "cd renderer && next build",
          "npx webpack --config main/webpack.config.js",
          "node web-player/build.mjs --prod",
          "cd mobile-ui && bun run build",
          "npx electron-builder --linux --publish always"
        ],
        "cwd": "apps/animatrona",
        "parallel": false,
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=8192"
        }
      }
    },
    "build:mac": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "db:template"
      ],
      "options": {
        "commands": [
          "npx tsx scripts/update-splash-version.ts",
          "cd renderer && next build",
          "npx webpack --config main/webpack.config.js",
          "node web-player/build.mjs --prod",
          "cd mobile-ui && bun run build",
          "npx electron-builder --mac --publish never"
        ],
        "cwd": "apps/animatrona",
        "parallel": false,
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=8192"
        }
      }
    },
    "release:mac": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "db:template"
      ],
      "options": {
        "commands": [
          "npx tsx scripts/update-splash-version.ts",
          "cd renderer && next build",
          "npx webpack --config main/webpack.config.js",
          "node web-player/build.mjs --prod",
          "cd mobile-ui && bun run build",
          "npx electron-builder --mac --publish always"
        ],
        "cwd": "apps/animatrona",
        "parallel": false,
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=8192"
        }
      }
    },
    "release:win-linux": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "db:template"
      ],
      "metadata": {
        "description": "Release для Windows и Linux (можно запускать с Windows)"
      },
      "options": {
        "commands": [
          "npx tsx scripts/update-splash-version.ts",
          "npx tsx scripts/download-ffmpeg.ts --platform all",
          "npx tsx scripts/download-fpcalc.ts --platform all",
          "cd renderer && next build",
          "npx tsx scripts/fix-standalone.ts",
          "npx webpack --config main/webpack.config.js",
          "node web-player/build.mjs --prod",
          "cd mobile-ui && bun run build",
          "npx electron-builder --win --linux --publish always"
        ],
        "cwd": "apps/animatrona",
        "parallel": false,
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=8192"
        }
      }
    },
    "test": {
      "dependsOn": [
        "zenstack:generate"
      ],
      "options": {
        "config": "vitest.config.ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{projectRoot}/eslint.config.mjs",
        {
          "externalDependencies": [
            "eslint"
          ]
        }
      ],
      "options": {
        "cwd": "apps/animatrona",
        "command": "eslint --no-error-on-unmatched-pattern main/**/*.{ts,tsx} renderer/**/*.{ts,tsx} shared/**/*.{ts,tsx}"
      }
    },
    "typecheck:tsgo": {
      "command": "tsgo --project apps/animatrona/tsconfig.json --noEmit",
      "dependsOn": [
        "zenstack:generate"
      ]
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Format files with dprint",
        "technologies": [
          "dprint"
        ]
      },
      "options": {
        "command": "dprint fmt {main,renderer,shared,preload}/**/*.{ts,tsx,json} *.{ts,json}",
        "cwd": "apps/animatrona"
      }
    },
    "zenstack:generate": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build",
        {
          "projects": [
            "@letar/zenstack-form-plugin"
          ],
          "target": "build"
        }
      ],
      "options": {
        "commands": [
          "zenstack generate --schema schema.zmodel",
          "prisma generate",
          "node -e \"const fs=require('fs'),p=require('path');const j='renderer/src/generated/migrations',t='prisma/migrations';if(!fs.existsSync(j)){fs.symlinkSync(p.resolve(t),p.resolve(j),'junction');console.log('Junction created: migrations')}\""
        ],
        "cwd": "apps/animatrona",
        "parallel": false
      }
    },
    "db:push": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "zenstack:generate"
      ],
      "cache": false,
      "options": {
        "command": "prisma db push",
        "cwd": "apps/animatrona"
      }
    },
    "db:push:data-loss": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "zenstack:generate"
      ],
      "cache": false,
      "metadata": {
        "description": "Сбросить dev БД и применить схему (потеря данных!)",
        "technologies": [
          "prisma"
        ]
      },
      "options": {
        "command": "prisma db push --accept-data-loss --force-reset",
        "cwd": "apps/animatrona"
      }
    },
    "db:reset": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "zenstack:generate"
      ],
      "cache": false,
      "metadata": {
        "description": "Сбросить БД и применить все миграции",
        "technologies": [
          "prisma"
        ]
      },
      "options": {
        "command": "prisma migrate reset",
        "cwd": "apps/animatrona"
      }
    },
    "db:reset:data-loss": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "zenstack:generate"
      ],
      "cache": false,
      "metadata": {
        "description": "Сбросить БД без подтверждения (потеря данных!)",
        "technologies": [
          "prisma"
        ]
      },
      "options": {
        "command": "prisma migrate reset --force",
        "cwd": "apps/animatrona"
      }
    },
    "db:studio": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "zenstack:generate"
      ],
      "options": {
        "command": "prisma studio",
        "cwd": "apps/animatrona"
      }
    },
    "db:seed": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "zenstack:generate"
      ],
      "options": {
        "command": "ts-node prisma/seed.ts",
        "cwd": "apps/animatrona"
      }
    },
    "db:migrate": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "zenstack:generate"
      ],
      "cache": false,
      "metadata": {
        "description": "Создать миграцию",
        "technologies": [
          "prisma",
          "electron"
        ]
      },
      "options": {
        "command": "cross-env CI= VERCEL= GITHUB_ACTIONS= GITLAB= NETLIFY= HEROKU= prisma migrate dev {args}",
        "forwardAllArgs": true,
        "cwd": "apps/animatrona"
      }
    },
    "db:migrate:deploy": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Apply pending migrations (production)",
        "technologies": [
          "prisma"
        ]
      },
      "options": {
        "command": "prisma migrate deploy",
        "cwd": "apps/animatrona"
      }
    },
    "release": {
      "command": "scripts/release.bat",
      "metadata": {
        "description": "Создать тег из текущей версии package.json и запушить для запуска GitHub Actions. ВАЖНО: версию нужно обновить вручную перед запуском!",
        "technologies": [
          "git",
          "github-actions"
        ]
      }
    },
    "build:web-player": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Собрать standalone web player для IPFS экспорта",
        "technologies": [
          "esbuild",
          "ipfs"
        ]
      },
      "options": {
        "command": "node web-player/build.mjs --prod",
        "cwd": "apps/animatrona"
      }
    },
    "build:web-player:dev": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Собрать web player (development mode с sourcemaps)"
      },
      "options": {
        "command": "node web-player/build.mjs",
        "cwd": "apps/animatrona"
      }
    }
  }
}

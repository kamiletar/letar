// Каталог аниме: франшизы, тайтлы, жанры, темы, связи, сезоны, эпизоды

import "./common"
import "./media"
import "./import"
import "./watch"
import "./settings"
import "./federation"
import "./social"
import "./shikimori"

enum AnimeStatus {
  /// Выходит
  ONGOING
  /// Завершён
  COMPLETED
  /// Анонсирован
  ANNOUNCED
}

enum SeasonType {
  /// ТВ-сериал
  TV
  /// OVA
  OVA
  /// ONA
  ONA
  /// Фильм
  MOVIE
  /// Спешл
  SPECIAL
}

enum RelationKind {
  /// Продолжение
  SEQUEL
  /// Предыстория
  PREQUEL
  /// Побочная история
  SIDE_STORY
  /// Родительская история
  PARENT_STORY
  /// Краткое содержание
  SUMMARY
  /// Полная версия
  FULL_STORY
  /// Спин-офф
  SPIN_OFF
  /// Адаптация
  ADAPTATION
  /// Общие персонажи
  CHARACTER
  /// Альтернативная версия
  ALTERNATIVE_VERSION
  /// Альтернативный сеттинг
  ALTERNATIVE_SETTING
  /// Другое
  OTHER
}

/// Франшиза — группа связанных аниме
/// Определяется через REST API /api/animes/{id}/franchise
/// Все аниме в одном графе = одна франшиза
model Franchise {
  id                    String    @id @default(cuid())

  /// Название франшизы (от root аниме)
  name                  String

  /// Минимальный shikimoriId из графа — стабильный ключ франшизы
  rootShikimoriId       Int?      @unique

  /// CID FranchiseGraphDocument в IPFS
  graphCid              String?

  /// Когда граф был обновлён (для автообновления раз в неделю)
  graphUpdatedAt        DateTime?

  animes                Anime[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@index([rootShikimoriId])
}

/// Аниме-тайтл
model Anime {
  id              String      @id @default(cuid())

  /// Русское название (приоритет) или английское если русского нет
  name            String @meta("form.title", "Название") @meta("form.placeholder", "Например: Стальной алхимик")

  /// Японское название (из Shikimori japanese)
  originalName    String? @meta("form.title", "Оригинальное название") @meta("form.placeholder", "Например: 鋼の錬金術師")

  /// Английское название (из Shikimori english)
  nameEn          String? @meta("form.exclude", true)

  /// Альтернативные названия (JSON массив строк с Shikimori)
  /// Например: ["Человек-бензопила", "История Резе", "Gekijouban Chainsaw Man"]
  synonyms        String? @meta("form.exclude", true)

  year            Int? @meta("form.title", "Год выпуска") @meta("form.fieldType", "numberInput") @meta("form.props.min", 1900) @meta("form.props.max", 2100)

  status          AnimeStatus @default(ONGOING) @meta("form.title", "Статус") @meta("form.fieldType", "radioCard")

  episodeCount    Int         @default(0) @meta("form.title", "Количество серий") @meta("form.fieldType", "numberInput") @meta("form.props.min", 0)

  /// Постер аниме (связь с File)
  posterId        String? @meta("form.exclude", true)
  poster          File?       @relation(fields: [posterId], references: [id], onDelete: SetNull)

  /// CID постера в IPFS
  posterCid       String? @meta("form.exclude", true)

  rating          Float? @meta("form.title", "Рейтинг") @meta("form.fieldType", "slider") @meta("form.props.min", 0) @meta("form.props.max", 10) @meta("form.props.step", 0.1) @meta("form.props.showValue", true)

  folderPath      String? @meta("form.title", "Путь к папке") @meta("form.description", "Путь к папке с файлами аниме")

  /// Источник — BDRemux/Bluray Remux (lossless качество)
  isBdRemux       Boolean     @default(false) @meta("form.exclude", true)

  /// CID каноничного AnimeInfo в IPFS (неизменяемые метаданные аниме)
  animeInfoCid    String? @meta("form.exclude", true)

  /// CID корневой IPFS-директории аниме (один рекурсивный pin = весь контент)
  directoryCid    String? @meta("form.exclude", true)
  /// Количество IPFS блоков в directoryCid
  directoryBlocks Int?
  /// Размер directoryCid в байтах
  directorySize   Int?

  /// Состояние контента после последней проверки/регенерации:
  /// 'complete' = всё на месте, 'degraded' = потеряны только косметические CID или шрифты,
  /// 'broken' = потеряны video/audio (нет смысла раздавать).
  contentHealth     String? @meta("form.exclude", true)
  /// JSON-массив missingCids — описание потерянных CID для UI-отчёта
  missingCidsJson   String? @meta("form.exclude", true)
  /// JSON-массив missingFonts — потерянные шрифты которые пользователь восстанавливает руками
  missingFontsJson  String? @meta("form.exclude", true)
  /// Когда последний раз проверяли health (буду перерегенерировать)
  lastHealthCheckAt DateTime? @meta("form.exclude", true)

  /// Возрастной рейтинг из Shikimori (g, pg, pg_13, r, r_plus, rx)
  ageRating       String? @meta("form.exclude", true)

  /// Контент запиннен локально в Kubo (false = только на удалённых пирах, Cloud Library)
  pinnedLocally   Boolean     @default(true) @meta("form.exclude", true)

  /// Требует перезаливки — контент раздавался через утраченный pinner-сервер (миграция
  /// backfill проставила true всей библиотеке на момент перехода на новую схему раздачи).
  /// Снимается вручную после успешного реимпорта/republish.
  needsReupload   Boolean     @default(false) @meta("form.exclude", true)

  /// Дата публикации на трекер (null = никогда не публиковалось)
  trackerPublishedAt DateTime? @meta("form.exclude", true)

  /// directoryCid на момент последней публикации (для сравнения с текущим)
  trackerPublishedCid String? @meta("form.exclude", true)

  /// ID аниме на трекере (кэш маппинга directoryCid → id, заполняется при регистрации
  /// раздачи в DistributionService — для быстрого lookup при push прогресса без похода
  /// за всем каталогом трекера)
  trackerAnimeId  String? @meta("form.exclude", true)

  /// ID на Shikimori для синхронизации метаданных
  shikimoriId     Int?        @unique @meta("form.exclude", true)

  /// URL раздачи на Rutracker (сохраняется при импорте)
  rutrackerUrl    String? @meta("form.exclude", true)

  /// CID сырых байт .torrent файла раздачи в IPFS (source/source.torrent в directoryCid)
  sourceTorrentCid String? @meta("form.exclude", true)

  /// Франшиза к которой принадлежит аниме
  franchiseId     String? @meta("form.exclude", true)
  franchise       Franchise?  @relation(fields: [franchiseId], references: [id], onDelete: SetNull)

  // Связи
  seasons         Season[]
  episodes        Episode[]
  genres          GenreOnAnime[]
  themes          ThemeOnAnime[]
  watchProgress   WatchProgress[]

  /// Связи с другими аниме (это аниме как источник)
  sourceRelations AnimeRelation[] @relation("SourceRelations")
  /// Связи с другими аниме (это аниме как цель)
  targetRelations AnimeRelation[] @relation("TargetRelations")

  // Расширенные метаданные теперь в AnimeManifest (IPFS)
  // Удалено в v0.28.0: studios, staff, characters, externalLinks, fandubbers, fansubbers, videos
  // Данные доступны через manifestCid → IPFS cat → AnimeManifest JSON

  /// Федеративный контент (импортирован из других трекеров) — v0.24.0
  federatedContent FederatedContent[]

  /// Последняя выбранная аудиодорожка (dubGroup) — сохраняется между эпизодами
  lastSelectedAudioDubGroup   String? @meta("form.exclude", true)

  /// Язык последней выбранной аудиодорожки — fallback если dubGroup не найден
  lastSelectedAudioLanguage   String? @meta("form.exclude", true)

  /// Последняя выбранная дорожка субтитров (dubGroup) — сохраняется между эпизодами
  lastSelectedSubtitleDubGroup String? @meta("form.exclude", true)

  /// Язык последних выбранных субтитров — fallback если dubGroup не найден
  lastSelectedSubtitleLanguage String? @meta("form.exclude", true)

  /// Когда последний раз проверяли связи с другими аниме (для UX: null = не проверяли, дата = проверяли)
  relationsCheckedAt DateTime? @meta("form.exclude", true)

  // === Статус просмотра (v0.9.0) ===

  watchStatus         WatchStatus @default(NOT_STARTED) @meta("form.title", "Статус просмотра") @meta("form.fieldType", "radioCard")

  /// Дата завершения просмотра
  watchedAt           DateTime? @meta("form.exclude", true)

  userRating          Int? @meta("form.title", "Оценка") @meta("form.fieldType", "slider") @meta("form.props.min", 0) @meta("form.props.max", 10) @meta("form.props.step", 1) @meta("form.props.showValue", true)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@index([name])
  @@index([year])
  @@index([status])
  @@index([shikimoriId])
  @@index([franchiseId])
  @@index([watchStatus])
}

/// Жанр
model Genre {
  id              String      @id @default(cuid())

  name            String      @unique @meta("form.title", "Название")

  slug            String      @unique @meta("form.title", "Slug")

  /// Название на русском (из Shikimori)
  nameRu          String?

  /// ID на Shikimori (для синхронизации)
  shikimoriId     Int?        @unique

  animes          GenreOnAnime[]

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)
}

/// Связь жанров и аниме (many-to-many)
model GenreOnAnime {
  anime           Anime       @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId         String

  genre           Genre       @relation(fields: [genreId], references: [id], onDelete: Cascade)
  genreId         String

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@id([animeId, genreId])
}

/// Тема аниме (Жестокость, Городское фэнтези, Школа и т.д.)
model Theme {
  id              String      @id @default(cuid())

  name            String      @unique @meta("form.title", "Название")

  /// Название на русском (из Shikimori)
  nameRu          String?

  /// ID на Shikimori (для синхронизации)
  shikimoriId     Int?        @unique

  animes          ThemeOnAnime[]

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@index([name])
}

model ThemeOnAnime {
  anime           Anime       @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId         String

  theme           Theme       @relation(fields: [themeId], references: [id], onDelete: Cascade)
  themeId         String

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@id([animeId, themeId])
}

/// Связь между двумя аниме (сиквел, приквел, спин-офф и т.д.)
model AnimeRelation {
  id                  String       @id @default(cuid())

  /// Исходное аниме (от которого идёт связь)
  sourceAnimeId       String
  sourceAnime         Anime        @relation("SourceRelations", fields: [sourceAnimeId], references: [id], onDelete: Cascade)

  /// ID связанного аниме на Shikimori (может быть не загружено в библиотеку)
  targetShikimoriId   Int

  /// ID связанного аниме в библиотеке (заполняется когда аниме загружено)
  targetAnimeId       String?
  targetAnime         Anime?       @relation("TargetRelations", fields: [targetAnimeId], references: [id], onDelete: SetNull)

  /// Тип связи
  relationKind        RelationKind

  createdAt           DateTime     @default(now())

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@unique([sourceAnimeId, targetShikimoriId])
  @@index([sourceAnimeId])
  @@index([targetAnimeId])
  @@index([targetShikimoriId])
}

/// Сезон аниме (TV, OVA, Movie и т.д.)
model Season {
  id              String      @id @default(cuid())

  anime           Anime       @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId         String

  number          Int         @default(1) @meta("form.title", "Номер сезона") @meta("form.fieldType", "numberInput") @meta("form.props.min", 1)

  name            String? @meta("form.title", "Название") @meta("form.placeholder", "Например: 2nd Season")

  type            SeasonType  @default(TV) @meta("form.title", "Тип") @meta("form.fieldType", "radioCard")

  year            Int? @meta("form.title", "Год выпуска") @meta("form.fieldType", "numberInput")

  episodeCount    Int         @default(0) @meta("form.title", "Количество эпизодов") @meta("form.fieldType", "numberInput")

  folderPath      String? @meta("form.title", "Путь к папке")

  episodes        Episode[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@unique([animeId, number])
  @@index([animeId])
}

/// Эпизод (серия)
model Episode {
  id              String      @id @default(cuid())

  anime           Anime       @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId         String

  season          Season?     @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  seasonId        String?

  number          Int @meta("form.title", "Номер серии") @meta("form.fieldType", "numberInput") @meta("form.props.min", 0)

  name            String? @meta("form.title", "Название")

  durationMs      Int? @meta("form.title", "Длительность (мс)") @meta("form.fieldType", "numberInput")

  /// Путь к папке эпизода (для сохранения прогресса в _user/)
  folderPath      String? @meta("form.exclude", true)

  // Метаданные видео (только те, что нужны для фильтрации)
  videoWidth      Int? @meta("form.exclude", true)
  videoHeight     Int? @meta("form.exclude", true)
  /// Битность цвета видео (8, 10, 12)
  videoBitDepth   Int? @meta("form.exclude", true)

  // Связи с дорожками
  audioTracks     AudioTrack[]
  subtitleTracks  SubtitleTrack[]
  importErrors    ImportError[]

  watchProgress   WatchProgress[]

  // === Настройки кодирования (v0.9.0) ===

  /// ID использованного профиля кодирования
  encodingProfileId     String? @meta("form.exclude", true)
  encodingProfile       EncodingProfile? @relation(fields: [encodingProfileId], references: [id], onDelete: SetNull)

  // === IPFS Storage ===

  /// CID транскодированного видео в IPFS
  transcodedCid         String? @meta("form.exclude", true)
  /// Размер видео в IPFS (байты)
  ipfsSize              Int?

  /// CID манифеста эпизода в IPFS
  manifestCid           String? @meta("form.exclude", true)

  /// JSON массив CID thumbnail'ов в IPFS
  thumbnailCids         String? @meta("form.exclude", true)

  /// JSON массив CID скриншотов в IPFS
  screenshotCids        String? @meta("form.exclude", true)

  /// CID seek-bar спрайта в IPFS (sprite.webp). Дублируется из ThumbnailsDocument
  /// чтобы переживать recovery — после регенерации обновляется тут, а ThumbnailsDocument
  /// строится заново из этих полей при необходимости.
  spriteCid             String? @meta("form.exclude", true)
  /// CID seek-bar VTT-файла в IPFS (sprite.vtt). См. spriteCid.
  vttCid                String? @meta("form.exclude", true)

  /// CID ChaptersDocument в IPFS (главы — OP/ED markers).
  /// Дублируется из EpisodeManifest.chaptersCid чтобы переживать recovery
  /// (detectIntros восстанавливает по video.webm, новый CID сохраняется тут).
  chaptersCid           String? @meta("form.exclude", true)

  /// CID metadata.json в IPFS (результат ffprobe)
  metadataCid           String? @meta("form.exclude", true)

  // sourceMetadataJson удалён в v0.29.0 — данные в EpisodeManifest (IPFS)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@unique([animeId, number])
  @@index([animeId])
  @@index([seasonId])
}

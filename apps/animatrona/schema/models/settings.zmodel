// Настройки приложения

import "./common"
import "./anime"
import "./media"
import "./import"
import "./watch"
import "./federation"
import "./social"
import "./shikimori"

/// Настройки приложения (singleton)
model Settings {
  id              String      @id @default("default")

  // === Транскодирование ===

  useGpu          Boolean     @default(true) @meta("form.title", "Использовать GPU") @meta("form.fieldType", "switch") @meta("form.description", "Использовать NVIDIA NVENC для транскодирования")

  videoCodec      VideoCodec  @default(AV1) @meta("form.title", "Видеокодек") @meta("form.fieldType", "radioCard")

  videoQuality    Int         @default(24) @meta("form.title", "Качество видео (CQ/CRF)") @meta("form.fieldType", "slider") @meta("form.props.min", 0) @meta("form.props.max", 51) @meta("form.props.showValue", true) @meta("form.description", "Меньше = лучше качество, больше размер")

  videoPreset     String      @default("p5") @meta("form.title", "Пресет скорости") @meta("form.fieldType", "select") @meta("form.props.options", ["p1","p2","p3","p4","p5","p6","p7"])

  audioBitrate    Int         @default(192) @meta("form.title", "Битрейт аудио (kbps)") @meta("form.fieldType", "slider") @meta("form.props.min", 64) @meta("form.props.max", 512) @meta("form.props.step", 32) @meta("form.props.showValue", true)

  // === Библиотека ===

  libraryPath     String? @meta("form.title", "Папка библиотеки") @meta("form.description", "Путь к папке с медиафайлами")

  outputPath      String? @meta("form.title", "Папка для транскодирования") @meta("form.description", "Куда сохранять перекодированные файлы")

  exportPath      String? @meta("form.title", "Папка экспорта по умолчанию") @meta("form.description", "Куда сохранять MKV файлы при экспорте")

  ipfsStorageMaxGb  Int  @default(500) @meta("form.title", "Макс. размер IPFS хранилища (ГБ)") @meta("form.fieldType", "slider") @meta("form.props.min", 10) @meta("form.props.max", 4000) @meta("form.props.step", 10) @meta("form.props.showValue", true) @meta("form.description", "Ограничение места для локального IPFS кеша")

  // === Системный трей ===

  minimizeToTray    Boolean     @default(true) @meta("form.title", "Сворачивать в трей") @meta("form.fieldType", "switch") @meta("form.description", "Приложение продолжит работать в фоне")

  closeToTray       Boolean     @default(true) @meta("form.title", "Закрытие окна в трей") @meta("form.fieldType", "switch") @meta("form.description", "При нажатии на крестик сворачивать в трей вместо закрытия")

  showTrayNotification Boolean  @default(true) @meta("form.title", "Показывать уведомление при сворачивании") @meta("form.fieldType", "switch") @meta("form.description", "Показывать уведомление при первом сворачивании в трей")

  // === Интерфейс ===

  darkMode        Boolean     @default(true) @meta("form.title", "Тёмная тема") @meta("form.fieldType", "switch")

  language        String      @default("ru") @meta("form.title", "Язык интерфейса") @meta("form.fieldType", "select") @meta("form.props.options", ["ru","en","ja"])

  // === Плеер ===

  skipOpening     Boolean     @default(false) @meta("form.title", "Автопропуск опенинга") @meta("form.fieldType", "switch")

  skipEnding      Boolean     @default(false) @meta("form.title", "Автопропуск эндинга") @meta("form.fieldType", "switch")

  autoplay        Boolean     @default(true) @meta("form.title", "Автовоспроизведение") @meta("form.fieldType", "switch")

  trackPreference TrackPreference @default(AUTO) @meta("form.title", "Предпочтение дорожек") @meta("form.fieldType", "radioCard") @meta("form.description", "Какие дорожки выбирать автоматически при первом просмотре")

  /// Профиль кодирования по умолчанию
  defaultProfileId String? @meta("form.exclude", true)
  defaultProfile  EncodingProfile? @relation(fields: [defaultProfileId], references: [id], onDelete: SetNull)

  // === Мобильный доступ ===

  mobileAccessEnabled Boolean   @default(false) @meta("form.title", "Мобильный доступ") @meta("form.fieldType", "switch") @meta("form.description", "Доступ к библиотеке с мобильных устройств в локальной сети")

  mobileServerPort    Int       @default(4000) @meta("form.title", "Порт мобильного сервера") @meta("form.fieldType", "numberInput") @meta("form.props.min", 1024) @meta("form.props.max", 65535) @meta("form.description", "HTTP порт для мобильного доступа")

  // === Торрент-клиент ===

  /// @form.props({ options: [{"value":"webtorrent","label":"WebTorrent (встроенный)"},{"value":"qbittorrent","label":"qBittorrent (рекомендуется)"}] })
  torrentBackend      String      @default("webtorrent") @meta("form.title", "Бэкенд торрент-клиента") @meta("form.fieldType", "radioCard") @meta("form.description", "WebTorrent качает в RAM → OOM на больших раздачах. qBittorrent работает отдельным процессом и качает на диск.")

  qbittorrentUrl      String? @meta("form.title", "URL qBittorrent Web UI") @meta("form.placeholder", "http://localhost:8080") @meta("form.description", "Адрес Web UI qBittorrent (Tools → Options → Web UI)")

  qbittorrentUsername String? @meta("form.title", "Логин qBittorrent") @meta("form.placeholder", "admin")

  qbittorrentPassword String? @meta("form.title", "Пароль qBittorrent") @meta("form.fieldType", "password")

  // === Миграции данных ===

  /// Флаг: главы мигрированы из SQLite в IPFS
  chaptersMigrated  Boolean     @default(false) @meta("form.exclude", true)

  updatedAt       DateTime    @updatedAt

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)
}

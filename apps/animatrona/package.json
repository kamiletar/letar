{
  "name": "@letar/animatrona",
  "version": "0.55.67",
  "private": true,
  "description": "Desktop application for anime transcoding and viewing with IPFS support",
  "author": "Kami Letar",
  "main": "app/main.js",
  "nx": {
    "name": "animatrona",
    "implicitDependencies": [
      "@letar/query-provider",
      "@letar/electron-storage",
      "@letar/hooks",
      "@letar/seed-utils",
      "@letar/icon-generator",
      "@letar/folder-scan",
      "@letar/folder-player-react",
      "@letar/zenstack-fragments"
    ]
  },
  "scripts": {
    "postinstall": "node -e \"process.platform!=='linux'&&require('child_process').execFileSync('npx', ['--no','@electron/rebuild','-f','-w','classic-level','-v','44.2.0'],{stdio:'inherit',shell:true})\" && node -e \"process.platform==='win32'&&require('child_process').execFileSync('node', ['../../node_modules/ntsuspend/install.cjs'],{stdio:'inherit',cwd:__dirname})\"",
    "postinstall:dev": "npx --no @electron/rebuild -f -w classic-level -v 44.2.0 && node -e \"process.platform==='win32'&&require('child_process').execFileSync('node', ['../../node_modules/ntsuspend/install.cjs'],{stdio:'inherit',cwd:__dirname})\""
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "@letar/electron-storage": "workspace:*",
    "@letar/folder-scan": "workspace:*",
    "@letar/hooks": "workspace:*",
    "@letar/icon-generator": "workspace:*",
    "@letar/query-provider": "workspace:*",
    "@letar/seed-utils": "workspace:*"
  },
  "devDependencies": {
    "electron": "44.2.0"
  }
}

{
  "name": "animatrona-mobile-ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/animatrona/mobile-ui/src",
  "tags": ["scope:animatrona", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build",
        "cwd": "apps/animatrona/mobile-ui"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite",
        "cwd": "apps/animatrona/mobile-ui"
      }
    }
  }
}

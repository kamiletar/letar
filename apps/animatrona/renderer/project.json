{
  "name": "animatrona-renderer",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/animatrona/renderer/src",
  "tags": [
    "type:app",
    "scope:animatrona",
    "platform:web",
    "owner:letar"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/out"
      ],
      "options": {
        "command": "next build",
        "cwd": "apps/animatrona/renderer"
      },
      "configurations": {
        "production": {
          "command": "next build"
        }
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next dev -p 3007",
        "cwd": "apps/animatrona/renderer"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "npx serve out -p 3007",
        "cwd": "apps/animatrona/renderer"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{projectRoot}/eslint.config.mjs",
        {
          "externalDependencies": [
            "eslint"
          ]
        }
      ],
      "options": {
        "cwd": "apps/animatrona/renderer",
        "command": "eslint --no-error-on-unmatched-pattern **/*.{ts,tsx}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/animatrona/renderer/tsconfig.json"
      }
    },
    "typecheck:tsgo": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsgo --noEmit -p apps/animatrona/renderer/tsconfig.json"
      }
    }
  }
}

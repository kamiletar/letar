{
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "incremental": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "paths": {
      "@/*": ["./src/*"],
      "@letar/ui": ["../../../libs/ui/src/index.ts"],
      "@letar/forms": ["../../../libs/forms/src/index.ts"],
      "@letar/forms/analytics": ["../../../libs/forms/src/lib/analytics/index.ts"],
      "@letar/forms/i18n": ["../../../libs/forms/src/lib/i18n/index.ts"],
      "@letar/forms/offline": ["../../../libs/forms/src/lib/offline/index.ts"],
      "@letar/forms/server-errors": ["../../../libs/forms/src/server/server-errors/index.ts"],
      "@letar/forms/testing": ["../../../libs/forms/src/lib/testing/index.ts"],
      "@letar/forms/validators/ru": ["../../../libs/forms/src/lib/validators/ru/index.ts"],
      "@letar/forms-core": ["../../../libs/forms-core/src/index.ts"],
      "@letar/forms-core/validators/ru": ["../../../libs/forms-core/src/lib/validators/ru/index.ts"],
      "@letar/forms-core/schema": ["../../../libs/forms-core/src/lib/schema/index.ts"],
      "@letar/forms-core/server-errors": ["../../../libs/forms-core/src/lib/server-errors/index.ts"],
      "@letar/forms-core/utils": ["../../../libs/forms-core/src/lib/utils/index.ts"],
      "@letar/forms-core/security": ["../../../libs/forms-core/src/lib/security/index.ts"],
      "@letar/forms-core/offline": ["../../../libs/forms-core/src/lib/offline/index.ts"],
      "@letar/forms-core/captcha": ["../../../libs/forms-core/src/lib/captcha/index.ts"],
      "@letar/forms-core/analytics": ["../../../libs/forms-core/src/lib/analytics/index.ts"],
      "@letar/query-provider": ["../../../libs/query-provider/src/index.ts"],
      "@letar/chakra-provider": ["../../../libs/chakra-provider/src/index.ts"],
      "@letar/video-player-core": ["../../../libs/video-player-core/src/index.ts"],
      "@letar/video-player-react": ["../../../libs/video-player-react/src/index.ts"],
      "@letar/animatrona-types": ["../../../libs/animatrona-types/src/index.ts"],
      "@letar/animatrona-utils": ["../../../libs/animatrona-utils/src/index.ts"],
      "@letar/animatrona-ui": ["../../../libs/animatrona-ui/src/index.ts"],
      "@letar/hooks": ["../../../libs/hooks/src/index.ts"],
      "@letar/folder-scan": ["../../../libs/folder-scan/src/index.ts"],
      "@letar/folder-player-react": ["../../../libs/folder-player-react/src/index.ts"],
      "@letar/forms/captcha/server": ["../../../libs/forms/src/server/captcha/verify.ts"],
      "@letar/forms-core/credit-card": ["../../../libs/forms-core/src/lib/credit-card/index.ts"],
      "@letar/forms-core/edit-intent": ["../../../libs/forms-core/src/lib/edit-intent/index.ts"],
      "@letar/forms-core/phone": ["../../../libs/forms-core/src/lib/phone/index.ts"],
      "@letar/forms-core/mask": ["../../../libs/forms-core/src/lib/mask/index.ts"],
      "@letar/forms-core/field-widgets": ["../../../libs/forms-core/src/lib/field-widgets/index.ts"],
      "@letar/forms-core/table": ["../../../libs/forms-core/src/lib/table/index.ts"],
      "@letar/forms-core/address": ["../../../libs/forms-core/src/lib/address/index.ts"],
      "@letar/forms-core/i18n": ["../../../libs/forms-core/src/lib/i18n/index.ts"],
      "@letar/forms-core/uikit": ["../../../libs/forms-core/src/lib/uikit/index.ts"],
      "@letar/forms-core/testing": ["../../../libs/forms-core/src/lib/testing/index.ts"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": ["node"],
    "target": "ES2022",
    "noUncheckedSideEffectImports": false,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/types/**/*.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "out"],
  "references": [
    {
      "path": "../../../libs/query-provider"
    },
    {
      "path": "../../../libs/video-player-core"
    },
    {
      "path": "../../../libs/animatrona-utils"
    },
    {
      "path": "../../../libs/animatrona-ui"
    },
    {
      "path": "../../../libs/ui"
    },
    {
      "path": "../../../libs/video-player-react"
    },
    {
      "path": "../../../libs/animatrona-types"
    },
    {
      "path": ".."
    },
    {
      "path": "../../../libs/forms"
    },
    {
      "path": "../../../libs/hooks"
    }
  ]
}

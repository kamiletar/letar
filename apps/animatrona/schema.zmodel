// ZenStack schema for Animatrona
// Electron приложение для транскодирования и просмотра аниме

datasource db {
  provider = "sqlite"
}

generator client {
  provider      = "prisma-client-js"
  output        = "./prisma"
  binaryTargets = ["native", "windows"]
}

plugin prisma {
  provider = "@core/prisma"
  output   = "./renderer/src/generated/schema.prisma"
}

// Access control plugin (v3)
plugin policy {
  provider = "@zenstackhq/plugin-policy"
}

// Плагин для генерации Zod схем с UI метаданными
plugin formSchema {
  provider = "../../libs/zenstack-form-plugin/dist/index.js"
  output   = "./renderer/src/generated/form-schemas"
}

// === Enum'ы ===

enum AnimeStatus {
  /// Выходит
  ONGOING
  /// Завершён
  COMPLETED
  /// Анонсирован
  ANNOUNCED
}

// AnimeSource и AgeRating удалены в v0.29.0 — данные в AnimeManifest (IPFS)

enum VideoCodec {
  /// AV1 (рекомендуется)
  AV1
  /// HEVC/H.265
  HEVC
  /// H.264
  H264
  /// Исходный кодек
  COPY
}

/// Предпочтения выбора дорожек при просмотре
enum TrackPreference {
  /// Русская озвучка + субтитры надписей
  RUSSIAN_DUB
  /// Оригинальная дорожка + полные субтитры
  ORIGINAL_SUB
  /// Автовыбор по доступности (русская если есть, иначе оригинал)
  AUTO
}

enum SeasonType {
  /// ТВ-сериал
  TV
  /// OVA
  OVA
  /// ONA
  ONA
  /// Фильм
  MOVIE
  /// Спешл
  SPECIAL
}

enum FileCategory {
  /// Постер аниме
  POSTER
  /// Скриншот эпизода
  SCREENSHOT
  /// Превью эпизода
  THUMBNAIL
  /// Шрифт субтитров
  FONT
}

enum RateControl {
  /// Variable Bitrate с CQ target (рекомендуется)
  VBR
  /// Constant QP (лучшее качество)
  CONSTQP
  /// Constant Quality
  CQ
}

enum Tune {
  /// Без tune
  NONE
  /// High Quality (рекомендуется для VBR)
  HQ
  /// Ultra High Quality (для Blackwell+)
  UHQ
  /// Ultra Low Latency
  ULL
  /// Low Latency
  LL
}

enum Multipass {
  /// Отключено
  DISABLED
  /// Quarter resolution (быстрее)
  QRES
  /// Full resolution (медленнее, лучше качество)
  FULLRES
}

enum BRefMode {
  /// Отключено
  DISABLED
  /// Каждый кадр
  EACH
  /// Средний кадр
  MIDDLE
}

enum RelationKind {
  /// Продолжение
  SEQUEL
  /// Предыстория
  PREQUEL
  /// Побочная история
  SIDE_STORY
  /// Родительская история
  PARENT_STORY
  /// Краткое содержание
  SUMMARY
  /// Полная версия
  FULL_STORY
  /// Спин-офф
  SPIN_OFF
  /// Адаптация
  ADAPTATION
  /// Общие персонажи
  CHARACTER
  /// Альтернативная версия
  ALTERNATIVE_VERSION
  /// Альтернативный сеттинг
  ALTERNATIVE_SETTING
  /// Другое
  OTHER
}

// УДАЛЕНО в v0.28.0: PersonRole, ExternalLinkKind, VideoKind
// Данные теперь в AnimeManifest (IPFS)

/// Статус просмотра аниме (как на Shikimori)
enum WatchStatus {
  /// Не начато
  NOT_STARTED
  /// Смотрю
  WATCHING
  /// Просмотрено
  COMPLETED
  /// Отложено
  ON_HOLD
  /// Брошено
  DROPPED
  /// Запланировано
  PLANNED
}

/// Статус пинирования CID на удалённых серверах
enum RemotePinStatus {
  /// Только в локальном Kubo — ещё не отправлено на удалённые пинеры
  LOCAL_ONLY
  /// Отправлено в очередь пинирования (pin-queue)
  PIN_QUEUED
  /// Подтверждено на ≥1 удалённом пинере
  PINNED_REMOTE
  /// Ошибка пинирования (будет повторена)
  FAILED
}

// === Модели ===

/// Статус пинирования отдельного CID на удалённых серверах.
///
/// Используется для безопасного GC локального Kubo:
/// - LOCAL_ONLY / PIN_QUEUED → обязательно держать рекурсивный пин (блоки только у нас)
/// - PINNED_REMOTE           → можно снять локальный пин (контент доступен с пинеров)
///
/// Создаётся при добавлении контента в IPFS, обновляется при подтверждении от pin-queue.
model PinStatus {
  id         String           @id @default(cuid())

  /// CID контента в IPFS (уникальный ключ)
  cid        String           @unique

  /// Текущий статус пинирования на удалённых серверах
  status     RemotePinStatus  @default(LOCAL_ONLY)

  /// Когда отправлено в pin-queue
  queuedAt   DateTime?

  /// Когда подтверждено на удалённом сервере
  pinnedAt   DateTime?

  /// Сообщение последней ошибки
  errorMsg   String?

  /// Количество неудачных попыток
  retryCount Int              @default(0)

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@allow('all', true)
  @@index([status])
  @@index([createdAt])
}

/// Файл (изображения, шрифты и т.д.)
model File {
  id           String       @id @default(cuid())

  /// Имя файла
  filename     String

  /// MIME-тип (image/jpeg, image/webp, font/ttf)
  mimeType     String

  /// Размер в байтах
  size         Int

  /// Ширина в пикселях (для изображений)
  width        Int?

  /// Высота в пикселях (для изображений)
  height       Int?

  /// Base64 blur placeholder для next/image
  blurDataURL  String?

  /// Категория файла
  category     FileCategory

  /// Источник (например, "shikimori")
  source       String?

  /// CID файла в IPFS — основной идентификатор
  cid          String?      @unique

  uploadedAt   DateTime     @default(now())

  // Обратные связи
  animePoster  Anime[]

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@index([category])
  @@index([uploadedAt])
}

/// Франшиза — группа связанных аниме
/// Определяется через REST API /api/animes/{id}/franchise
/// Все аниме в одном графе = одна франшиза
model Franchise {
  id                    String    @id @default(cuid())

  /// Название франшизы (от root аниме)
  name                  String

  /// Минимальный shikimoriId из графа — стабильный ключ франшизы
  rootShikimoriId       Int?      @unique

  /// CID FranchiseGraphDocument в IPFS
  graphCid              String?

  /// Когда граф был обновлён (для автообновления раз в неделю)
  graphUpdatedAt        DateTime?

  animes                Anime[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@index([rootShikimoriId])
}

/// Аниме-тайтл
model Anime {
  id              String      @id @default(cuid())

  /// @form.title("Название")
  /// @form.placeholder("Например: Стальной алхимик")
  /// Русское название (приоритет) или английское если русского нет
  name            String

  /// @form.title("Оригинальное название")
  /// @form.placeholder("Например: 鋼の錬金術師")
  /// Японское название (из Shikimori japanese)
  originalName    String?

  /// @form.exclude
  /// Английское название (из Shikimori english)
  nameEn          String?

  /// @form.exclude
  /// Альтернативные названия (JSON массив строк с Shikimori)
  /// Например: ["Человек-бензопила", "История Резе", "Gekijouban Chainsaw Man"]
  synonyms        String?

  /// @form.title("Год выпуска")
  /// @form.fieldType("numberInput")
  /// @form.props({ min: 1900, max: 2100 })
  year            Int?

  /// @form.title("Статус")
  /// @form.fieldType("radioCard")
  status          AnimeStatus @default(ONGOING)

  /// @form.title("Количество серий")
  /// @form.fieldType("numberInput")
  /// @form.props({ min: 0 })
  episodeCount    Int         @default(0)

  /// @form.exclude
  /// Постер аниме (связь с File)
  posterId        String?
  poster          File?       @relation(fields: [posterId], references: [id], onDelete: SetNull)

  /// @form.exclude
  /// CID постера в IPFS
  posterCid       String?

  /// @form.title("Рейтинг")
  /// @form.fieldType("slider")
  /// @form.props({ min: 0, max: 10, step: 0.1, showValue: true })
  rating          Float?

  /// @form.title("Путь к папке")
  /// @form.description("Путь к папке с файлами аниме")
  folderPath      String?

  /// @form.exclude
  /// Источник — BDRemux/Bluray Remux (lossless качество)
  isBdRemux       Boolean     @default(false)

  /// @form.exclude
  /// CID каноничного AnimeInfo в IPFS (неизменяемые метаданные аниме)
  animeInfoCid    String?

  /// @form.exclude
  /// CID корневой IPFS-директории аниме (один рекурсивный pin = весь контент)
  directoryCid    String?
  /// Количество IPFS блоков в directoryCid
  directoryBlocks Int?
  /// Размер directoryCid в байтах
  directorySize   Int?

  /// @form.exclude
  /// Состояние контента после последней проверки/регенерации:
  /// 'complete' = всё на месте, 'degraded' = потеряны только косметические CID или шрифты,
  /// 'broken' = потеряны video/audio (нет смысла раздавать).
  contentHealth     String?
  /// @form.exclude
  /// JSON-массив missingCids — описание потерянных CID для UI-отчёта
  missingCidsJson   String?
  /// @form.exclude
  /// JSON-массив missingFonts — потерянные шрифты которые пользователь восстанавливает руками
  missingFontsJson  String?
  /// @form.exclude
  /// Когда последний раз проверяли health (буду перерегенерировать)
  lastHealthCheckAt DateTime?

  /// @form.exclude
  /// Возрастной рейтинг из Shikimori (g, pg, pg_13, r, r_plus, rx)
  ageRating       String?

  /// @form.exclude
  /// Контент запиннен локально в Kubo (false = только на удалённых пирах, Cloud Library)
  pinnedLocally   Boolean     @default(true)

  /// @form.exclude
  /// Требует перезаливки — контент раздавался через утраченный pinner-сервер (миграция
  /// backfill проставила true всей библиотеке на момент перехода на новую схему раздачи).
  /// Снимается вручную после успешного реимпорта/republish.
  needsReupload   Boolean     @default(false)

  /// @form.exclude
  /// Дата публикации на трекер (null = никогда не публиковалось)
  trackerPublishedAt DateTime?

  /// @form.exclude
  /// directoryCid на момент последней публикации (для сравнения с текущим)
  trackerPublishedCid String?

  /// @form.exclude
  /// ID на Shikimori для синхронизации метаданных
  shikimoriId     Int?        @unique

  /// @form.exclude
  /// URL раздачи на Rutracker (сохраняется при импорте)
  rutrackerUrl    String?

  /// @form.exclude
  /// CID сырых байт .torrent файла раздачи в IPFS (source/source.torrent в directoryCid)
  sourceTorrentCid String?

  /// @form.exclude
  /// Франшиза к которой принадлежит аниме
  franchiseId     String?
  franchise       Franchise?  @relation(fields: [franchiseId], references: [id], onDelete: SetNull)

  // Связи
  seasons         Season[]
  episodes        Episode[]
  genres          GenreOnAnime[]
  themes          ThemeOnAnime[]
  watchProgress   WatchProgress[]

  /// Связи с другими аниме (это аниме как источник)
  sourceRelations AnimeRelation[] @relation("SourceRelations")
  /// Связи с другими аниме (это аниме как цель)
  targetRelations AnimeRelation[] @relation("TargetRelations")

  // Расширенные метаданные теперь в AnimeManifest (IPFS)
  // Удалено в v0.28.0: studios, staff, characters, externalLinks, fandubbers, fansubbers, videos
  // Данные доступны через manifestCid → IPFS cat → AnimeManifest JSON

  /// Федеративный контент (импортирован из других трекеров) — v0.24.0
  federatedContent FederatedContent[]

  /// @form.exclude
  /// Последняя выбранная аудиодорожка (dubGroup) — сохраняется между эпизодами
  lastSelectedAudioDubGroup   String?

  /// @form.exclude
  /// Язык последней выбранной аудиодорожки — fallback если dubGroup не найден
  lastSelectedAudioLanguage   String?

  /// @form.exclude
  /// Последняя выбранная дорожка субтитров (dubGroup) — сохраняется между эпизодами
  lastSelectedSubtitleDubGroup String?

  /// @form.exclude
  /// Язык последних выбранных субтитров — fallback если dubGroup не найден
  lastSelectedSubtitleLanguage String?

  /// @form.exclude
  /// Когда последний раз проверяли связи с другими аниме (для UX: null = не проверяли, дата = проверяли)
  relationsCheckedAt DateTime?

  // === Статус просмотра (v0.9.0) ===

  /// @form.title("Статус просмотра")
  /// @form.fieldType("radioCard")
  watchStatus         WatchStatus @default(NOT_STARTED)

  /// @form.exclude
  /// Дата завершения просмотра
  watchedAt           DateTime?

  /// @form.title("Оценка")
  /// @form.fieldType("slider")
  /// @form.props({ min: 0, max: 10, step: 1, showValue: true })
  userRating          Int?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@index([name])
  @@index([year])
  @@index([status])
  @@index([shikimoriId])
  @@index([franchiseId])
  @@index([watchStatus])
}

/// Жанр
model Genre {
  id              String      @id @default(cuid())

  /// @form.title("Название")
  name            String      @unique

  /// @form.title("Slug")
  slug            String      @unique

  /// ID на Shikimori (для синхронизации)
  shikimoriId     Int?        @unique

  animes          GenreOnAnime[]

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)
}

// ============================================================================
// УДАЛЕНО в v0.28.0: Studio, Person, Character, Fandubber, Fansubber, ExternalLink, Video
// Все расширенные метаданные теперь хранятся в AnimeManifest (IPFS)
// Доступ: anime.manifestCid → IPFS cat → JSON с полными данными
// ============================================================================

/// Связь жанров и аниме (many-to-many)
model GenreOnAnime {
  anime           Anime       @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId         String

  genre           Genre       @relation(fields: [genreId], references: [id], onDelete: Cascade)
  genreId         String

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@id([animeId, genreId])
}

/// Тема аниме (Жестокость, Городское фэнтези, Школа и т.д.)
model Theme {
  id              String      @id @default(cuid())

  /// @form.title("Название")
  name            String      @unique

  /// Название на русском (из Shikimori)
  nameRu          String?

  /// ID на Shikimori (для синхронизации)
  shikimoriId     Int?        @unique

  animes          ThemeOnAnime[]

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@index([name])
}

model ThemeOnAnime {
  anime           Anime       @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId         String

  theme           Theme       @relation(fields: [themeId], references: [id], onDelete: Cascade)
  themeId         String

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@id([animeId, themeId])
}

/// Связь между двумя аниме (сиквел, приквел, спин-офф и т.д.)
model AnimeRelation {
  id                  String       @id @default(cuid())

  /// Исходное аниме (от которого идёт связь)
  sourceAnimeId       String
  sourceAnime         Anime        @relation("SourceRelations", fields: [sourceAnimeId], references: [id], onDelete: Cascade)

  /// ID связанного аниме на Shikimori (может быть не загружено в библиотеку)
  targetShikimoriId   Int

  /// ID связанного аниме в библиотеке (заполняется когда аниме загружено)
  targetAnimeId       String?
  targetAnime         Anime?       @relation("TargetRelations", fields: [targetAnimeId], references: [id], onDelete: SetNull)

  /// Тип связи
  relationKind        RelationKind

  createdAt           DateTime     @default(now())

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@unique([sourceAnimeId, targetShikimoriId])
  @@index([sourceAnimeId])
  @@index([targetAnimeId])
  @@index([targetShikimoriId])
}

/// Сезон аниме (TV, OVA, Movie и т.д.)
model Season {
  id              String      @id @default(cuid())

  anime           Anime       @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId         String

  /// @form.title("Номер сезона")
  /// @form.fieldType("numberInput")
  /// @form.props({ min: 1 })
  number          Int         @default(1)

  /// @form.title("Название")
  /// @form.placeholder("Например: 2nd Season")
  name            String?

  /// @form.title("Тип")
  /// @form.fieldType("radioCard")
  type            SeasonType  @default(TV)

  /// @form.title("Год выпуска")
  /// @form.fieldType("numberInput")
  year            Int?

  /// @form.title("Количество эпизодов")
  /// @form.fieldType("numberInput")
  episodeCount    Int         @default(0)

  /// @form.title("Путь к папке")
  folderPath      String?

  episodes        Episode[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@unique([animeId, number])
  @@index([animeId])
}

/// Аудиодорожка эпизода
model AudioTrack {
  id              String      @id @default(cuid())

  episode         Episode     @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  episodeId       String

  /// Индекс дорожки в контейнере
  streamIndex     Int

  /// @form.title("Язык")
  /// @form.placeholder("ru, en, ja")
  language        String      @default("und")

  /// @form.title("Название")
  /// @form.placeholder("Например: Japanese 5.1")
  title           String?

  /// Название группы озвучки (имя папки-дублёра)
  /// Отображается в меню плеера как "Русский (FuegoAlma & Eladiel)"
  dubGroup        String?

  /// Кодек (aac, opus, flac, etc.)
  codec           String

  /// Каналы (2.0, 5.1, 7.1)
  channels        String

  /// Битрейт (bps)
  bitrate         Int?

  /// Дорожка по умолчанию
  isDefault       Boolean     @default(false)

  /// CID транскодированного аудио в IPFS
  transcodedCid   String?
  /// Размер аудиодорожки в IPFS (байты)
  ipfsSize        Int?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@index([episodeId])
}

/// Субтитры эпизода
model SubtitleTrack {
  id              String      @id @default(cuid())

  episode         Episode     @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  episodeId       String

  /// Индекс дорожки в контейнере (-1 для внешних файлов)
  streamIndex     Int         @default(-1)

  /// @form.title("Язык")
  language        String      @default("und")

  /// @form.title("Название")
  title           String?

  /// Название группы субтитров (имя папки-сабберов)
  /// Отображается в меню плеера как "Русский (AniDUB)"
  dubGroup        String?

  /// Тип субтитров: full (полные), signs (надписи), songs (песни)
  subtitleType    String      @default("full")

  /// Формат (ass, srt, vtt)
  format          String

  /// CID файла субтитров в IPFS
  fileCid         String?
  /// Размер субтитров в IPFS (байты)
  ipfsSize        Int?

  /// Дорожка по умолчанию
  isDefault       Boolean     @default(false)

  /// Шрифты для ASS субтитров
  fonts           SubtitleFont[]

  createdAt       DateTime    @default(now())

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@index([episodeId])
}

/// Шрифт для ASS субтитров
model SubtitleFont {
  id              String        @id @default(cuid())

  subtitleTrack   SubtitleTrack @relation(fields: [subtitleTrackId], references: [id], onDelete: Cascade)
  subtitleTrackId String

  /// Имя шрифта (как в ASS файле)
  fontName        String

  /// Расширение файла шрифта (ttf, otf, woff2 и т.д.)
  fileExt         String        @default("ttf")

  /// CID файла шрифта в IPFS
  fileCid         String?
  /// Размер шрифта в IPFS (байты)
  ipfsSize        Int?

  createdAt       DateTime      @default(now())

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@index([subtitleTrackId])
}

/// Ошибка при импорте дорожки
model ImportError {
  id              String    @id @default(cuid())

  /// Привязка к эпизоду
  episode         Episode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  episodeId       String

  /// Тип дорожки: audio | subtitle
  trackType       String
  /// Индекс потока в контейнере
  streamIndex     Int
  /// Язык дорожки
  language        String?
  /// Название / dubGroup
  title           String?

  /// Текст ошибки
  error           String
  /// Стадия: transcode | upload | create
  stage           String

  /// Путь к исходному файлу (для повтора)
  sourcePath      String?

  /// Исправлено (дорожка успешно добавлена позже)
  resolved        Boolean   @default(false)

  createdAt       DateTime  @default(now())

  @@allow('all', true)
  @@index([episodeId])
  @@index([resolved])
}

/// Эпизод (серия)
model Episode {
  id              String      @id @default(cuid())

  anime           Anime       @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId         String

  season          Season?     @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  seasonId        String?

  /// @form.title("Номер серии")
  /// @form.fieldType("numberInput")
  /// @form.props({ min: 0 })
  number          Int

  /// @form.title("Название")
  name            String?

  /// @form.title("Длительность (мс)")
  /// @form.fieldType("numberInput")
  durationMs      Int?

  /// @form.exclude
  /// Путь к папке эпизода (для сохранения прогресса в _user/)
  folderPath      String?

  // Метаданные видео (только те, что нужны для фильтрации)
  /// @form.exclude
  videoWidth      Int?
  /// @form.exclude
  videoHeight     Int?
  /// @form.exclude
  /// Битность цвета видео (8, 10, 12)
  videoBitDepth   Int?

  // Связи с дорожками
  audioTracks     AudioTrack[]
  subtitleTracks  SubtitleTrack[]
  importErrors    ImportError[]

  watchProgress   WatchProgress[]

  // === Настройки кодирования (v0.9.0) ===

  /// @form.exclude
  /// ID использованного профиля кодирования
  encodingProfileId     String?
  encodingProfile       EncodingProfile? @relation(fields: [encodingProfileId], references: [id], onDelete: SetNull)

  // === IPFS Storage ===

  /// @form.exclude
  /// CID транскодированного видео в IPFS
  transcodedCid         String?
  /// Размер видео в IPFS (байты)
  ipfsSize              Int?

  /// @form.exclude
  /// CID манифеста эпизода в IPFS
  manifestCid           String?

  /// @form.exclude
  /// JSON массив CID thumbnail'ов в IPFS
  thumbnailCids         String?

  /// @form.exclude
  /// JSON массив CID скриншотов в IPFS
  screenshotCids        String?

  /// @form.exclude
  /// CID seek-bar спрайта в IPFS (sprite.webp). Дублируется из ThumbnailsDocument
  /// чтобы переживать recovery — после регенерации обновляется тут, а ThumbnailsDocument
  /// строится заново из этих полей при необходимости.
  spriteCid             String?
  /// @form.exclude
  /// CID seek-bar VTT-файла в IPFS (sprite.vtt). См. spriteCid.
  vttCid                String?

  /// @form.exclude
  /// CID ChaptersDocument в IPFS (главы — OP/ED markers).
  /// Дублируется из EpisodeManifest.chaptersCid чтобы переживать recovery
  /// (detectIntros восстанавливает по video.webm, новый CID сохраняется тут).
  chaptersCid           String?

  /// @form.exclude
  /// CID metadata.json в IPFS (результат ffprobe)
  metadataCid           String?

  // sourceMetadataJson удалён в v0.29.0 — данные в EpisodeManifest (IPFS)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@unique([animeId, number])
  @@index([animeId])
  @@index([seasonId])
}

/// Прогресс просмотра
model WatchProgress {
  id              String      @id @default(cuid())

  anime           Anime       @relation(fields: [animeId], references: [id], onDelete: Cascade)
  animeId         String

  episode         Episode     @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  episodeId       String

  /// @form.title("Текущее время (сек)")
  currentTime     Float       @default(0)

  /// @form.title("Просмотрено полностью")
  /// @form.fieldType("switch")
  completed       Boolean     @default(false)

  /// ID выбранной аудиодорожки
  selectedAudioTrackId    String?

  /// ID выбранных субтитров (null = выключены)
  selectedSubtitleTrackId String?

  /// Громкость (0-1)
  volume          Float       @default(1)

  lastWatchedAt   DateTime    @default(now())

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@unique([animeId, episodeId])
  @@index([animeId])
  @@index([lastWatchedAt])
}

/// Прогресс просмотра из каталога (без FK на Anime/Episode)
model DiscoverWatchProgress {
  id                      String   @id @default(cuid())

  /// Shikimori ID аниме (стабильный ключ)
  shikimoriId             Int
  /// Номер эпизода
  episodeNumber           Int

  /// Текущее время (сек)
  currentTime             Float    @default(0)
  /// Длительность (сек)
  duration                Float    @default(0)
  /// Просмотрено полностью
  completed               Boolean  @default(false)

  /// ID аудиодорожки из манифеста
  selectedAudioTrackId    String?
  /// ID субтитров из манифеста
  selectedSubtitleTrackId String?

  /// Название аниме (для отображения в истории)
  animeName               String   @default("")
  /// CID постера (для отображения)
  posterCid               String?
  /// ID аниме на трекере (для навигации)
  trackerAnimeId          String?
  /// CID директории на IPFS (для резолва эпизода)
  directoryCid            String?

  lastWatchedAt           DateTime @default(now())

  @@allow('all', true)
  @@unique([shikimoriId, episodeNumber])
  @@index([lastWatchedAt])
}

/// Очередь синхронизации с трекером (offline queue)
model SyncQueueItem {
  id        String   @id @default(cuid())

  /// Тип операции: 'watchProgress' | 'librarySync' | 'profileSync'
  type      String

  /// JSON с данными для отправки
  payload   String

  createdAt DateTime @default(now())

  /// Количество попыток отправки
  retries   Int      @default(0)

  /// Последняя ошибка
  lastError String?

  @@allow('all', true)
  @@index([createdAt])
}

/// Настройки приложения (singleton)
model Settings {
  id              String      @id @default("default")

  // === Транскодирование ===

  /// @form.title("Использовать GPU")
  /// @form.fieldType("switch")
  /// @form.description("Использовать NVIDIA NVENC для транскодирования")
  useGpu          Boolean     @default(true)

  /// @form.title("Видеокодек")
  /// @form.fieldType("radioCard")
  videoCodec      VideoCodec  @default(AV1)

  /// @form.title("Качество видео (CQ/CRF)")
  /// @form.fieldType("slider")
  /// @form.props({ min: 0, max: 51, showValue: true })
  /// @form.description("Меньше = лучше качество, больше размер")
  videoQuality    Int         @default(24)

  /// @form.title("Пресет скорости")
  /// @form.fieldType("select")
  /// @form.props({ options: ["p1", "p2", "p3", "p4", "p5", "p6", "p7"] })
  videoPreset     String      @default("p5")

  /// @form.title("Битрейт аудио (kbps)")
  /// @form.fieldType("slider")
  /// @form.props({ min: 64, max: 512, step: 32, showValue: true })
  audioBitrate    Int         @default(192)

  // === Библиотека ===

  /// @form.title("Папка библиотеки")
  /// @form.description("Путь к папке с медиафайлами")
  libraryPath     String?

  /// @form.title("Папка для транскодирования")
  /// @form.description("Куда сохранять перекодированные файлы")
  outputPath      String?

  /// @form.title("Папка экспорта по умолчанию")
  /// @form.description("Куда сохранять MKV файлы при экспорте")
  exportPath      String?

  /// @form.title("Макс. размер IPFS хранилища (ГБ)")
  /// @form.fieldType("slider")
  /// @form.props({ min: 10, max: 4000, step: 10, showValue: true })
  /// @form.description("Ограничение места для локального IPFS кеша")
  ipfsStorageMaxGb  Int  @default(500)

  // === Системный трей ===

  /// @form.title("Сворачивать в трей")
  /// @form.fieldType("switch")
  /// @form.description("Приложение продолжит работать в фоне")
  minimizeToTray    Boolean     @default(true)

  /// @form.title("Закрытие окна в трей")
  /// @form.fieldType("switch")
  /// @form.description("При нажатии на крестик сворачивать в трей вместо закрытия")
  closeToTray       Boolean     @default(true)

  /// @form.title("Показывать уведомление при сворачивании")
  /// @form.fieldType("switch")
  /// @form.description("Показывать уведомление при первом сворачивании в трей")
  showTrayNotification Boolean  @default(true)

  // === Интерфейс ===

  /// @form.title("Тёмная тема")
  /// @form.fieldType("switch")
  darkMode        Boolean     @default(true)

  /// @form.title("Язык интерфейса")
  /// @form.fieldType("select")
  /// @form.props({ options: ["ru", "en", "ja"] })
  language        String      @default("ru")

  // === Плеер ===

  /// @form.title("Автопропуск опенинга")
  /// @form.fieldType("switch")
  skipOpening     Boolean     @default(false)

  /// @form.title("Автопропуск эндинга")
  /// @form.fieldType("switch")
  skipEnding      Boolean     @default(false)

  /// @form.title("Автовоспроизведение")
  /// @form.fieldType("switch")
  autoplay        Boolean     @default(true)

  /// @form.title("Предпочтение дорожек")
  /// @form.fieldType("radioCard")
  /// @form.description("Какие дорожки выбирать автоматически при первом просмотре")
  trackPreference TrackPreference @default(AUTO)

  /// @form.exclude
  /// Профиль кодирования по умолчанию
  defaultProfileId String?
  defaultProfile  EncodingProfile? @relation(fields: [defaultProfileId], references: [id], onDelete: SetNull)

  // === Мобильный доступ ===

  /// @form.title("Мобильный доступ")
  /// @form.fieldType("switch")
  /// @form.description("Доступ к библиотеке с мобильных устройств в локальной сети")
  mobileAccessEnabled Boolean   @default(false)

  /// @form.title("Порт мобильного сервера")
  /// @form.fieldType("numberInput")
  /// @form.props({ min: 1024, max: 65535 })
  /// @form.description("HTTP порт для мобильного доступа")
  mobileServerPort    Int       @default(4000)

  // === Торрент-клиент ===

  /// @form.title("Бэкенд торрент-клиента")
  /// @form.fieldType("radioCard")
  /// @form.props({ options: [{"value":"webtorrent","label":"WebTorrent (встроенный)"},{"value":"qbittorrent","label":"qBittorrent (рекомендуется)"}] })
  /// @form.description("WebTorrent качает в RAM → OOM на больших раздачах. qBittorrent работает отдельным процессом и качает на диск.")
  torrentBackend      String      @default("webtorrent")

  /// @form.title("URL qBittorrent Web UI")
  /// @form.placeholder("http://localhost:8080")
  /// @form.description("Адрес Web UI qBittorrent (Tools → Options → Web UI)")
  qbittorrentUrl      String?

  /// @form.title("Логин qBittorrent")
  /// @form.placeholder("admin")
  qbittorrentUsername String?

  /// @form.title("Пароль qBittorrent")
  /// @form.fieldType("password")
  qbittorrentPassword String?

  // === Миграции данных ===

  /// @form.exclude
  /// Флаг: главы мигрированы из SQLite в IPFS
  chaptersMigrated  Boolean     @default(false)

  updatedAt       DateTime    @updatedAt

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)
}

/// Профиль кодирования
model EncodingProfile {
  id              String       @id @default(cuid())

  /// @form.title("Название")
  /// @form.placeholder("Например: Blackwell UHQ")
  name            String

  /// Встроенный или пользовательский
  isBuiltIn       Boolean      @default(false)

  /// @form.title("Профиль по умолчанию")
  /// @form.fieldType("switch")
  isDefault       Boolean      @default(false)

  // === Видео ===

  /// @form.title("Видеокодек")
  /// @form.fieldType("radioCard")
  codec           VideoCodec   @default(AV1)

  /// @form.title("Использовать GPU")
  /// @form.fieldType("switch")
  useGpu          Boolean      @default(true)

  // === Rate Control ===

  /// @form.title("Rate Control")
  /// @form.fieldType("radioCard")
  rateControl     RateControl  @default(VBR)

  /// @form.title("Качество (CQ/CRF)")
  /// @form.fieldType("slider")
  /// @form.props({ min: 15, max: 40, showValue: true })
  /// @form.description("Меньше = лучше качество, больше размер")
  cq              Int          @default(28)

  /// @form.title("Макс. битрейт (Mbps)")
  /// @form.fieldType("numberInput")
  /// @form.props({ min: 1, max: 100 })
  /// @form.description("Для VBR режима")
  maxBitrate      Int?

  // === Качество ===

  /// @form.title("Пресет скорости")
  /// @form.fieldType("select")
  /// @form.props({ options: ["p1", "p2", "p3", "p4", "p5", "p6", "p7"] })
  preset          String       @default("p5")

  /// @form.title("Tune")
  /// @form.fieldType("radioCard")
  tune            Tune         @default(HQ)

  /// @form.title("Multipass")
  /// @form.fieldType("radioCard")
  multipass       Multipass    @default(DISABLED)

  // === Adaptive Quantization ===

  /// @form.title("Spatial AQ")
  /// @form.fieldType("switch")
  /// @form.description("Улучшает качество плоских областей")
  spatialAq       Boolean      @default(true)

  /// @form.title("Temporal AQ")
  /// @form.fieldType("switch")
  /// @form.description("Адаптирует качество для движущихся сцен")
  temporalAq      Boolean      @default(true)

  /// @form.title("AQ Strength")
  /// @form.fieldType("slider")
  /// @form.props({ min: 1, max: 15, showValue: true })
  aqStrength      Int          @default(8)

  // === Lookahead ===

  /// @form.title("Lookahead Frames")
  /// @form.fieldType("slider")
  /// @form.props({ min: 0, max: 250, showValue: true })
  /// @form.description("Количество кадров для анализа (0 = авто)")
  lookahead       Int?

  /// @form.title("Lookahead Level")
  /// @form.fieldType("slider")
  /// @form.props({ min: 0, max: 3, showValue: true })
  lookaheadLevel  Int?

  // === Keyframes ===

  /// @form.title("GOP Size")
  /// @form.fieldType("numberInput")
  /// @form.props({ min: 1, max: 600 })
  /// @form.description("Расстояние между ключевыми кадрами")
  gopSize         Int          @default(240)

  /// @form.title("B-Ref Mode")
  /// @form.fieldType("radioCard")
  bRefMode        BRefMode     @default(DISABLED)

  // === 10-bit ===

  /// @form.title("Принудительно 10-bit")
  /// @form.fieldType("switch")
  /// @form.description("Выводить 10-bit даже для 8-bit источника")
  force10Bit      Boolean      @default(false)

  // === Blackwell-специфичные ===

  /// @form.title("Temporal Filter")
  /// @form.fieldType("switch")
  /// @form.description("Blackwell+ только: +4-5% качества при движении")
  temporalFilter  Boolean      @default(false)

  // === CPU Fallback ===

  /// @form.title("Предпочитать CPU")
  /// @form.fieldType("switch")
  /// @form.description("Принудительно использовать libsvtav1 вместо NVENC")
  preferCpu       Boolean      @default(false)

  // === Фильтры ===

  /// @form.title("Deband фильтр")
  /// @form.fieldType("switch")
  /// @form.description("Убирает banding в градиентах (может вызывать краши на тяжёлых файлах)")
  deband          Boolean      @default(true)

  // Обратные связи
  settings        Settings[]
  episodes        Episode[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@index([isBuiltIn])
  @@index([isDefault])
}

/// Статус элемента очереди импорта
enum ImportQueueItemStatus {
  /// Ожидает в очереди
  PENDING
  /// Подбор оптимального CQ через VMAF
  VMAF
  /// Подготовка (создание аниме, demux)
  PREPARING
  /// Транскодирование
  TRANSCODING
  /// Постобработка (скриншоты, манифесты)
  POSTPROCESS
  /// Завершён успешно
  COMPLETED
  /// Ошибка
  ERROR
  /// Отменён пользователем
  CANCELLED
}

/// Элемент очереди импорта
/// Хранит настройки из wizard'а для последовательной обработки
model ImportQueueItem {
  id              String                @id @default(cuid())

  /// Статус обработки
  status          ImportQueueItemStatus @default(PENDING)

  /// Приоритет (меньше = раньше)
  priority        Int                   @default(0)

  /// Время добавления в очередь
  addedAt         DateTime              @default(now())

  /// Время начала обработки
  startedAt       DateTime?

  /// Время завершения
  completedAt     DateTime?

  /// JSON с полными данными ImportQueueEntry (folderPath, selectedAnime, files, etc.)
  dataJson        String

  /// Сообщение об ошибке (если status = ERROR)
  error           String?

  /// Прогресс обработки (0-100)
  progress        Int                   @default(0)

  /// Текущий обрабатываемый файл
  currentFileName String?

  /// ID созданного аниме в БД (для отката при ошибке)
  createdAnimeId  String?

  /// Путь к папке аниме в библиотеке (для отката)
  createdAnimeFolder String?

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@index([status])
  @@index([priority])
  @@index([addedAt])
}

/// Скачанный торрент — метаданные для persist между сессиями
model TorrentDownload {
  id            String   @id @default(cuid())

  /// InfoHash торрента (уникальный идентификатор)
  infoHash      String   @unique

  /// Magnet URI для восстановления после перезапуска
  magnetURI     String

  /// Название торрента
  name          String?

  /// Папка скачивания
  downloadPath  String

  /// Статус торрента: adding, downloading, seeding, paused, done, error
  status        String   @default("adding")

  /// Статус импорта: none, queued, imported
  importStatus  String   @default("none")

  /// Целевой ratio для авто-остановки сидирования
  targetRatio   Float    @default(2.0)

  /// Shikimori ID для кнопки «В очередь»
  shikimoriId   Int?

  /// Название аниме (из Shikimori)
  animeName     String?

  /// URL раздачи на Rutracker
  rutrackerUrl  String?

  /// CID сырых байт .torrent файла раздачи в IPFS (заполняется после получения метаданных)
  torrentFileCid String?

  /// Раздача содержит несколько отдельных аниме (набор/bundle)
  isBundle      Boolean  @default(false)

  /// JSON массив аниме в наборе: [{shikimoriId, animeName}]
  bundleAnimesJson String?

  /// Сообщение об ошибке
  error         String?

  /// Битфилд для fast resume (Base64, пропуск полной верификации)
  bitfield      String?

  /// Mtime файлов для мгновенного старта без хэширования (JSON массив)
  fileModtimes  String?

  addedAt       DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Подписка на библиотеку другого пользователя (P2P Sharing)
model Subscription {
  id            String   @id @default(cuid())

  /// IPNS имя (PeerId) владельца библиотеки
  ipnsName      String   @unique

  /// Имя для отображения (задаётся пользователем)
  displayName   String

  /// Последний известный CID библиотеки
  lastKnownCid  String?

  /// Когда последний раз проверяли обновления
  lastCheckedAt DateTime?

  /// Автоматически пиннить контент из этой подписки
  autoPin       Boolean  @default(false)

  /// Лимит автопининга в байтах (0 = без лимита)
  autoPinLimit  Int      @default(0)

  /// Дата создания подписки
  createdAt     DateTime @default(now())

  /// Дата обновления
  updatedAt     DateTime @updatedAt

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@index([ipnsName])
  @@index([lastCheckedAt])
}

// ============================================================================
// Federation — Федерация трекеров (Phase 2)
// ============================================================================

/// Уровень доверия к трекеру
enum TrustLevel {
  /// Заблокирован — никакие операции не разрешены
  BLOCKED
  /// Не доверенный — по умолчанию
  UNTRUSTED
  /// Известный — проверен пользователем
  KNOWN
  /// Доверенный — автоматический импорт
  TRUSTED
  /// Верифицированный — полное доверие
  VERIFIED
}

/// Удалённый трекер в федеративной сети
model Tracker {
  id                  String        @id @default(cuid())

  /// URL трекера (уникальный идентификатор)
  url                 String        @unique

  /// Название трекера
  name                String

  /// Описание трекера
  description         String?

  /// Тема контента (anime, drama, movie и т.д.)
  theme               String        @default("anime")

  /// Основной язык контента
  language            String        @default("ru")

  /// PEM-кодированный публичный ключ для верификации подписей
  publicKeyPem        String?

  // === Trust System ===

  /// Уровень доверия
  trustLevel          TrustLevel    @default(UNTRUSTED)

  /// Процент uptime (0-100)
  uptimePercent       Float         @default(0)

  /// Среднее время ответа в мс
  avgResponseTimeMs   Int           @default(0)

  /// Качество контента (0-1)
  contentQuality      Float         @default(0)

  /// Количество успешных синхронизаций
  successfulSyncs     Int           @default(0)

  /// Количество неудачных синхронизаций
  failedSyncs         Int           @default(0)

  // === Stats ===

  /// Количество синхронизированного контента
  contentSynced       Int           @default(0)

  /// Последняя успешная синхронизация
  lastSyncAt          DateTime?

  /// Последняя проверка доступности
  lastCheckedAt       DateTime?

  // === Связи ===

  /// Импортированный контент
  importedContent     FederatedContent[]

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@index([trustLevel])
  @@index([lastSyncAt])
  @@index([lastCheckedAt])
}

/// Федеративный контент — импортированный из другого трекера
model FederatedContent {
  id                  String        @id @default(cuid())

  /// Трекер-источник
  trackerId           String
  tracker             Tracker       @relation(fields: [trackerId], references: [id], onDelete: Cascade)

  /// ID контента на удалённом трекере
  remoteId            String

  /// Связь с локальным аниме (если было импортировано)
  animeId             String?
  anime               Anime?        @relation(fields: [animeId], references: [id], onDelete: SetNull)

  /// JSON данные VideoSeriesObject
  contentJson         String

  // === Внешние ID для дедупликации ===

  /// MyAnimeList ID
  malId               Int?

  /// AniList ID
  anilistId           Int?

  /// Shikimori ID
  shikimoriId         Int?

  /// AniDB ID
  anidbId             Int?

  /// Когда был получен контент
  receivedAt          DateTime      @default(now())

  /// Когда был обновлён
  updatedAt           DateTime      @updatedAt

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  /// Уникальность по трекеру и remoteId
  @@unique([trackerId, remoteId])

  @@index([trackerId])
  @@index([animeId])
  @@index([malId])
  @@index([anilistId])
  @@index([shikimoriId])
}

/// Настройки федерации (singleton)
model FederationSettings {
  id                      String      @id @default("default")

  /// Федерация включена
  enabled                 Boolean     @default(false)

  /// Название этого трекера в сети
  trackerName             String      @default("My Animatrona")

  /// Описание этого трекера
  trackerDescription      String?

  /// Тема контента (anime, drama, movie)
  theme                   String      @default("anime")

  /// Основной язык контента
  language                String      @default("ru")

  /// Автоматическая синхронизация с доверенными трекерами
  autoSync                Boolean     @default(true)

  /// Интервал автосинхронизации в минутах
  syncIntervalMinutes     Int         @default(60)

  /// Минимальный trust level для автоимпорта (1=UNTRUSTED, 2=KNOWN, 3=TRUSTED, 4=VERIFIED)
  minTrustForAutoImport   Int         @default(3)

  // === Криптография ===

  /// Приватный ключ RSA-2048 (PEM, зашифрован)
  privateKeyPem           String?

  /// Публичный ключ RSA-2048 (PEM)
  publicKeyPem            String?

  updatedAt               DateTime    @updatedAt

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)
}

// ============================================================================
// Reputation System — Phase 3 (Gamification)
// ============================================================================

/// Ранги пользователя (для репутации)
enum UserRank {
  /// 0-19 очков — новичок
  NEWCOMER
  /// 20-39 очков — контрибьютор
  CONTRIBUTOR
  /// 40-59 очков — постоянный участник
  REGULAR
  /// 60-79 очков — ветеран
  VETERAN
  /// 80-100 очков — легенда
  LEGEND
}

/// Тип транзакции бонусных очков
enum BonusTransactionType {
  /// Заработок за раздачу
  EARNING
  /// Награда за достижение
  ACHIEVEMENT
  /// Трата очков
  SPENDING
  /// Бонус (промо, ивенты)
  BONUS
  /// Корректировка (админ)
  ADJUSTMENT
}

/// Уровень достижения
enum AchievementTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

/// Статистика пользователя (singleton)
model UserStats {
  id                    String   @id @default("default")

  /// Всего байт загружено (upload)
  bytesUploaded         BigInt   @default(0)

  /// Всего байт скачано (download)
  bytesDownloaded       BigInt   @default(0)

  /// Общее время раздачи в мс
  totalSeedingTimeMs    BigInt   @default(0)

  /// Время текущей сессии раздачи в мс
  currentSessionMs      BigInt   @default(0)

  /// Количество уникального контента (CID), который раздаётся
  uniqueContentSeeded   Int      @default(0)

  /// Общее количество пиров, которым помогли
  peersHelped           Int      @default(0)

  /// Дата первой раздачи
  firstSeedAt           DateTime?

  /// Дата последней активности
  lastActiveAt          DateTime @default(now())

  /// Дневная статистика
  dailyStats            DailyStats[]

  updatedAt             DateTime @updatedAt

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)
}

/// Дневная статистика
model DailyStats {
  id                String    @id @default(cuid())

  /// Связь с UserStats
  userStatsId       String    @default("default")
  userStats         UserStats @relation(fields: [userStatsId], references: [id], onDelete: Cascade)

  /// Дата в формате YYYY-MM-DD
  date              String

  /// Байты загружено (upload)
  bytesUploaded     BigInt    @default(0)

  /// Байты скачано (download)
  bytesDownloaded   BigInt    @default(0)

  /// Время раздачи в мс
  seedingTimeMs     BigInt    @default(0)

  /// Количество уникальных пиров, которым помогли
  peersHelped       Int       @default(0)

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@unique([userStatsId, date])
  @@index([date])
}

/// Репутация пользователя (singleton)
model UserReputation {
  id                    String   @id @default("default")

  /// Общий score (0-100)
  score                 Int      @default(0)

  /// Текущий ранг
  rank                  UserRank @default(NEWCOMER)

  // === Компоненты score ===

  /// Score за соотношение upload/download (0-30)
  ratioScore            Int      @default(0)

  /// Score за время раздачи (0-25)
  seedingTimeScore      Int      @default(0)

  /// Score за количество уникального контента (0-20)
  uniqueContentScore    Int      @default(0)

  /// Score за помощь пирам (0-15)
  helpedPeersScore      Int      @default(0)

  /// Score за время в сообществе (0-10)
  longevityScore        Int      @default(0)

  updatedAt             DateTime @updatedAt

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)
}

/// Разблокированное достижение пользователя
model UserAchievement {
  id              String          @id @default(cuid())

  /// ID достижения (из enum AchievementId)
  achievementId   String

  /// Дата получения
  unlockedAt      DateTime        @default(now())

  /// Было ли показано уведомление
  notified        Boolean         @default(false)

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@unique([achievementId])
  @@index([unlockedAt])
}

/// Прогресс достижения
model AchievementProgress {
  id              String   @id @default(cuid())

  /// ID достижения
  achievementId   String   @unique

  /// Прогресс (0-100)
  progress        Int      @default(0)

  updatedAt       DateTime @updatedAt

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)
}

/// Бонусные очки пользователя (singleton)
model UserBonusPoints {
  id              String              @id @default("default")

  /// Текущий баланс
  balance         Int                 @default(0)

  /// Всего заработано
  totalEarned     Int                 @default(0)

  /// Всего потрачено
  totalSpent      Int                 @default(0)

  /// История транзакций
  transactions    BonusTransaction[]

  updatedAt       DateTime            @updatedAt

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)
}

/// Транзакция бонусных очков
model BonusTransaction {
  id              String               @id @default(cuid())

  /// Связь с UserBonusPoints
  bonusPointsId   String               @default("default")
  bonusPoints     UserBonusPoints      @relation(fields: [bonusPointsId], references: [id], onDelete: Cascade)

  /// Тип транзакции
  type            BonusTransactionType

  /// Сумма (положительная для начисления, отрицательная для траты)
  amount          Int

  /// Баланс после транзакции
  balanceAfter    Int

  /// Описание
  description     String

  /// Метаданные в JSON (achievementId, contentCid, itemId, multipliers)
  metadataJson    String?

  createdAt       DateTime             @default(now())

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)

  @@index([type])
  @@index([createdAt])
}

/// Профиль пользователя для P2P синхронизации (singleton)
/// Заменяет OrbitDB UserProfileDB — хранится в SQLite, публикуется через IPNS
model LocalUserProfile {
  id              String      @id @default("default")

  /// PeerId ноды (из Kubo или Helia)
  peerId          String

  /// Friend Code (XXXX-XXXX) для добавления в друзья
  friendCode      String      @unique

  /// Отображаемое имя
  displayName     String      @default("Анонимус")

  /// URL аватара (data URL, IPFS CID или внешний URL)
  avatarUrl       String?

  /// Цвет аватара (для генерации дефолтного)
  avatarColor     String?

  /// Статус (пользовательский текст)
  status          String?

  /// IPNS ключ для публикации профиля (CID последней публикации)
  ipnsPublishedCid String?

  /// Время последней IPNS публикации
  ipnsPublishedAt DateTime?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Политики доступа (desktop приложение без аутентификации)
  @@allow('all', true)
}

/// Друг в P2P сети
/// Хранит информацию о принятых друзьях для PresenceSync
model Friend {
  /// PeerId друга (уникальный идентификатор)
  peerId          String      @id

  /// Friend Code друга
  friendCode      String

  /// Отображаемое имя
  displayName     String

  /// URL аватара
  avatarUrl       String?

  /// Онлайн-статус
  isOnline        Boolean     @default(false)

  /// JSON-encoded WatchingInfo (что смотрит)
  watchingJson    String?

  /// Последний раз видели онлайн
  lastSeenAt      DateTime?

  /// Когда стали друзьями
  friendsSince    DateTime    @default(now())

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@allow('all', true)
  @@index([isOnline])
}

/// Запрос в друзья (входящий/исходящий)
model FriendRequest {
  id              String      @id @default(cuid())

  /// PeerId отправителя
  fromPeerId      String

  /// Friend Code отправителя
  fromFriendCode  String

  /// Имя отправителя
  fromDisplayName String

  /// PeerId получателя
  toPeerId        String

  /// Статус: pending, accepted, rejected, blocked
  status          String      @default("pending")

  /// Время отправки
  sentAt          DateTime    @default(now())

  /// Время ответа
  respondedAt     DateTime?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@allow('all', true)
  @@index([fromPeerId, toPeerId, status])
  @@index([toPeerId, status])
}

// =====================================================
// Кэш Shikimori сущностей (персоны, студии, персонажи)
// =====================================================
// Персистентный кэш для изображений — не перекачиваем
// и не перезаливаем в IPFS то, что уже загрузили.
// Также полезен для будущего поиска по персонам/студиям.

model ShikimoriStudio {
  id              String      @id @default(cuid())

  /// Shikimori ID студии (уникальный)
  shikimoriId     Int         @unique

  /// Название студии
  name            String

  /// URL логотипа с Shikimori
  imageUrl        String?

  /// CID логотипа в IPFS (null = ещё не загружен)
  imageCid        String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@allow('all', true)
  @@index([name])
}

model ShikimoriPerson {
  id              String      @id @default(cuid())

  /// Shikimori ID персоны (уникальный)
  shikimoriId     Int         @unique

  /// Имя (латиницей)
  name            String

  /// Имя на русском
  nameRu          String?

  /// URL изображения с Shikimori
  imageUrl        String?

  /// CID изображения в IPFS (null = ещё не загружен)
  imageCid        String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@allow('all', true)
  @@index([name])
  @@index([nameRu])
}

model ShikimoriCharacter {
  id              String      @id @default(cuid())

  /// Shikimori ID персонажа (уникальный)
  shikimoriId     Int         @unique

  /// Имя (латиницей)
  name            String

  /// Имя на русском
  nameRu          String?

  /// URL изображения с Shikimori
  imageUrl        String?

  /// CID изображения в IPFS (null = ещё не загружен)
  imageCid        String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@allow('all', true)
  @@index([name])
  @@index([nameRu])
}

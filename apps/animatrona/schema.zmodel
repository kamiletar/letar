import "./schema/models/common"
import "./schema/models/anime"
import "./schema/models/media"
import "./schema/models/import"
import "./schema/models/watch"
import "./schema/models/settings"
import "./schema/models/federation"
import "./schema/models/social"
import "./schema/models/shikimori"

// ZenStack schema for Animatrona
// Electron приложение для транскодирования и просмотра аниме

datasource db {
  provider = "sqlite"
}

generator client {
  provider      = "prisma-client-js"
  output        = "./prisma"
  binaryTargets = ["native", "windows"]
}

plugin prisma {
  provider = "@core/prisma"
  output   = "./renderer/src/generated/schema.prisma"
}

// Access control plugin (v3)
plugin policy {
  provider = "@zenstackhq/plugin-policy"
}

// Плагин для генерации Zod схем с UI метаданными
plugin formSchema {
  provider = "../../libs/zenstack-form-plugin/dist/index.js"
  output   = "./renderer/src/generated/form-schemas"
}

// === Enum'ы ===


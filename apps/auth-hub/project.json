{
  "name": "auth-hub",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": [
    "@letar/chakra-provider",
    "@letar/analytics",
    "@letar/ui",
    "@letar/consent",
    "@letar/glitchtip",
    "@letar/chakra-provider",
    "@letar/analytics"
  ],
  "sourceRoot": "apps/auth-hub/src",
  "projectType": "application",
  "tags": [
    "type:app",
    "scope:auth-hub",
    "owner:letar"
  ],
  "targets": {
    "build": {
      "options": {
        "command": "next build --webpack"
      }
    },
    "dev": {
      "options": {
        "command": "next dev --webpack"
      }
    },
    "db:generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/generated/schema.prisma",
        "{projectRoot}/schema.zmodel",
        "{projectRoot}/prisma.config.ts"
      ],
      "outputs": [
        "{projectRoot}/src/generated/prisma"
      ],
      "metadata": {
        "description": "Generate Prisma Client from schema",
        "technologies": [
          "prisma"
        ]
      },
      "options": {
        "command": "prisma generate",
        "cwd": "apps/auth-hub"
      }
    },
    "db:push": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "db:generate"
      ],
      "metadata": {
        "description": "Push Prisma schema changes to database (development)",
        "technologies": [
          "prisma"
        ]
      },
      "options": {
        "command": "prisma db push",
        "cwd": "apps/auth-hub"
      }
    },
    "db:migrate": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "db:generate"
      ],
      "metadata": {
        "description": "Create and apply database migration",
        "technologies": [
          "prisma"
        ]
      },
      "options": {
        "command": "cross-env CI= VERCEL= GITHUB_ACTIONS= GITLAB= NETLIFY= HEROKU= prisma migrate dev",
        "cwd": "apps/auth-hub"
      }
    },
    "db:studio": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Open Prisma Studio database GUI",
        "technologies": [
          "prisma"
        ]
      },
      "options": {
        "command": "prisma studio",
        "cwd": "apps/auth-hub"
      }
    },
    "zenstack:generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/schema.zmodel"
      ],
      "outputs": [
        "{projectRoot}/src/generated"
      ],
      "metadata": {
        "description": "Generate Prisma schema from ZenStack",
        "technologies": [
          "zenstack",
          "prisma"
        ]
      },
      "options": {
        "commands": [
          "zenstack generate",
          "prisma generate",
          "node -e \"require('fs').writeFileSync('src/generated/prisma/index.ts', 'export * from \\'./browser\\'\\n')\"",
          "node -e \"require('fs').writeFileSync('src/generated/prisma/index.d.ts', 'export * from \\'./browser\\'\\n')\""
        ],
        "cwd": "apps/auth-hub",
        "parallel": false
      }
    },
    "test": {
      "dependsOn": [
        "zenstack:generate"
      ],
      "metadata": {
        "description": "Run unit tests with Vitest"
      },
      "options": {
        "config": "vitest.config.ts"
      }
    },
    "typecheck": {
      "dependsOn": [
        "zenstack:generate"
      ],
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/tsconfig.next-app.json",
        "{projectRoot}/tsconfig.json"
      ],
      "metadata": {
        "description": "Type-check TypeScript files",
        "technologies": [
          "typescript"
        ]
      },
      "options": {
        "command": "tsc --noEmit",
        "cwd": "apps/auth-hub"
      }
    },
    "typecheck:tsgo": {
      "dependsOn": [
        "zenstack:generate"
      ],
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/tsconfig.next-app.json",
        "{projectRoot}/tsconfig.json"
      ],
      "metadata": {
        "description": "Type-check TypeScript files with tsgo (38x faster)",
        "technologies": [
          "typescript",
          "tsgo"
        ]
      },
      "options": {
        "command": "tsgo --noEmit",
        "cwd": "apps/auth-hub"
      }
    },
    "oxlint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/.oxlintrc.json"
      ],
      "metadata": {
        "description": "Fast lint with oxlint (50-100x faster than ESLint)",
        "technologies": [
          "oxlint"
        ]
      },
      "options": {
        "command": "bunx oxlint src --config ../../.oxlintrc.json",
        "cwd": "apps/auth-hub"
      }
    },
    "lint": {
      "dependsOn": [
        "oxlint"
      ]
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Run ESLint with auto-fix",
        "technologies": [
          "eslint"
        ]
      },
      "options": {
        "command": "eslint . --fix",
        "cwd": "apps/auth-hub"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Format files with dprint (~30x faster than Prettier)",
        "technologies": [
          "dprint"
        ]
      },
      "options": {
        "command": "bunx dprint fmt \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "cwd": "apps/auth-hub"
      }
    },
    "db:seed": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Seed OIDC clients into oauthApplication table",
        "technologies": [
          "prisma"
        ]
      },
      "options": {
        "command": "bun run prisma/seed.ts",
        "cwd": "apps/auth-hub"
      }
    },
    "script:encrypt-secrets": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Encrypt OauthApplication.clientSecret at-rest (Этап 8). DRY RUN по умолчанию, добавь -- --execute для реального запуска.",
        "technologies": [
          "crypto"
        ]
      },
      "options": {
        "command": "bun run scripts/encrypt-client-secrets.ts",
        "cwd": "apps/auth-hub"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/dprint.json"
      ],
      "metadata": {
        "description": "Check file formatting with dprint",
        "technologies": [
          "dprint"
        ]
      },
      "options": {
        "command": "bunx dprint check \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "cwd": "apps/auth-hub"
      }
    }
  }
}

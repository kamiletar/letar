# Auth Service — Ключница
# Локальная разработка

PORT=3014

DATABASE_URL="postgresql://lena_user:lena_password@localhost:5440/lena_auth"

BETTER_AUTH_SECRET="dev-secret-change-in-production"
BETTER_AUTH_URL="http://localhost:3014"

NEXT_PUBLIC_APP_URL="http://localhost:3014"

# OAuth провайдеры (опциональные — заполни для тестирования)

// Ключница — централизованный сервис авторизации
// Better Auth + OIDC Provider + ProjectProfile

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./prisma"
}

plugin prisma {
  provider = '@core/prisma'
  output = './src/generated/schema.prisma'
}

plugin typescript {
  provider = '@core/typescript'
  output = './src/generated'
}

plugin policy {
  provider = '@zenstackhq/plugin-policy'
}

// ========================================
// Better Auth — базовые модели
// ========================================

enum UserRole {
  /// Пользователь
  USER
  /// Администратор
  ADMIN
}

// Центральный пользователь (единый для всех проектов)
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  image           String?
  emailVerified   Boolean   @default(false)
  roles           UserRole[] @default([USER])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Better Auth связи
  accounts        Account[]
  sessions        Session[]
  passkeys        Passkey[]

  // OIDC Provider связи
  oauthApplications  OauthApplication[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]
  oauthRefreshTokens OauthRefreshToken[]

  // Профили в проектах
  projectProfiles ProjectProfile[]

  // Telegram one-time tokens
  telegramTokens TelegramToken[]

  // Журнал cookie-согласий
  consentLogs ConsentLog[]

  // Дополнительные email (Этап 8.5)
  additionalEmails UserEmail[]

  // Публичный доступ на чтение, создание/обновление — только себя
  @@allow('read', true)
  @@allow('create', true)
  @@allow('update', auth() == this)

  @@index([email])
}

// Аккаунты OAuth/credentials (Better Auth core)
model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String

  // OAuth токены
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?

  // Пароль для email/password
  password              String?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@deny('all', true)
  @@index([userId])
}

// Сессии (Better Auth core)
model Session {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  expiresAt   DateTime
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Обратные связи от @better-auth/oauth-provider (jwt/oauthProvider плагины ссылаются
  // на session.id из oauthAccessToken/oauthRefreshToken, onDelete: set null на их стороне —
  // Prisma требует объявленную обратную связь на этой модели, даже read/write в неё сюда не идёт)
  oauthAccessTokens  OauthAccessToken[]
  oauthRefreshTokens OauthRefreshToken[]

  @@deny('all', true)
  @@index([userId])
  @@index([token])
}

// Верификация (Better Auth core)
model Verification {
  id          String   @id @default(cuid())
  identifier  String
  value       String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@deny('all', true)
  @@index([identifier])
}

// Дополнительные email на аккаунте (Этап 8.5 корневого PLAN.md) — self-service привязка/
// подтверждение нескольких адресов к одному User (как GitHub). Каждый управляется через
// server actions с requireAuth() + raw prisma (тот же паттерн, что Account/Session выше),
// поэтому политики deny-all — access control на уровне action, не ZenStack.
// НЕ покрывает: вход по любому linked-email (требует перехвата sign-in резолва, отдельная
// задача) и merge двух УЖЕ СУЩЕСТВУЮЩИХ разных аккаунтов (остаётся ручным скриптом владельца,
// необратимо, см. §8.5 «разовая операция»).
model UserEmail {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email                 String    @unique
  verified              Boolean   @default(false)
  verificationToken     String?   @unique
  verificationExpiresAt DateTime?
  createdAt             DateTime  @default(now())

  @@deny('all', true)
  @@index([userId])
}

// Rate Limiting
model RateLimit {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int
  lastRequest BigInt

  @@deny('all', true)
  @@index([key])
  @@map("rateLimit")
}

// ========================================
// OIDC Provider — OAuth-сервер
// ========================================

// Зарегистрированные OAuth-клиенты (приложения)
model OauthApplication {
  id                    String   @id @default(cuid())
  clientId              String   @unique
  clientSecret          String?
  name                  String
  icon                  String?
  metadata              String?
  redirectUrls          String   // CSV-строка redirect URI (через запятую) — устаревшее поле старого oidcProvider,
                                   // держим для admin UI/seed.ts; источник истины теперь redirectUris ниже
  redirectUris          String[] @default([]) // Требуется @better-auth/oauth-provider (1.7+) — schema.oauthClient.fields.redirectUris,
                                                // required:true, string[]. Синхронизируется с redirectUrls на каждой записи.
  tokenEndpointAuthMethod String @default("client_secret_post") // Без значения плагин дефолтит в client_secret_basic
                                                                  // (opts default), а наш @letar/auth client шлёт client_secret_post —
                                                                  // "client registered for client_secret_basic cannot use
                                                                  // client_secret_post" на КАЖДОМ обмене code→token (найдено 2026-08-26).
  type                  String   @default("web")
  disabled              Boolean  @default(false)
  skipConsent           Boolean  @default(false)
  userId                String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user          User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokens  OauthAccessToken[]
  refreshTokens OauthRefreshToken[]
  consents      OauthConsent[]

  // Только админы через UI, Better Auth управляет напрямую
  @@deny('all', true)
  @@index([clientId])

  @@map("oauthApplication")
}

// Выданные access-токены. Поля продиктованы @better-auth/oauth-provider (1.7+,
// node_modules/@better-auth/oauth-provider/dist/authorize-*.mjs, src/schema.ts::oauthAccessToken) —
// плагин обращается к ним напрямую по имени, не через маппинг schema{} (в отличие от oauthClient/
// oauthApplication). Старая схема (accessToken/refreshToken/scopes:String? одной записью) — из
// прежнего oidcProvider() ядра, миграция a8efcc72 её не тронула → NOT NULL/unknown-field 500 на
// КАЖДОМ обмене code→token (найдено 2026-08-26, седьмой слой прод-инцидента). Refresh-токены теперь
// отдельная модель OauthRefreshToken (offline_access scope, дефолтный в oauthProviderPlugin).
model OauthAccessToken {
  id                      String    @id @default(cuid())
  token                   String    @unique
  clientId                String
  sessionId               String?
  userId                  String?
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]  @default([])
  requestedUserInfoClaims String[]  @default([])
  refreshId               String?
  expiresAt               DateTime
  createdAt               DateTime  @default(now())
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]  @default([])

  client       OauthApplication   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  session      Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  refreshToken OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: SetNull)

  @@deny('all', true)
  @@index([clientId])
  @@index([userId])
  @@index([sessionId])
  @@index([authorizationCodeId])

  @@map("oauthAccessToken")
}

// Refresh-токены (offline_access) — отдельная модель плагина (src/schema.ts::oauthRefreshToken),
// без маппинга в schema{}, без аналога в старой схеме вовсе (седьмой слой того же инцидента —
// без этой модели каждый обмен code→token с offline_access падал ДО того, как код доходил до
// выдачи access-токена).
model OauthRefreshToken {
  id                      String    @id @default(cuid())
  token                   String    @unique
  clientId                String
  sessionId               String?
  userId                  String
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]  @default([])
  requestedUserInfoClaims String[]  @default([])
  expiresAt               DateTime
  createdAt               DateTime  @default(now())
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]  @default([])

  client       OauthApplication   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  session      Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  accessTokens OauthAccessToken[]

  @@deny('all', true)
  @@index([clientId])
  @@index([userId])
  @@index([sessionId])
  @@index([authorizationCodeId])

  @@map("oauthRefreshToken")
}

// Согласия пользователей. Поля — тот же источник и та же причина правки, что у OauthAccessToken
// выше (src/schema.ts::oauthConsent): плагин пишет scopes КАК string[] (не CSV-строку) и никогда
// не заполняет consentGiven — старое обязательное поле без дефолта гарантированно давало
// NOT NULL на первом же ctx.context.adapter.create() внутри consentEndpoint.
model OauthConsent {
  id                      String   @id @default(cuid())
  clientId                String
  userId                  String?
  referenceId             String?
  resources               String[] @default([])
  requestedUserInfoClaims String[] @default([])
  scopes                  String[] @default([])
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  client OauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@deny('all', true)
  @@index([clientId])
  @@index([userId])

  @@map("oauthConsent")
}

// ========================================
// JWT / JWKS — плагин jwt() (обязателен для oauthProvider, JWKS/подпись id_token)
// ========================================

// Ключевая пара для подписи JWT (id_token) — Better Auth jwt-плагин хранит и ротирует сама,
// схема полей продиктована самим плагином (better-auth/dist/plugins/jwt/schema.mjs), не менять
// произвольно. Без этой модели ЛЮБОЙ вызов get-session/oauth2 падает "Model jwks does not exist"
// (найдено 2026-08-26, четвёртый слой прод-инцидента после миграции a8efcc72 на
// @better-auth/oauth-provider — миграция плагина не сопровождалась полной миграцией схемы БД).
model Jwks {
  id         String    @id @default(cuid())
  publicKey  String
  privateKey String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@deny('all', true)
  @@map("jwks")
}

// ========================================
// Passkeys / WebAuthn
// ========================================

// Зарегистрированные passkeys пользователей
model Passkey {
  id             String    @id @default(cuid())
  name           String?   // Имя устройства (опционально)
  publicKey      Bytes
  userId         String
  webAuthnUserId String    // WebAuthn user handle (base64url)
  counter        BigInt
  deviceType     String    // "singleDevice" | "multiDevice"
  backedUp       Boolean
  transports     String?   // JSON: ["internal","hybrid",...]
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@deny('all', true)
  @@index([userId])
  @@map("passkey")
}

// ========================================
// Telegram авторизация — one-time deep-link токены
// ========================================

// Одноразовый токен для входа через Telegram-бота (Этап 6.6 PLAN.md).
// Флоу: сайт генерит token → t.me/<bot>?start=<token> → бот получает /start,
// связывает Telegram-identity с userId → фронт поллит /status → сессия.
model TelegramToken {
  id         String    @id @default(cuid())
  token      String    @unique      // hex(32) one-time токен
  telegramId String?                // Telegram user ID (числовой ID в виде строки)
  name       String?                // Имя из Telegram
  username   String?                // @username из Telegram
  photoUrl   String?                // URL аватарки
  userId     String?                // Ссылка на пользователя (после подтверждения)
  expiresAt  DateTime               // 10 минут с момента генерации
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@deny('all', true)
  @@index([token])
  @@index([telegramId])
  @@map("telegramToken")
}

// ========================================
// 152-ФЗ — Журнал cookie-согласий
// ========================================

/// Запись о cookie-согласии пользователя.
/// Хранится для соответствия 152-ФЗ — необходимо предъявить при проверке РКН.
model ConsentLog {
  id                 String   @id @default(cuid())
  userId             String?
  ipHash             String   // SHA-256(IP) — не хранится сырой IP
  userAgent          String?
  acceptedAnalytics  Boolean
  acceptedMarketing  Boolean
  acceptedFunctional Boolean  @default(true)
  consentVersion     String
  consentedAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@allow('create', true)
  @@allow('read', auth() != null && 'ADMIN' in auth().roles)
  @@index([userId])
  @@index([consentedAt])
  @@map("consentLog")
}

// ========================================
// ProjectProfile — per-project данные
// ========================================

// Профиль пользователя в конкретном проекте
model ProjectProfile {
  id          String   @id @default(cuid())
  userId      String
  projectSlug String   // "kami", "animatrona", "tracker", "dashboard"
  roles       String[] @default([])
  metadata    Json?    // Произвольные данные проекта
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectSlug])
  @@allow('read', auth() == user)
  @@allow('create,update,delete', auth() != null && 'ADMIN' in auth().roles)
  @@index([userId])
  @@index([projectSlug])
}

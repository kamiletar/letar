{
  "name": "aprel8008-e2e",
  "projectType": "application",
  "sourceRoot": "apps/aprel8008-e2e/src",
  "tags": ["type:e2e", "scope:aprel8008", "owner:letar"],
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {

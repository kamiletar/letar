# Dashboard Agent Dockerfile
# Lightweight мониторинг агент для удалённых серверов

FROM node:24-alpine AS base

# Alpine-пакеты ставим с зеркала, а не с dl-cdn.alpinelinux.org: с s3 (188.127.235.141) до
# Fastly-адресов dl-cdn нет пути вообще — ни по IPv4 (все 4 адреса), ни по IPv6, ни с хоста,
# ни из контейнера. При этом GitHub, npm, Docker registry и сами зеркала Alpine с того же
# хоста доступны, так что дело не в сети сервера и не в BuildKit — недоступен ровно этот CDN.
# Симптом без зеркала: `WARNING: fetching APKINDEX.tar.gz: TLS: unspecified error` и
# `no such package`, три сборки подряд, стабильно. Разбор — .claude/docs/alpine-cdn-unreachable-s3.md
ARG ALPINE_MIRROR=https://mirror.yandex.ru/mirrors/alpine
RUN sed -i "s|https://dl-cdn.alpinelinux.org/alpine|${ALPINE_MIRROR}|g" /etc/apk/repositories

# Стейдж production ниже собран `FROM base`, поэтому правку repositories наследует — второй раз
# её делать не нужно.

# Установка зависимостей для systeminformation
RUN apk add --no-cache \
    util-linux \
    procps

WORKDIR /app

# =============================================================================
# Builder stage
# =============================================================================
FROM base AS builder

# Устанавливаем bun
RUN npm install -g bun

# Мини-workspace для резолва внутренних @letar/*-зависимостей. @letar/email, @letar/glitchtip и
# @letar/redis-client — private:true, никогда не публикуются в npm — bun install в изоляции
# (только package.json dashboard-agent) искал бы их на публичном registry и падал 404.
COPY libs/email ./libs/email
COPY libs/glitchtip ./libs/glitchtip
COPY libs/redis-client ./libs/redis-client
COPY apps/dashboard-agent/package.json ./apps/dashboard-agent/package.json
RUN printf '{"name":"dashboard-agent-docker-build","private":true,"workspaces":["apps/dashboard-agent","libs/email","libs/glitchtip","libs/redis-client"]}' > package.json

# Устанавливаем зависимости
RUN bun install

# Копируем исходный код
COPY apps/dashboard-agent/src ./apps/dashboard-agent/src
COPY apps/dashboard-agent/tsconfig.json ./apps/dashboard-agent/tsconfig.json

# Сборка. cpu-features — опциональная нативная зависимость ssh2 (транзитивно через
# dockerode → docker-modem), обёрнута в try/catch в самом ssh2 (см. lib/protocol/constants.js) —
# dashboard-agent никогда не использует SSH-транспорт Docker, но Alpine-билдер без python3/make/g++
# не может собрать нативный аддон, и bun build пытается статически его заинлайнить. --external
# отключает статическое подключение, оставляя safe try/require на рантайм.
#
# outdir нарочно вложенный (apps/dashboard-agent/dist, не плоский ./dist) — pino динамически
# грузит pino-pretty как отдельный worker-модуль по имени (не заинлайнен бандлом), а
# bun-воркспейс кладёт символическую ссылку на него в apps/dashboard-agent/node_modules с
# ОТНОСИТЕЛЬНЫМ путём (../../../node_modules/.bun/...), рассчитанным под эту глубину
# вложенности. dist должен остаться на той же глубине, что и node_modules, иначе ссылка
# в проде указывает мимо (см. следующий стейдж).
RUN bun build ./apps/dashboard-agent/src/index.ts --outdir=./apps/dashboard-agent/dist --target=node --external cpu-features

# =============================================================================
# Production stage
# =============================================================================
FROM base AS production

# Устанавливаем git, ssh, docker-cli и tzdata (Alpine/musl не содержит zoneinfo по умолчанию —
# без tzdata TZ ниже молча не сработает)
RUN apk add --no-cache git openssh-client docker-cli tzdata
ENV TZ=Europe/Moscow

# Создаём пользователя для безопасности
RUN addgroup -g 1001 -S agent && \
    adduser -u 1001 -S agent -G agent

WORKDIR /app

# Копируем собранные файлы + node_modules, сохраняя ИСХОДНУЮ вложенность builder-стейджа
# (apps/dashboard-agent/{dist,node_modules} рядом с корневым node_modules) — так относительные
# symlink'и bun-воркспейса (apps/dashboard-agent/node_modules/pino-pretty → ../../../node_modules/…)
# остаются валидными. Плоское копирование в один уровень их ломает (см. комментарий у bun build).
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/dashboard-agent/node_modules ./apps/dashboard-agent/node_modules
COPY --from=builder /app/apps/dashboard-agent/dist ./apps/dashboard-agent/dist

# Переключаемся на пользователя agent
USER agent

# Порт
EXPOSE 3100

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3100/health || exit 1

# Запуск
CMD ["node", "apps/dashboard-agent/dist/index.js"]

# Dashboard Agent Configuration
# Скопируй в .env и заполни значения

# Порт сервера (default: 3100)
PORT=3100

# Хост (default: 0.0.0.0)
HOST=0.0.0.0

# Токен авторизации (ОБЯЗАТЕЛЬНО для production)
# Сгенерируй: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_TOKEN=

# Путь к Docker socket (default: /var/run/docker.sock)
DOCKER_SOCKET_PATH=/var/run/docker.sock

# CORS origin (default: * в development)
# CORS_ORIGIN=https://dashboard.example.com

# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# NODE_ENV: development, production
NODE_ENV=development

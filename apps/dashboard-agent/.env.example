# Dashboard Agent Configuration
# Скопируй в .env и заполни значения

# Порт сервера (default: 3100)
PORT=3100

# Хост (default: 0.0.0.0)
HOST=0.0.0.0

# Токен авторизации (ОБЯЗАТЕЛЬНО для production)
# Сгенерируй: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_TOKEN=

# Путь к Docker socket (default: /var/run/docker.sock)
DOCKER_SOCKET_PATH=/var/run/docker.sock

# CORS origin (default: * в development)
# CORS_ORIGIN=https://dashboard.example.com

# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# NODE_ENV: development, production
NODE_ENV=development

# Этап 0.7 — канареечный мониторинг доставки email (см. src/lib/email-canary.ts)
# Пусто = соответствующая нога проверки отключена, ошибкой не считается.
EMAIL_CANARY_SMTP_HOST=mail.letar.best
EMAIL_CANARY_SMTP_PORT=587
EMAIL_CANARY_SMTP_SECURE=false
EMAIL_CANARY_SMTP_USER=
EMAIL_CANARY_SMTP_PASSWORD=
EMAIL_CANARY_INTERNAL_IMAP_HOST=mail.letar.best
EMAIL_CANARY_INTERNAL_IMAP_PORT=993
EMAIL_CANARY_INTERNAL_IMAP_SECURE=true
EMAIL_CANARY_EXTERNAL_RECIPIENT=
EMAIL_CANARY_EXTERNAL_IMAP_HOST=
EMAIL_CANARY_EXTERNAL_IMAP_PORT=993
EMAIL_CANARY_EXTERNAL_IMAP_SECURE=true
EMAIL_CANARY_EXTERNAL_IMAP_USER=
EMAIL_CANARY_EXTERNAL_IMAP_PASSWORD=

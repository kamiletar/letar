{
  "name": "animatrona-landing-e2e",
  "projectType": "application",
  "sourceRoot": "apps/animatrona-landing-e2e/src",
  "tags": ["type:e2e", "scope:animatrona-landing", "owner:letar"],
  "implicitDependencies": ["animatrona-landing"],
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dprint fmt",
        "cwd": "apps/animatrona-landing-e2e"
      },
      "cache": false,
      "metadata": {
        "description": "Format files with dprint",
        "technologies": ["dprint"]
      }
    },
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "outputs": ["{workspaceRoot}/playwright-report/{projectName}"],
      "options": {
        "config": "apps/animatrona-landing-e2e/playwright.config.ts"
      }
    }
  }
}

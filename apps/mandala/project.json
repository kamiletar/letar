{
  "name": "mandala",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": [
    "@letar/chakra-provider",
    "@letar/forms",
    "@letar/hooks",
    "@letar/analytics",
    "@letar/consent",
    "@letar/format-utils",
    "@letar/image-upload",
    "@letar/ui",
    "@letar/glitchtip"
  ],
  "sourceRoot": "apps/mandala/src",
  "projectType": "application",
  "tags": [
    "type:app",
    "scope:mandala",
    "owner:letar"
  ],
  "targets": {
    "update-sw-version": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/package.json",
        "{projectRoot}/public/sw.template.js"
      ],
      "outputs": [
        "{projectRoot}/public/sw.js"
      ],
      "metadata": {
        "description": "Generate sw.js with version from package.json"
      },
      "options": {
        "command": "node scripts/update-sw-version.mjs",
        "cwd": "apps/mandala"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "update-sw-version",
        "^build"
      ],
      "cache": false,
      "outputs": [
        "{workspaceRoot}/apps/mandala/.next"
      ],
      "metadata": {
        "description": "Build production bundle (без Turbopack из-за бага с гидратацией Emotion)",
        "technologies": [
          "next"
        ]
      },
      "options": {
        "command": "next build --webpack",
        "cwd": "apps/mandala"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Start development server (без Turbopack из-за бага с гидратацией Emotion)",
        "technologies": [
          "next"
        ]
      },
      "options": {
        "command": "next dev --webpack",
        "cwd": "apps/mandala"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "metadata": {
        "description": "Start production server",
        "technologies": [
          "next"
        ]
      },
      "options": {
        "command": "next start",
        "cwd": "apps/mandala"
      }
    },
    "db:generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/generated/schema.prisma",
        "{projectRoot}/schema.zmodel"
      ],
      "outputs": [
        "{projectRoot}/src/generated/prisma"
      ],
      "metadata": {
        "description": "Generate Prisma Client from schema",
        "technologies": [
          "prisma"
        ]
      },
      "options": {
        "command": "prisma generate",
        "cwd": "apps/mandala"
      }
    },
    "db:push": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "db:generate"
      ],
      "metadata": {
        "description": "Push Prisma schema changes to database (development)",
        "technologies": [
          "prisma"
        ]
      },
      "options": {
        "command": "prisma db push",
        "cwd": "apps/mandala"
      }
    },
    "db:migrate": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "db:generate"
      ],
      "metadata": {
        "description": "Create and apply database migration",
        "technologies": [
          "prisma"
        ]
      },
      "options": {
        "command": "cross-env CI= VERCEL= GITHUB_ACTIONS= GITLAB= NETLIFY= HEROKU= prisma migrate dev",
        "cwd": "apps/mandala"
      }
    },
    "db:migrate:deploy": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Apply pending migrations (production)",
        "technologies": [
          "prisma"
        ]
      },
      "options": {
        "command": "prisma migrate deploy",
        "cwd": "apps/mandala"
      }
    },
    "db:studio": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Open Prisma Studio database GUI",
        "technologies": [
          "prisma"
        ]
      },
      "options": {
        "command": "prisma studio",
        "cwd": "apps/mandala"
      }
    },
    "db:seed": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "db:generate"
      ],
      "metadata": {
        "description": "Seed database with test data",
        "technologies": [
          "prisma"
        ]
      },
      "options": {
        "command": "prisma db seed",
        "cwd": "apps/mandala"
      }
    },
    "db:reset": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Reset database and apply all migrations",
        "technologies": [
          "prisma"
        ]
      },
      "options": {
        "command": "prisma migrate reset",
        "cwd": "apps/mandala"
      }
    },
    "db:reset:data-loss": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Reset database and apply all migrations (no confirmation)",
        "technologies": [
          "prisma"
        ]
      },
      "options": {
        "command": "prisma migrate reset --force",
        "cwd": "apps/mandala"
      }
    },
    "zenstack:generate": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": [
            "@letar/zenstack-form-plugin"
          ],
          "target": "build"
        }
      ],
      "cache": true,
      "inputs": [
        "{projectRoot}/schema.zmodel"
      ],
      "outputs": [
        "{projectRoot}/src/generated"
      ],
      "metadata": {
        "description": "Generate Prisma schema from ZenStack",
        "technologies": [
          "zenstack",
          "prisma"
        ]
      },
      "options": {
        "commands": [
          "zenstack generate",
          "prisma generate",
          "node -e \"require('fs').writeFileSync('src/generated/prisma/index.ts', 'export * from \\'./browser\\'\\n')\""
        ],
        "cwd": "apps/mandala",
        "parallel": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "oxlint"
      ],
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintrc.json"
      ],
      "metadata": {
        "description": "Run ESLint",
        "technologies": [
          "eslint"
        ]
      },
      "options": {
        "command": "eslint .",
        "cwd": "apps/mandala"
      }
    },
    "oxlint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/.oxlintrc.json"
      ],
      "metadata": {
        "description": "Fast lint with oxlint (50-100x faster than ESLint)",
        "technologies": [
          "oxlint"
        ]
      },
      "options": {
        "command": "bunx oxlint src --config ../../.oxlintrc.json",
        "cwd": "apps/mandala"
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Run ESLint with auto-fix",
        "technologies": [
          "eslint"
        ]
      },
      "options": {
        "command": "eslint . --fix",
        "cwd": "apps/mandala"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Format files with dprint (~30x faster than Prettier)",
        "technologies": [
          "dprint"
        ]
      },
      "options": {
        "command": "bunx dprint fmt \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "cwd": "apps/mandala"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/dprint.json"
      ],
      "metadata": {
        "description": "Check file formatting with dprint",
        "technologies": [
          "dprint"
        ]
      },
      "options": {
        "command": "bunx dprint check \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "cwd": "apps/mandala"
      }
    },
    "typecheck": {
      "dependsOn": [
        "zenstack:generate"
      ],
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/tsconfig.next-app.json",
        "{projectRoot}/tsconfig.json"
      ],
      "metadata": {
        "description": "Type-check TypeScript files",
        "technologies": [
          "typescript"
        ]
      },
      "options": {
        "command": "tsc --noEmit",
        "cwd": "apps/mandala"
      }
    },
    "typecheck:tsgo": {
      "dependsOn": [
        "zenstack:generate"
      ],
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/tsconfig.next-app.json",
        "{projectRoot}/tsconfig.json"
      ],
      "metadata": {
        "description": "Type-check TypeScript files with tsgo (38x faster)",
        "technologies": [
          "typescript",
          "tsgo"
        ]
      },
      "options": {
        "command": "tsgo --noEmit",
        "cwd": "apps/mandala"
      }
    },
    "validate": {
      "executor": "nx:noop",
      "dependsOn": [
        "lint",
        "format:check",
        "typecheck"
      ],
      "metadata": {
        "description": "Run all validation checks"
      }
    },
    "test": {
      "dependsOn": [
        "zenstack:generate"
      ],
      "options": {
        "config": "vitest.config.ts"
      }
    }
  }
}

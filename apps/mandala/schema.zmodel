datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./prisma"
}

plugin prisma {
  provider = '@core/prisma'
  output = './src/generated/schema.prisma'
}

// TypeScript plugin (v3) - генерирует schema.ts для ZenStackClient
plugin typescript {
  provider = '@core/typescript'
  output = './src/generated'
}

// Access control plugin (v3)
plugin policy {
  provider = '@zenstackhq/plugin-policy'
}

plugin formSchema {
  provider = '../../libs/zenstack-form-plugin/dist/index.js'
  output = './src/generated/form-schemas'
}

// ============================================================================
// AUTH MODELS (Better Auth v1.x)
// ============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)  // Better Auth использует Boolean
  image         String?
  role          UserRole  @default(USER)

  accounts      Account[]
  sessions      Session[]
  uploadedImages Image[]
  orders        Order[]   // Заказы пользователя

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@allow('read', true)
  @@allow('all', auth() == this)
  @@allow('all', auth().role == ADMIN)
}

enum UserRole {
  /// Пользователь
  USER
  /// Администратор
  ADMIN
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  providerId            String    // 'credential', 'google', 'yandex' etc.
  accountId             String    // email для credential, OAuth ID для OAuth
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?   // Хеш пароля для credential auth
  /// Better Auth 1.7+ — провайдер, выдавший accountId (защита от provider impersonation)
  issuer                String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@allow('all', auth() == user)
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique    // Better Auth использует 'token'
  userId    String
  expiresAt DateTime            // Better Auth использует 'expiresAt'
  ipAddress String?
  userAgent String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@allow('all', auth() == user)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String   // email или другой идентификатор
  value      String   @unique // токен верификации (Better Auth требует уникальность)
  expiresAt  DateTime

  // PIN-аутентификация (@letar/pin-auth)
  pin         String?   // 6-значный PIN-код
  pinExpires  DateTime? // Срок действия PIN
  pinAttempts Int       @default(0) // Количество попыток ввода

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  // Access control: никто не может читать токены напрямую через API
  @@deny('all', true)
}

// ============================================================================
// CONSENT LOG (152-ФЗ)
// ============================================================================

model ConsentLog {
  id     String  @id @default(cuid())
  userId String?

  /// Хэш IP (sha256, без соли — для дедупликации, не для деанонимизации)
  ipHash    String
  userAgent String?

  acceptedAnalytics  Boolean @default(false)
  acceptedMarketing  Boolean @default(false)
  acceptedFunctional Boolean @default(true)

  /// Версия текста политики, на которую дано согласие
  consentVersion String

  consentedAt DateTime @default(now())

  @@allow('create', true)
  @@allow('read', auth().role == ADMIN)
  @@index([userId])
  @@index([consentedAt])
}

// ============================================================================
// MANDALA MODELS
// ============================================================================

model Mandala {
  id          String   @id @default(cuid())

  slug        String   @unique @meta("form.title", "URL-адрес") @meta("form.placeholder", "harmony-mandala")

  name        String @meta("form.title", "Название мандалы") @meta("form.placeholder", "Мандала гармонии")

  description String? @meta("form.title", "Описание") @meta("form.fieldType", "richText")

  // i18n поля (EN)
  nameEn            String? @meta("form.title", "Название (EN)") @meta("form.placeholder", "Harmony Mandala")

  descriptionEn     String? @meta("form.title", "Описание (EN)") @meta("form.fieldType", "richText")

  // Связи с изображениями
  imageId     String @meta("form.exclude", true)
  image       Image    @relation("MandalaImage", fields: [imageId], references: [id]) @meta("form.exclude", true)

  centerImageId String? @meta("form.exclude", true)
  centerImage   Image?   @relation("MandalaCenterImage", fields: [centerImageId], references: [id]) @meta("form.exclude", true)

  isSquare Boolean @default(false) @meta("form.title", "Квадратная мандала") @meta("form.description", "Если включено: вращается центр. Иначе: вращается фон.") @meta("form.fieldType", "switch")

  watermarkId String? @meta("form.exclude", true)
  watermark   Image?   @relation("MandalaWatermark", fields: [watermarkId], references: [id]) @meta("form.exclude", true)

  // SEO
  metaTitle       String? @meta("form.title", "SEO заголовок")

  metaDescription String? @meta("form.title", "SEO описание") @meta("form.fieldType", "textarea")

  metaKeywords    String? @meta("form.title", "SEO ключевые слова")

  // SEO i18n (EN)
  metaTitleEn       String? @meta("form.title", "SEO заголовок (EN)")

  metaDescriptionEn String? @meta("form.title", "SEO описание (EN)") @meta("form.fieldType", "textarea")

  ogImageId   String? @meta("form.exclude", true)
  ogImage     Image?   @relation("MandalaOgImage", fields: [ogImageId], references: [id]) @meta("form.exclude", true)

  defaultEffectIndex Int @default(0) @meta("form.title", "Эффект по умолчанию") @meta("form.props.min", 0) @meta("form.props.max", 6)

  order       Int      @default(0) @meta("form.title", "Порядок сортировки") @meta("form.props.min", 0)

  published   Boolean  @default(true) @meta("form.title", "Опубликовано") @meta("form.fieldType", "switch")

  createdAt   DateTime @default(now()) @meta("form.exclude", true)
  updatedAt   DateTime @updatedAt @meta("form.exclude", true)

  @@index([published, order])
  @@index([imageId])
  @@allow('read', published)
  @@allow('all', auth().role == ADMIN)
}

// ============================================================================
// PRODUCT MODELS
// ============================================================================

model Product {
  id          String   @id @default(cuid())

  slug        String   @unique @meta("form.title", "URL-адрес")

  name        String @meta("form.title", "Название товара")

  description String @meta("form.title", "Описание") @meta("form.fieldType", "richText")

  // i18n поля (EN)
  nameEn            String? @meta("form.title", "Название (EN)")

  descriptionEn     String? @meta("form.title", "Описание (EN)") @meta("form.fieldType", "richText")

  price       Float @meta("form.title", "Цена (₽)") @meta("form.props.min", 0) @meta("form.props.step", 1)

  currency    String   @default("RUB") @meta("form.exclude", true)

  images      ProductImage[] @meta("form.exclude", true)

  orderItems  OrderItem[] @meta("form.exclude", true)

  // SEO
  metaTitle       String? @meta("form.title", "SEO заголовок")

  metaDescription String? @meta("form.title", "SEO описание") @meta("form.fieldType", "textarea")

  // SEO i18n (EN)
  metaTitleEn       String? @meta("form.title", "SEO заголовок (EN)")

  metaDescriptionEn String? @meta("form.title", "SEO описание (EN)") @meta("form.fieldType", "textarea")

  ogImageId       String? @meta("form.exclude", true)
  ogImageRel      Image?  @relation("ProductOgImage", fields: [ogImageId], references: [id]) @meta("form.exclude", true)

  order       Int      @default(0) @meta("form.title", "Порядок сортировки") @meta("form.props.min", 0)

  published   Boolean  @default(true) @meta("form.title", "Опубликовано") @meta("form.fieldType", "switch")

  stock       Int      @default(1) @meta("form.title", "Количество в наличии") @meta("form.props.min", 0) @meta("form.props.step", 1)

  inStock     Boolean  @default(true) @meta("form.exclude", true)

  createdAt   DateTime @default(now()) @meta("form.exclude", true)
  updatedAt   DateTime @updatedAt @meta("form.exclude", true)

  @@index([published, order])
  @@allow('read', published)
  @@allow('all', auth().role == ADMIN)
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  imageId   String
  image     Image   @relation(fields: [imageId], references: [id])
  alt       String? // Alt текст
  order     Int     @default(0)

  @@index([productId, order])
  @@allow('read', product.published)
  @@allow('all', auth().role == ADMIN)
}

// ============================================================================
// CONTENT PAGES
// ============================================================================

model ContentPage {
  id      String @id @default(cuid())

  slug    String @unique @meta("form.title", "URL-адрес") @meta("form.placeholder", "about-us")

  title   String @meta("form.title", "Заголовок страницы")

  content String @meta("form.title", "Содержимое") @meta("form.fieldType", "richText")

  // i18n поля (EN)
  titleEn   String? @meta("form.title", "Заголовок (EN)")

  contentEn String? @meta("form.title", "Содержимое (EN)") @meta("form.fieldType", "richText")

  // SEO
  metaTitle       String? @meta("form.title", "SEO заголовок")

  metaDescription String? @meta("form.title", "SEO описание") @meta("form.fieldType", "textarea")

  // SEO i18n (EN)
  metaTitleEn       String? @meta("form.title", "SEO заголовок (EN)")

  metaDescriptionEn String? @meta("form.title", "SEO описание (EN)") @meta("form.fieldType", "textarea")

  ogImageId       String? @meta("form.exclude", true)
  ogImageRel      Image?  @relation("ContentPageOgImage", fields: [ogImageId], references: [id]) @meta("form.exclude", true)

  published Boolean @default(true) @meta("form.title", "Опубликовано") @meta("form.fieldType", "switch")

  createdAt DateTime @default(now()) @meta("form.exclude", true)
  updatedAt DateTime @updatedAt @meta("form.exclude", true)

  @@allow('read', published)
  @@allow('all', auth().role == ADMIN)
}

// ============================================================================
// SHORT URLS
// ============================================================================

model ShortUrl {
  id       String @id @default(cuid())

  code     String @unique @meta("form.title", "Короткий код") @meta("form.placeholder", "promo2024")

  fullUrl  String @meta("form.title", "Полный URL") @meta("form.placeholder", "/stickers/mandala-name")

  createdAt DateTime @default(now()) @meta("form.exclude", true)

  @@index([code])
  @@allow('read', true)
  @@allow('all', auth().role == ADMIN)
}

// ============================================================================
// IMAGE MODEL
// ============================================================================

enum ImageCategory {
  /// Мандала
  MANDALA
  /// Продукт
  PRODUCT
  /// Контент
  CONTENT
  /// Прочее
  OTHER
}

model Image {
  id           String        @id @default(cuid())
  filename     String                    // Оригинальное имя файла
  path         String        @unique     // Путь к файлу в uploads/
  mimeType     String                    // MIME тип (image/png, image/jpeg)
  size         Int                       // Размер в байтах
  width        Int?                      // Ширина в пикселях
  height       Int?                      // Высота в пикселях
  blurDataURL  String?                   // Base64 blur placeholder для Next.js Image
  category     ImageCategory @default(OTHER)

  uploadedById String?
  uploadedBy   User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt   DateTime      @default(now())

  // Обратные связи с Mandala
  mandalaAsMain       Mandala[] @relation("MandalaImage")
  mandalaAsCenter     Mandala[] @relation("MandalaCenterImage")
  mandalaAsWatermark  Mandala[] @relation("MandalaWatermark")
  mandalaAsOgImage    Mandala[] @relation("MandalaOgImage")

  // Обратная связь с ProductImage
  productImages       ProductImage[]

  // Обратные связи с OG Images
  productOgImages     Product[]     @relation("ProductOgImage")
  contentPageOgImages ContentPage[] @relation("ContentPageOgImage")

  @@index([category])
  @@index([path])
  @@allow('read', true)
  @@allow('create', auth() != null)
  @@allow('update,delete', auth().role == ADMIN)
}

// ============================================================================
// CONTACT MESSAGES
// ============================================================================

model ContactMessage {
  id        String   @id @default(cuid())

  name      String @meta("form.title", "Имя") @meta("form.placeholder", "Ваше имя") @meta("form.props.minLength", 2) @meta("form.props.maxLength", 100)

  email     String @meta("form.title", "Email") @meta("form.placeholder", "your@email.com") @meta("form.props.email", true)

  message   String @meta("form.title", "Сообщение") @meta("form.fieldType", "textarea") @meta("form.placeholder", "Напишите ваше сообщение...") @meta("form.props.minLength", 10) @meta("form.props.maxLength", 5000)

  read      Boolean  @default(false) @meta("form.exclude", true)

  createdAt DateTime @default(now()) @meta("form.exclude", true)

  @@index([read, createdAt])
  @@allow('create', true)
  @@allow('read,update,delete', auth().role == ADMIN)
}

// ============================================================================
// APP SETTINGS (Singleton)
// ============================================================================

model AppSettings {
  id                 String   @id @default("default")  // Фиксированный ID для singleton

  // === Telegram уведомления ===
  telegramEnabled    Boolean  @default(false) @meta("form.title", "Telegram уведомления") @meta("form.fieldType", "switch")

  telegramBotToken   String? @meta("form.title", "Bot Token") @meta("form.description", "Токен от @BotFather") @meta("form.props.type", "password")

  telegramChatId     String? @meta("form.title", "Chat ID") @meta("form.description", "ID чата для уведомлений")

  // === Метаданные ===
  updatedAt          DateTime @updatedAt @meta("form.exclude", true)

  // Только админы могут читать и редактировать настройки
  @@allow('read,update', auth().role == ADMIN)
  @@deny('create,delete', true)  // Singleton — создание/удаление запрещено
}

// ============================================================================
// ORDERS
// ============================================================================

enum OrderStatus {
  /// Ожидает
  PENDING
  /// Подтверждён
  CONFIRMED
  /// Отправлен
  SHIPPED
  /// Доставлен
  DELIVERED
  /// Отменён
  CANCELLED
}

model Order {
  id        String      @id @default(cuid())

  items     OrderItem[] @meta("form.exclude", true)

  userId    String? @meta("form.exclude", true)
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull) @meta("form.exclude", true)

  name      String @meta("form.title", "Имя") @meta("form.placeholder", "Ваше имя")

  phone     String @meta("form.title", "Телефон") @meta("form.placeholder", "+7 (999) 123-45-67")

  email     String? @meta("form.title", "Email") @meta("form.placeholder", "your@email.com") @meta("form.description", "Для уведомлений о статусе заказа") @meta("form.props.email", true)

  address   String? @meta("form.title", "Адрес доставки") @meta("form.placeholder", "Город, улица, дом, квартира") @meta("form.fieldType", "textarea")

  comment   String? @meta("form.title", "Комментарий") @meta("form.placeholder", "Пожелания к заказу") @meta("form.fieldType", "textarea")

  status    OrderStatus @default(PENDING) @meta("form.title", "Статус")

  total     Int @meta("form.title", "Сумма (₽)") @meta("form.props.min", 0)

  createdAt DateTime    @default(now()) @meta("form.exclude", true)
  updatedAt DateTime    @updatedAt @meta("form.exclude", true)

  @@index([status, createdAt])
  @@index([userId])
  @@allow('create', true)
  @@allow('read', auth() == user)
  @@allow('read,update,delete', auth().role == ADMIN)
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity  Int                       // Количество
  price     Float                     // Цена за единицу на момент заказа (₽)

  @@index([orderId])
  @@allow('create', true)
  @@allow('read,update,delete', auth().role == ADMIN)
}

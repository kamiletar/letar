# Domain Configuration (for Nginx Proxy Manager)
# Все домены через запятую: основной и алиасы
DOMAIN=mandala.letar.best

# Database
DB_PASSWORD=your_secure_db_password

# Приложение
NEXT_PUBLIC_BASE_URL=https://mandala.letar.best
NEXT_PUBLIC_APP_URL=https://mandala.letar.best

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=https://mandala.letar.best
AUTH_TRUST_HOST=true

# Google OAuth (опционально)
# Get from: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Yandex OAuth (опционально)
# Get from: https://oauth.yandex.ru/
AUTH_YANDEX_ID=
AUTH_YANDEX_SECRET=

# Email (Yandex SMTP) - для верификации по PIN-коду
# Для development с Mailhog: EMAIL_USE_MAILHOG=true, EMAIL_HOST=localhost, EMAIL_SMTP_PORT=1025
EMAIL_SERVER_USER=your-email@yandex.ru
EMAIL_SERVER_PASSWORD=your-app-password
EMAIL_FROM=noreply@mandala.letar.best

# Yandex Metrika
NEXT_PUBLIC_YANDEX_METRIKA_ID=106082261

# Telegram Bot (уведомления, опционально)
TELEGRAM_BOT_TOKEN=

# api.telegram.org заблокирован провайдером ДЦ на s1/s2 — обязателен на проде, см. .claude/docs/deployment.md
TELEGRAM_API_ROOT=https://tg-proxy.letar.best

# GlitchTip (трекинг ошибок) — DSN получить в GlitchTip UI → Settings → Client Keys, см. infra/glitchtip/README.md
GLITCHTIP_DSN=<glitchtip_dsn>
GLITCHTIP_ENVIRONMENT=<glitchtip_environment>
NEXT_PUBLIC_GLITCHTIP_DSN=<next_public_glitchtip_dsn>
NEXT_PUBLIC_GLITCHTIP_ENVIRONMENT=<next_public_glitchtip_environment>

# Staging-окружение на s3 (PLAN.md §18.7 Тираж M1). Скопировать в .env.staging на s3 и заполнить секреты.
#
# mandala — email/password + опциональный Google/Yandex OAuth (raw betterAuth, не фабрика
# createAuth). OAuth-блок в src/lib/auth.ts подключается только если заданы ОБА
# AUTH_GOOGLE_ID/AUTH_GOOGLE_SECRET (аналогично для Yandex) — на staging сознательно не
# заполняем, соц-вход просто отсутствует, email/password работает нормально.

# PORT — ВНУТРЕННИЙ порт Next.js внутри контейнера (должен совпадать с правой частью маппинга
# портов в docker-compose.staging.yml, сейчас 3004). НЕ хостовый порт — хостовый (3024)
# захардкожен в docker-compose.staging.yml.
PORT=3004
DOMAIN=mandala-stage.s3.letar.best

# Пароль PostgreSQL для staging БД
DB_PASSWORD=change-me

# Better Auth
BETTER_AUTH_SECRET=change-me

# Dev-session (e2e/preview-авторизация без OIDC, @letar/auth/server createDevSessionRoute)
# ⚠️ Обе переменные — ТОЛЬКО здесь, в .env.staging. НИКОГДА не переносить в .env.docker/.env.docker.enc —
# это бэкдор-эндпоинт, создающий сессию для любого email без пароля/OIDC.
ALLOW_DEV_SESSION=true
DEV_SESSION_TOKEN=change-me

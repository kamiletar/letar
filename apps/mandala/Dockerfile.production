# Dockerfile.production - для уже собранных приложений
# Используется когда сборка выполнена на сервере с nx build affected
# Build context: workspace root (C:\web\letar)

FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# Ограничение памяти Node.js (по умолчанию ~50% хоста = ~1GB на 2GB RAM)
ENV NODE_OPTIONS="--max-old-space-size=512"

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Копируем уже собранный standalone output
# Standalone включает в себя все необходимые node_modules
COPY --chown=nextjs:nodejs apps/mandala/.next/standalone ./

# Next.js output file tracing не подхватывает libvips-cpp.so, который sharp грузит через dlopen()
# (не через require()) — трейсер не видит динамическую загрузку. Без явного COPY контейнер
# падает с ERR_DLOPEN_FAILED на каждом SSR-запросе (инцидент 2026-07-12, mandala 500 на проде).
COPY --chown=nextjs:nodejs node_modules/.bun/@img+sharp-libvips-linuxmusl-x64@1.3.2/node_modules/@img/sharp-libvips-linuxmusl-x64/lib/libvips-cpp.so.8.18.3 ./node_modules/.bun/@img+sharp-libvips-linuxmusl-x64@1.3.2/node_modules/@img/sharp-libvips-linuxmusl-x64/lib/libvips-cpp.so.8.18.3

# Копируем статику и public (не включаются в standalone автоматически)
COPY --chown=nextjs:nodejs apps/mandala/.next/static ./apps/mandala/.next/static
COPY --chown=nextjs:nodejs apps/mandala/public ./apps/mandala/public

USER nextjs

EXPOSE 3004

ENV PORT=3004
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/mandala/server.js"]

# Dockerfile.production - для уже собранных приложений
# Используется когда сборка выполнена на сервере с nx build affected
# Build context: workspace root (C:\web\letar)

FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Alpine (musl) не содержит zoneinfo по умолчанию - без tzdata TZ ниже молча не сработает
RUN apk add --no-cache tzdata
ENV TZ=Europe/Moscow
# Ограничение памяти Node.js (по умолчанию ~50% хоста = ~1GB на 2GB RAM)
ENV NODE_OPTIONS="--max-old-space-size=512"

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Копируем уже собранный standalone output
# Standalone включает в себя все необходимые node_modules, включая libvips-cpp.so —
# next.config.js добавляет её через outputFileTracingIncludes (глоб без хардкода версии,
# см. инцидент 2026-07-12: sharp грузит .so через dlopen(), трейсер по умолчанию это не ловит)
COPY --chown=nextjs:nodejs apps/mandala/.next/standalone ./

# Копируем статику и public (не включаются в standalone автоматически)
COPY --chown=nextjs:nodejs apps/mandala/.next/static ./apps/mandala/.next/static
COPY --chown=nextjs:nodejs apps/mandala/public ./apps/mandala/public

USER nextjs

EXPOSE 3004

ENV PORT=3004
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/mandala/server.js"]

# Database
DB_PASSWORD=animatrona_secure_password_change_me

# DATABASE_URL формируется в docker-compose.production.yml автоматически
# Только если нужен внешний PostgreSQL:
# DATABASE_URL=postgresql://animatrona_user:password@external-host:5432/animatrona_tracker?schema=public

# Better Auth (ОБЯЗАТЕЛЬНО сгенерировать: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-production-secret-change-me
BETTER_AUTH_URL=https://animatrona-tracker.letar.best
AUTH_TRUST_HOST=true

# OAuth Providers (получить в консолях разработчиков)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_YANDEX_ID=
AUTH_YANDEX_SECRET=
AUTH_VK_ID=
AUTH_VK_SECRET=

# IPFS Gateway
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.letar.best

# Application
NEXT_PUBLIC_APP_URL=https://animatrona-tracker.letar.best

# GlitchTip (трекинг ошибок) — DSN получить в GlitchTip UI → Settings → Client Keys, см. infra/glitchtip/README.md
GLITCHTIP_DSN=<glitchtip_dsn>
GLITCHTIP_ENVIRONMENT=<glitchtip_environment>
NEXT_PUBLIC_GLITCHTIP_DSN=<next_public_glitchtip_dsn>
NEXT_PUBLIC_GLITCHTIP_ENVIRONMENT=<next_public_glitchtip_environment>

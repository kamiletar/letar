{
  "extends": "../../tsconfig.next-app.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@letar/consent": ["../../libs/consent/src/index.ts"],
      "@letar/auth": ["../../libs/auth/src/index.ts"],
      "@letar/auth/client": ["../../libs/auth/src/client/index.ts"],
      "@letar/auth/server": ["../../libs/auth/src/server/index.ts"],
      "@letar/validation-utils": ["../../libs/validation-utils/src/index.ts"],
      "@letar/query-provider": ["../../libs/query-provider/src/index.ts"],
      "@letar/analytics": ["../../libs/analytics/src/index.ts"],
      "@letar/forms": ["../../libs/forms/src/index.ts"],
      "@letar/forms-core": ["../../libs/forms-core/src/index.ts"],
      "@letar/forms-core/validators/ru": ["../../libs/forms-core/src/lib/validators/ru/index.ts"],
      "@letar/animatrona-types": ["../../libs/animatrona-types/src/index.ts"],
      "@letar/video-player-react": ["../../libs/video-player-react/src/index.ts"],
      "@letar/video-player-core": ["../../libs/video-player-core/src/index.ts"],
      "@letar/animatrona-utils": ["../../libs/animatrona-utils/src/index.ts"],
      "@letar/animatrona-franchise-graph": ["../../libs/animatrona-franchise-graph/src/index.ts"],
      "@letar/animatrona-ui": ["../../libs/animatrona-ui/src/index.ts"],
      "@letar/ui": ["../../libs/ui/src/index.ts"],
      "@letar/redis-client": ["../../libs/redis-client/src/index.ts"]
    }
  },
  "include": [
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../libs/analytics/src/**/*.ts",
    "../../libs/analytics/src/**/*.tsx",
    "../../libs/query-provider/src/**/*.ts",
    "../../libs/query-provider/src/**/*.tsx",
    "../../libs/animatrona-types/src/**/*.ts",
    "../../libs/animatrona-utils/src/**/*.ts",
    "../../libs/animatrona-franchise-graph/src/**/*.ts",
    "../../libs/animatrona-franchise-graph/src/**/*.tsx",
    "../../libs/animatrona-ui/src/**/*.ts",
    "../../libs/animatrona-ui/src/**/*.tsx",
    "../../libs/ui/src/**/*.ts",
    "../../libs/ui/src/**/*.tsx",
    "../../libs/video-player-react/src/**/*.ts",
    "../../libs/video-player-react/src/**/*.tsx",
    "../../libs/video-player-core/src/**/*.ts",
    "../../libs/auth/src/**/*.ts",
    "../../libs/auth/src/**/*.tsx"
  ],
  "exclude": [
    ".next",
    "dist",
    "eslint.config.mjs",
    "node_modules",
    "out-tsc",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/generated/**/*.js",
    "src/generated/**/*.mjs",
    "src/generated/**/runtime/**/*",
    "src/generated/src/**/*",
    "../../libs/**/*.spec.ts",
    "../../libs/**/*.spec.tsx",
    "../../libs/**/*.test.ts",
    "../../libs/**/*.test.tsx"
  ]
}

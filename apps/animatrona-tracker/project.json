{
  "name": "animatrona-tracker",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": [
    "@letar/chakra-provider",
    "@letar/analytics",
    "@letar/consent",
    "@letar/animatrona-ui",
    "@letar/redis-client",
    "@letar/glitchtip",
    "@letar/chakra-provider",
    "@letar/analytics",
    "@letar/consent",
    "@letar/animatrona-ui",
    "@letar/redis-client"
  ],
  "sourceRoot": "apps/animatrona-tracker/src",
  "projectType": "application",
  "tags": [
    "type:app",
    "scope:animatrona-tracker",
    "owner:letar"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "outputs": [
        "{workspaceRoot}/apps/animatrona-tracker/.next"
      ],
      "metadata": {
        "description": "Build production bundle (без Turbopack из-за бага с гидратацией Emotion, см. .claude/docs/nextjs16-turbopack-default-emotion-hydration.md)",
        "technologies": [
          "next"
        ]
      },
      "options": {
        "command": "next build --webpack",
        "cwd": "apps/animatrona-tracker"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Start development server (без Turbopack из-за бага с гидратацией Emotion, см. .claude/docs/nextjs16-turbopack-default-emotion-hydration.md)",
        "technologies": [
          "next"
        ]
      },
      "options": {
        "command": "next dev --webpack",
        "cwd": "apps/animatrona-tracker"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "metadata": {
        "description": "Start production server",
        "technologies": [
          "next"
        ]
      },
      "options": {
        "command": "next start",
        "cwd": "apps/animatrona-tracker"
      }
    },
    "db:generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/generated/schema.prisma",
        "{projectRoot}/schema.zmodel",
        "{projectRoot}/prisma.config.ts"
      ],
      "outputs": [
        "{projectRoot}/src/generated/prisma"
      ],
      "metadata": {
        "description": "Generate Prisma Client from schema",
        "technologies": [
          "prisma"
        ]
      },
      "options": {
        "command": "prisma generate",
        "cwd": "apps/animatrona-tracker"
      }
    },
    "db:push": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "db:generate"
      ],
      "metadata": {
        "description": "Push Prisma schema changes to database (development)",
        "technologies": [
          "prisma"
        ]
      },
      "options": {
        "command": "prisma db push",
        "cwd": "apps/animatrona-tracker"
      }
    },
    "db:push:data-loss": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "db:generate"
      ],
      "metadata": {
        "description": "Push Prisma schema changes to database (development)",
        "technologies": [
          "prisma"
        ]
      },
      "options": {
        "command": "prisma db push --accept-data-loss --force-reset",
        "cwd": "apps/animatrona-tracker"
      }
    },
    "db:migrate": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "db:generate"
      ],
      "metadata": {
        "description": "Create and apply database migration",
        "technologies": [
          "prisma"
        ]
      },
      "options": {
        "command": "cross-env CI= VERCEL= GITHUB_ACTIONS= GITLAB= NETLIFY= HEROKU= prisma migrate dev",
        "cwd": "apps/animatrona-tracker"
      }
    },
    "db:migrate:deploy": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Apply pending migrations (production)",
        "technologies": [
          "prisma"
        ]
      },
      "options": {
        "command": "prisma migrate deploy",
        "cwd": "apps/animatrona-tracker"
      }
    },
    "db:studio": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Open Prisma Studio database GUI",
        "technologies": [
          "prisma"
        ]
      },
      "options": {
        "command": "prisma studio",
        "cwd": "apps/animatrona-tracker"
      }
    },
    "db:seed": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "db:generate"
      ],
      "metadata": {
        "description": "Seed database with test data",
        "technologies": [
          "prisma"
        ]
      },
      "options": {
        "command": "prisma db seed",
        "cwd": "apps/animatrona-tracker"
      }
    },
    "db:reset": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Reset database and apply all migrations",
        "technologies": [
          "prisma"
        ]
      },
      "options": {
        "command": "prisma migrate reset",
        "cwd": "apps/animatrona-tracker"
      }
    },
    "db:reset:data-loss": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Reset database and apply all migrations",
        "technologies": [
          "prisma"
        ]
      },
      "options": {
        "command": "prisma migrate reset --force",
        "cwd": "apps/animatrona-tracker"
      }
    },
    "zenstack:generate": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": [
            "@letar/zenstack-form-plugin"
          ],
          "target": "build"
        }
      ],
      "cache": true,
      "inputs": [
        "{projectRoot}/schema.zmodel"
      ],
      "outputs": [
        "{projectRoot}/src/generated"
      ],
      "metadata": {
        "description": "Generate Prisma schema from ZenStack",
        "technologies": [
          "zenstack",
          "prisma"
        ]
      },
      "options": {
        "commands": [
          "zenstack generate",
          "prisma generate",
          "node -e \"require('fs').writeFileSync('src/generated/prisma/index.ts', 'export * from \\'./client\\'\\n')\""
        ],
        "cwd": "apps/animatrona-tracker",
        "parallel": false
      }
    },
    "zenstack:init": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Initialize ZenStack in project",
        "technologies": [
          "zenstack"
        ]
      },
      "options": {
        "command": "zenstack init",
        "cwd": "apps/animatrona-tracker"
      }
    },
    "oxlint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/.oxlintrc.json"
      ],
      "metadata": {
        "description": "Fast lint with oxlint (50-100x faster than ESLint)",
        "technologies": [
          "oxlint"
        ]
      },
      "options": {
        "command": "bunx oxlint src --config ../../.oxlintrc.json",
        "cwd": "apps/animatrona-tracker"
      }
    },
    "lint": {
      "dependsOn": [
        "oxlint"
      ]
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Run ESLint with auto-fix",
        "technologies": [
          "eslint"
        ]
      },
      "options": {
        "command": "eslint . --fix",
        "cwd": "apps/animatrona-tracker"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Format files with dprint (~30x faster than Prettier)",
        "technologies": [
          "dprint"
        ]
      },
      "options": {
        "command": "bunx dprint fmt \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "cwd": "apps/animatrona-tracker"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/dprint.json"
      ],
      "metadata": {
        "description": "Check file formatting with dprint",
        "technologies": [
          "dprint"
        ]
      },
      "options": {
        "command": "bunx dprint check \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "cwd": "apps/animatrona-tracker"
      }
    },
    "typecheck": {
      "dependsOn": [
        "zenstack:generate"
      ],
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/tsconfig.next-app.json",
        "{projectRoot}/tsconfig.json"
      ],
      "metadata": {
        "description": "Type-check TypeScript files",
        "technologies": [
          "typescript"
        ]
      },
      "options": {
        "command": "tsc --noEmit",
        "cwd": "apps/animatrona-tracker"
      }
    },
    "typecheck:tsgo": {
      "dependsOn": [
        "zenstack:generate"
      ],
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/tsconfig.next-app.json",
        "{projectRoot}/tsconfig.json"
      ],
      "metadata": {
        "description": "Type-check TypeScript files with tsgo (38x faster)",
        "technologies": [
          "typescript",
          "tsgo"
        ]
      },
      "options": {
        "command": "tsgo --noEmit",
        "cwd": "apps/animatrona-tracker"
      }
    },
    "test": {
      "dependsOn": [
        "zenstack:generate"
      ],
      "options": {
        "config": "vitest.config.ts"
      }
    },
    "validate": {
      "executor": "nx:noop",
      "dependsOn": [
        "lint",
        "format:check",
        "typecheck",
        "test"
      ],
      "metadata": {
        "description": "Run all validation checks"
      }
    }
  }
}

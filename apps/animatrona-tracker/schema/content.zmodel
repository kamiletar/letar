import "./enums"
import "./auth"

/// Статус жалобы на контент
enum ReportStatus {
  /// Новая жалоба, ожидает рассмотрения
  PENDING
  /// Рассмотрена модератором
  REVIEWED
  /// Решена (контент удалён/исправлен или жалоба отклонена)
  RESOLVED
}

/// Категория контента
enum ContentCategory {
  /// Аниме
  ANIME
  /// Фильм
  MOVIE
  /// Сериал
  SERIES
  /// Другое
  OTHER
}

/// Качество видео
enum VideoQuality {
  /// 480p
  P480
  /// 720p
  P720
  /// 1080p
  P1080
  /// 4K
  P4K
}

/// Причина жалобы на контент
enum ReportReason {
  /// Нарушение авторских прав
  COPYRIGHT
  /// Спам
  SPAM
  /// Неприемлемый контент
  INAPPROPRIATE
  /// Другое
  OTHER
}

// ============================================================================
// CONTENT — Основная модель раздачи
// ============================================================================

model Content {
  id          String        @id @default(cuid())

  // Метаданные
  title       String @meta("form.title", "Название") @meta("form.placeholder", "Введите название...")

  description String? @meta("form.title", "Описание") @meta("form.fieldType", "richText")

  category    ContentCategory @default(OTHER) @meta("form.title", "Категория") @meta("form.fieldType", "select")

  tags        String[] @meta("form.title", "Теги") @meta("form.fieldType", "tags")

  year        Int? @meta("form.title", "Год выпуска")

  // IPFS данные
  ipfsCid     String        @unique @meta("form.title", "IPFS CID") @meta("form.placeholder", "Qm...")

  posterCid   String? @meta("form.title", "CID постера") @meta("form.placeholder", "Qm...")

  size        BigInt        @default(0) @meta("form.title", "Размер (байты)")

  duration    Int? @meta("form.title", "Длительность (секунды)")

  quality     VideoQuality? @meta("form.title", "Качество") @meta("form.fieldType", "select")

  // Автор
  userId      String? @meta("form.exclude", true)
  user        User?         @relation(fields: [userId], references: [id]) @meta("form.exclude", true)

  // Статистика
  views       Int           @default(0) @meta("form.exclude", true)

  // Средний рейтинг (кэшированный)
  avgRating   Float? @meta("form.exclude", true)

  // Модерация
  status      ContentStatus @default(PENDING) @meta("form.title", "Статус")

  createdAt   DateTime      @default(now()) @meta("form.exclude", true)
  updatedAt   DateTime      @updatedAt @meta("form.exclude", true)

  // Relations
  ratings     Rating[] @meta("form.exclude", true)
  reports     Report[] @meta("form.exclude", true)

  // FTS индекс
  @@index([title])
  @@index([category])
  @@index([status])
  @@index([createdAt])

  // Access policies:
  // Все могут читать опубликованный контент
  @@allow('read', status == PUBLISHED)
  // Автор видит свой контент в любом статусе
  @@allow('read', auth() == user)
  // Модератор/админ видит весь контент
  @@allow('read', auth().role == MODERATOR || auth().role == ADMIN)
  // Авторизованный пользователь может создать контент
  @@allow('create', auth() != null)
  // Автор может редактировать свой контент
  @@allow('update', auth() == user)
  // Модератор/админ может менять статус и удалять
  @@allow('update,delete', auth().role == MODERATOR || auth().role == ADMIN)
}

// ============================================================================
// CONSENT LOG — Журнал согласий на обработку cookie (152-ФЗ)
// ============================================================================

model ConsentLog {
  id     String  @id @default(cuid())
  userId String?

  /// Хэш IP (sha256, без соли — для дедупликации, не для деанонимизации)
  ipHash    String
  userAgent String?

  acceptedAnalytics  Boolean @default(false)
  acceptedMarketing  Boolean @default(false)
  acceptedFunctional Boolean @default(true)

  /// Версия текста политики, на которую дано согласие
  consentVersion String

  consentedAt DateTime @default(now())

  @@allow('create', true)
  @@allow('read', auth().role == ADMIN)
  @@index([userId])
  @@index([consentedAt])
}

// ============================================================================
// RATING — Оценки контента
// ============================================================================

model Rating {
  id        String   @id @default(cuid())

  score     Int @meta("form.title", "Оценка") @meta("form.props.min", 1) @meta("form.props.max", 10)

  contentId String @meta("form.exclude", true)
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade) @meta("form.exclude", true)

  userId    String @meta("form.exclude", true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade) @meta("form.exclude", true)

  createdAt DateTime @default(now()) @meta("form.exclude", true)

  // Один пользователь — одна оценка на контент
  @@unique([contentId, userId])
  @@index([contentId])

  @@allow('read', true)
  @@allow('create,update,delete', auth() == user)
}

// ============================================================================
// REPORT — Жалобы на контент
// ============================================================================

model Report {
  id        String       @id @default(cuid())

  reason    ReportReason @meta("form.title", "Причина") @meta("form.fieldType", "select")

  details   String? @meta("form.title", "Подробности") @meta("form.fieldType", "textarea")

  contentId String @meta("form.exclude", true)
  content   Content      @relation(fields: [contentId], references: [id], onDelete: Cascade) @meta("form.exclude", true)

  userId    String @meta("form.exclude", true)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade) @meta("form.exclude", true)

  status    ReportStatus @default(PENDING) @meta("form.title", "Статус")

  createdAt DateTime     @default(now()) @meta("form.exclude", true)

  @@index([contentId])
  @@index([status])

  // Авторизованный пользователь может создать жалобу
  @@allow('create', auth() != null)
  // Модератор/админ может читать и обновлять жалобы
  @@allow('read,update', auth().role == MODERATOR || auth().role == ADMIN)
}

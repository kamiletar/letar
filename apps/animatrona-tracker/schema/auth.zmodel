import "./enums"
import "./content"
import "./anime"
import "./distribution"
import "./pinning"
import "./library"

// ============================================================================
// USER — Пользователи
// ============================================================================

model User {
  id            String    @id @default(cuid())

  email         String?   @unique @meta("form.title", "Email") @meta("form.fieldType", "email")

  name          String? @meta("form.title", "Имя")

  /// Стандартное имя Better Auth для аватара
  image         String? @meta("form.title", "Аватар")

  role          UserRole  @default(USER) @meta("form.title", "Роль")

  // Better Auth fields
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  contents      Content[]
  ratings       Rating[]
  reports       Report[]
  anime         Anime[]       // Загруженные аниме
  apiKeys       ApiKey[]      // API ключи для Animatrona
  distributions Distribution[] // Раздачи пользователя
  distributionStats DistributionStats? // Статистика раздач
  pinJobs       PinJob[]      // Созданные задания на пиннинг
  libraryItems  UserLibraryItem[] // Библиотека пользователя (Cloud Library)
  comments      AnimeComment[]   // Комментарии пользователя
  moderationLogs ModerationLog[] // Логи модерации

  // Настройки пользователя
  customGateway String? @meta("form.title", "Кастомный IPFS Gateway") @meta("form.placeholder", "https://...")

  /// Предпочитаемый режим дорожек: 'RUSSIAN_DUB' | 'ORIGINAL_SUB'
  preferredTrackMode String? @default("RUSSIAN_DUB")

  /// Композитный рейтинг загрузчика (пересчитывается при recalc-stats)
  uploaderScore Int @default(0)

  /// Ранг загрузчика: Новичок, Загрузчик, Опытный, Мастер, Легенда
  uploaderRank String? @default("Новичок")

  /// Дата рождения (для возрастной фильтрации каталога)
  birthDate DateTime?

  @@allow('read', true)
  @@allow('update', auth() == this)
  @@allow('all', auth().role == ADMIN)
}

// ============================================================================
// API KEY — Ключи для API доступа из Animatrona
// ============================================================================

/// API ключ для публикации из Animatrona
model ApiKey {
  id          String    @id @default(cuid())

  name        String @meta("form.title", "Название") @meta("form.placeholder", "Мой ключ для Animatrona")

  /// SHA256 хэш ключа (сам ключ не хранится)
  key         String    @unique @meta("form.exclude", true)

  /// Последнее использование
  lastUsedAt  DateTime? @meta("form.exclude", true)

  /// Владелец ключа
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade) @meta("form.exclude", true)
  userId      String @meta("form.exclude", true)

  createdAt   DateTime  @default(now()) @meta("form.exclude", true)

  @@index([userId])

  // Пользователь видит и управляет только своими ключами
  @@allow('all', auth() == user)
}

// ============================================================================
// BETTER AUTH MODELS
// ============================================================================

model Account {
  id                    String    @id @default(cuid())
  userId                String
  providerId            String
  accountId             String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  /// Better Auth 1.7+ — провайдер, выдавший accountId (защита от provider impersonation)
  issuer                String?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@allow('read', auth() == user)
  @@allow('all', true) // Better Auth adapter needs full access
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@allow('read', auth() == user)
  @@allow('all', true) // Better Auth adapter needs full access
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  type       String   @default("EMAIL_VERIFICATION")

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@deny('all', true)
}

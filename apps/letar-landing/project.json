{
  "name": "letar-landing",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/letar-landing/src",
  "projectType": "application",
  "tags": ["type:app", "scope:letar", "owner:letar"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next build",
        "cwd": "apps/letar-landing"
      },
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/apps/letar-landing/.next"],
      "metadata": {
        "description": "Build production bundle",
        "technologies": ["next"]
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next dev -p 3015",
        "cwd": "apps/letar-landing"
      },
      "cache": false,
      "metadata": {
        "description": "Start development server on port 3015",
        "technologies": ["next"]
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next start -p 3015",
        "cwd": "apps/letar-landing"
      },
      "dependsOn": ["build"],
      "cache": false,
      "metadata": {
        "description": "Start production server",
        "technologies": ["next"]
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": ["oxlint"],
      "options": {
        "command": "eslint .",
        "cwd": "apps/letar-landing"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/.eslintrc.json"],
      "metadata": {
        "description": "Run ESLint",
        "technologies": ["eslint"]
      }
    },
    "oxlint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx oxlint src --config ../../.oxlintrc.json",
        "cwd": "apps/letar-landing"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/.oxlintrc.json"],
      "metadata": {
        "description": "Fast lint with oxlint",
        "technologies": ["oxlint"]
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx dprint fmt \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "cwd": "apps/letar-landing"
      },
      "cache": false,
      "metadata": {
        "description": "Format files with dprint",
        "technologies": ["dprint"]
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx dprint check \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "cwd": "apps/letar-landing"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/dprint.json"],
      "metadata": {
        "description": "Check file formatting with dprint",
        "technologies": ["dprint"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "apps/letar-landing"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/tsconfig.base.json", "{projectRoot}/tsconfig.json"],
      "metadata": {
        "description": "Type-check TypeScript files",
        "technologies": ["typescript"]
      }
    },
    "typecheck:tsgo": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsgo --noEmit",
        "cwd": "apps/letar-landing"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/tsconfig.base.json", "{projectRoot}/tsconfig.json"],
      "metadata": {
        "description": "Type-check with tsgo (38x faster)",
        "technologies": ["typescript", "tsgo"]
      }
    }
  }
}

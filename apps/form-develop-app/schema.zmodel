// ZenStack schema file for Form Develop App
// Песочница для разработки @letar/forms

// Prisma 7 больше не принимает `url` в datasource — строка подключения задаётся
// в prisma.config.ts (для CLI) и в src/lib/db.ts через Pool (для рантайма).
datasource db {
  provider = "postgresql"
}

plugin prisma {
  provider = '@core/prisma'
  output = './src/generated/schema.prisma'
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// Prisma Client — нужен для типов enum'ов в UI и для PrismaClient в scripts/seed.ts.
// output задаётся относительно сгенерированного schema.prisma → ./src/generated/prisma
generator client {
  provider      = "prisma-client"
  output        = "./prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// TypeScript plugin (v3) - генерирует schema.ts для ZenStackClient
plugin typescript {
  provider = '@core/typescript'
  output = './src/generated'
}

plugin policy {
  provider = '@zenstackhq/plugin-policy'
  output = './src/generated/policy'
}

plugin formSchema {
  provider = '../../libs/zenstack-form-plugin/dist/index.js'
  output = './src/generated/form-schemas'
}

// ============================================================================
// ENUMS
// ============================================================================

enum RecipeType {
  /// Сладкое
  SWEET
  /// Солёное
  SALTY
}

// ============================================================================
// MODELS
// ============================================================================

/// Категория рецепта (для демонстрации relation полей)
model Category {
  id          String   @id @default(cuid())

  name        String @meta("form.title", "Название категории") @meta("form.placeholder", "Например: Десерты")

  description String? @meta("form.title", "Описание") @meta("form.fieldType", "textarea")

  color       String   @default("#3182CE") @meta("form.title", "Цвет") @meta("form.fieldType", "colorPicker")

  /// Рецепты в категории
  recipes     Recipe[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@allow('all', true)
}

/// Рецепт
model Recipe {
  id          String            @id @default(cuid())

  title       String @meta("form.title", "Название рецепта") @meta("form.placeholder", "Введите название")

  portions    Int               @default(1) @meta("form.title", "Количество порций") @meta("form.fieldType", "numberInput") @meta("form.props.min", 1) @meta("form.props.max", 100)

  /// Категория рецепта
  category    Category?         @relation(fields: [categoryId], references: [id]) @meta("form.title", "Категория") @meta("form.fieldType", "select") @meta("form.relation.model", "Category") @meta("form.relation.labelField", "name")
  categoryId  String?

  /// Компоненты рецепта
  components  RecipeComponent[]

  /// Информация о рецепте (1:1)
  info        RecipeInfo?

  tags        String[] @meta("form.title", "Теги") @meta("form.fieldType", "tags") @meta("form.placeholder", "Добавить тег...")

  /// Обратная связь для similarMyRecipes (implicit M:N, не используется в API)
  similarFor  RecipeInfoAdditional[] @relation("SimilarRecipes")

  // Фаза 1 (v2.4.0) zenstack-form-plugin — демо-поля для 11 новых нативных
  // атрибутов валидации (паритет с ORM, libs/forms/PLAN.md)

  slug        String            @default("recipe-") @startsWith("recipe-") @trim() @lower() @meta("form.title", "Slug (нативные @startsWith/@trim/@lower)")

  website     String?           @url() @meta("form.title", "Сайт рецепта (нативный @url)")

  authorPhone String?           @phone() @meta("form.title", "Телефон автора (нативный @phone)")

  publishedOn String?           @date() @meta("form.title", "Дата публикации (нативный @date)")

  /// Служебная заметка — не должна попадать в форму (нативный @omit)
  internalNote String?          @omit()

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Доступ для всех (песочница)
  @@allow('all', true)
}

/// Компонент рецепта (ингредиент)
model RecipeComponent {
  id          String   @id @default(cuid())

  /// Название компонента
  title       String

  /// Вес в граммах
  weightGrams Int

  recipe      Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId    String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@allow('all', true)
}

/// Информация о рецепте
model RecipeInfo {
  id        String     @id @default(cuid())

  /// Базовая информация (1:1)
  base      RecipeInfoBase?

  /// Дополнительная информация (1:1)
  additional RecipeInfoAdditional?

  recipe    Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId  String     @unique

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@allow('all', true)
}

/// Базовая информация о рецепте
model RecipeInfoBase {
  id        String     @id @default(cuid())

  type      RecipeType @default(SWEET) @meta("form.title", "Тип рецепта") @meta("form.fieldType", "radioCard")

  rating    Float      @default(0) @meta("form.title", "Рейтинг") @meta("form.fieldType", "rating") @meta("form.props.count", 5) @meta("form.props.allowHalf", true)

  info      RecipeInfo @relation(fields: [infoId], references: [id], onDelete: Cascade)
  infoId    String     @unique

  @@allow('all', true)
}

/// Дополнительная информация о рецепте
model RecipeInfoAdditional {
  id        String     @id @default(cuid())

  /// Похожие рецепты (implicit M:N с Recipe)
  similarMyRecipes Recipe[] @relation("SimilarRecipes")

  info      RecipeInfo @relation(fields: [infoId], references: [id], onDelete: Cascade)
  infoId    String     @unique

  @@allow('all', true)
}

/// Демо Фазы 2 (v2.5.0): кросс-полевая проверка `@@validate`.
/// Конец не раньше начала, ошибка привязывается к полю `endsAt`.
/// ⚠️ `@@strict()` сюда НЕ добавлен — ZenStack (стандартная библиотека) разрешает этот атрибут
/// только на `type`-определениях, не на `model` («can only be used on type definitions»,
/// проверено live-прогоном `zenstack generate`). Кодогенерация `isStrict`/`z.strictObject`
/// в @letar/zenstack-form-plugin реализована и юнит-тестами покрыта, но у `model` нет способа
/// её включить — см. libs/forms/PLAN.md, Фаза 2, вывод по `@@strict`.
model Booking {
  id        String   @id @default(cuid())

  title     String @meta("form.title", "Название")

  startsAt  DateTime @meta("form.title", "Начало")

  endsAt    DateTime @meta("form.title", "Окончание")

  @@validate(endsAt > startsAt, "Дата окончания раньше начала", ["endsAt"])

  @@allow('all', true)
}

/// Демо Фазы 3 (v3.0.0): `@meta("form.*", …)` как основной синтаксис вместо comment-директив
/// `@form.*`. `legacyNote` намеренно оставлено на старом `@form.title` — показывает, что оба
/// синтаксиса продолжают работать одновременно (обратная совместимость), и что генератор
/// печатает deprecation-warning в консоль (не ломает сборку) именно для этого поля.
model MetaSyntaxDemo {
  id          String @id @default(cuid())

  /// @meta вместо @form.title/@form.placeholder — оба текстовых атрибута
  name        String @meta("form.title", "Имя") @meta("form.placeholder", "Как вас зовут")

  /// `@meta("form.props.*", …)` — плоский путь вместо объектного литерала `@form.props({...})`:
  /// объектные литералы в `@meta` роняют `zenstack generate` целиком (`ObjectExpr`
  /// не поддержан upstream-генератором TS-схемы), см. libs/forms/PLAN.md, Фаза 3.
  rating      Int    @meta("form.title", "Оценка") @meta("form.fieldType", "rating")
    @meta("form.props.count", 5) @meta("form.props.allowHalf", true)

  bio         String? @meta("form.description", "Описание") @meta("form.fieldType", "textarea")

  /// @form.title("Заметка (legacy)")
  /// Поле намеренно НЕ переведено на @meta — единственное, что осталось на старом синтаксисе
  /// во всей экосистеме form-develop-app/form-example, чтобы demo показывал живой
  /// deprecation-warning в консоли `nx zenstack:generate`, не описание постфактум.
  legacyNote  String?

  hidden      String? @meta("form.exclude", true)

  @@allow('all', true)
}

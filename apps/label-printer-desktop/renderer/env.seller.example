# Реквизиты продавца для этикетки. Скопируйте содержимое в renderer/.env.local (файл в .gitignore).
# Значения подставляются при сборке, после изменения приложение нужно пересобрать.
NEXT_PUBLIC_LABEL_SELLER_SITE=example.ru
NEXT_PUBLIC_LABEL_SELLER_NAME=ИП Иванов И.И.
NEXT_PUBLIC_LABEL_SELLER_INN=000000000000
NEXT_PUBLIC_LABEL_SELLER_DECLARATION=Д-RU.XX00.X.00000/00

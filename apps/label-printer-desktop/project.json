{
  "name": "label-printer-desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": [
    "@letar/query-provider",
    "@letar/electron-storage"
  ],
  "sourceRoot": "apps/label-printer-desktop",
  "projectType": "application",
  "tags": [
    "type:app",
    "scope:label-printer",
    "owner:letar"
  ],
  "targets": {
    "dev": {
      "command": "node scripts/dev.js",
      "options": {
        "cwd": "apps/label-printer-desktop"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "zenstack:generate"
      ],
      "options": {
        "commands": [
          "cd renderer && next build",
          "npx webpack --config main/webpack.config.js"
        ],
        "cwd": "apps/label-printer-desktop",
        "parallel": false
      }
    },
    "build:win": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "zenstack:generate",
        "db:template"
      ],
      "options": {
        "commands": [
          "cd renderer && next build",
          "npx webpack --config main/webpack.config.js",
          "node -e \"const fs=require('fs');const p='renderer/.next/standalone/node_modules/typescript';fs.existsSync(p)&&fs.rmSync(p,{recursive:true});console.log('Removed TypeScript from standalone (~15MB saved)')\"",
          "node scripts/fix-standalone-symlinks.js",
          "npx electron-builder --win"
        ],
        "cwd": "apps/label-printer-desktop",
        "parallel": false
      }
    },
    "build:linux": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "zenstack:generate",
        "db:template"
      ],
      "options": {
        "commands": [
          "cd renderer && next build",
          "npx webpack --config main/webpack.config.js",
          "node -e \"const fs=require('fs');const p='renderer/.next/standalone/node_modules/typescript';fs.existsSync(p)&&fs.rmSync(p,{recursive:true});console.log('Removed TypeScript from standalone (~15MB saved)')\"",
          "node scripts/fix-standalone-symlinks.js",
          "npx electron-builder --linux"
        ],
        "cwd": "apps/label-printer-desktop",
        "parallel": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/label-printer-desktop/main/**/*.{ts,tsx}",
          "apps/label-printer-desktop/renderer/**/*.{ts,tsx}",
          "apps/label-printer-desktop/shared/**/*.{ts,tsx}",
          "apps/label-printer-desktop/src/**/*.{ts,tsx}"
        ]
      }
    },
    "typecheck:tsgo": {
      "dependsOn": [
        "zenstack:generate"
      ],
      "command": "tsgo --project apps/label-printer-desktop/tsconfig.json --noEmit"
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Format files with dprint",
        "technologies": [
          "dprint"
        ]
      },
      "options": {
        "command": "dprint fmt **/*.{ts,tsx,json}",
        "cwd": "apps/label-printer-desktop"
      }
    },
    "zenstack:generate": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build",
        {
          "projects": [
            "@letar/zenstack-form-plugin"
          ],
          "target": "build"
        }
      ],
      "options": {
        "commands": [
          "zenstack generate",
          "prisma generate",
          "node -e \"require('fs').writeFileSync('src/generated/prisma/index.ts', 'export * from \\'./client\\'\\n')\""
        ],
        "cwd": "apps/label-printer-desktop",
        "parallel": false
      }
    },
    "db:template": {
      "command": "bun run scripts/db-template-safe.ts",
      "dependsOn": [
        "zenstack:generate"
      ],
      "options": {
        "cwd": "apps/label-printer-desktop"
      }
    },
    "db:push": {
      "command": "prisma db push",
      "dependsOn": [
        "zenstack:generate"
      ],
      "options": {
        "cwd": "apps/label-printer-desktop"
      }
    },
    "db:migrate": {
      "command": "prisma migrate dev",
      "dependsOn": [
        "zenstack:generate"
      ],
      "options": {
        "cwd": "apps/label-printer-desktop"
      }
    },
    "db:studio": {
      "command": "prisma studio",
      "dependsOn": [
        "zenstack:generate"
      ],
      "options": {
        "cwd": "apps/label-printer-desktop"
      }
    },
    "db:seed": {
      "command": "ts-node prisma/seed.ts",
      "dependsOn": [
        "zenstack:generate"
      ],
      "options": {
        "cwd": "apps/label-printer-desktop"
      }
    },
    "test": {
      "dependsOn": [
        "zenstack:generate"
      ],
      "options": {
        "config": "vitest.config.ts",
        "coverage.reportsDirectory": "../../coverage/apps/label-printer-desktop"
      }
    }
  }
}

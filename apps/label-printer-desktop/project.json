{
  "name": "label-printer-desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/label-printer-desktop",
  "projectType": "application",
  "tags": ["type:app", "scope:label-printer", "owner:letar"],
  "targets": {
    "dev": {
      "command": "node scripts/dev.js",
      "options": {
        "cwd": "apps/label-printer-desktop"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["cd renderer && next build", "npx webpack --config main/webpack.config.js"],
        "cwd": "apps/label-printer-desktop",
        "parallel": false
      },
      "dependsOn": ["zenstack:generate"]
    },
    "build:win": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cd renderer && next build",
          "npx webpack --config main/webpack.config.js",
          "node -e \"const fs=require('fs');const p='renderer/.next/standalone/node_modules/typescript';fs.existsSync(p)&&fs.rmSync(p,{recursive:true});console.log('Removed TypeScript from standalone (~15MB saved)')\"",
          "node scripts/fix-standalone-symlinks.js",
          "npx electron-builder --win"
        ],
        "cwd": "apps/label-printer-desktop",
        "parallel": false
      },
      "dependsOn": ["zenstack:generate", "db:template"]
    },
    "build:linux": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cd renderer && next build",
          "npx webpack --config main/webpack.config.js",
          "node -e \"const fs=require('fs');const p='renderer/.next/standalone/node_modules/typescript';fs.existsSync(p)&&fs.rmSync(p,{recursive:true});console.log('Removed TypeScript from standalone (~15MB saved)')\"",
          "node scripts/fix-standalone-symlinks.js",
          "npx electron-builder --linux"
        ],
        "cwd": "apps/label-printer-desktop",
        "parallel": false
      },
      "dependsOn": ["zenstack:generate", "db:template"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/label-printer-desktop/main/**/*.{ts,tsx}",
          "apps/label-printer-desktop/renderer/**/*.{ts,tsx}",
          "apps/label-printer-desktop/shared/**/*.{ts,tsx}",
          "apps/label-printer-desktop/src/**/*.{ts,tsx}"
        ]
      }
    },
    "typecheck:tsgo": {
      "command": "tsgo --project apps/label-printer-desktop/tsconfig.json --noEmit"
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dprint fmt **/*.{ts,tsx,json}",
        "cwd": "apps/label-printer-desktop"
      },
      "cache": false,
      "metadata": {
        "description": "Format files with dprint",
        "technologies": ["dprint"]
      }
    },
    "zenstack:generate": {
      "command": "zenstack generate --schema apps/label-printer-desktop/schema.zmodel",
      "dependsOn": [
        "^build",
        {
          "projects": ["@letar/zenstack-form-plugin"],
          "target": "build"
        }
      ]
    },
    "db:template": {
      "command": "bun run scripts/db-template-safe.ts",
      "options": {
        "cwd": "apps/label-printer-desktop"
      },
      "dependsOn": ["zenstack:generate"]
    },
    "db:push": {
      "command": "prisma db push --schema apps/label-printer-desktop/src/generated/schema.prisma",
      "dependsOn": ["zenstack:generate"]
    },
    "db:migrate": {
      "command": "prisma migrate dev --schema apps/label-printer-desktop/src/generated/schema.prisma",
      "dependsOn": ["zenstack:generate"]
    },
    "db:studio": {
      "command": "prisma studio --schema apps/label-printer-desktop/src/generated/schema.prisma",
      "dependsOn": ["zenstack:generate"]
    },
    "db:seed": {
      "command": "ts-node apps/label-printer-desktop/prisma/seed.ts",
      "dependsOn": ["zenstack:generate"]
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "config": "apps/label-printer-desktop/vitest.config.ts",
        "reportsDirectory": "../../coverage/apps/label-printer-desktop"
      }
    }
  }
}

// ZenStack schema for Label Printer Desktop
// Electron приложение для печати этикеток "Честный знак"

datasource db {
  provider = "sqlite"
}

// Prisma Client generator — генерирует клиент в src/generated/prisma/
// Путь относительно сгенерированной schema.prisma в src/generated/
generator client {
  provider = "prisma-client"
  output   = "./prisma"
}

plugin prisma {
  provider = "@core/prisma"
  output   = "./src/generated/schema.prisma"
}

plugin typescript {
  provider = "@core/typescript"
  output   = "./src/generated"
}

// Access control plugin (v3)
plugin policy {
  provider = "@zenstackhq/plugin-policy"
}

plugin hooks {
  provider = "@zenstackhq/tanstack-query/react"
  output   = "./src/generated/hooks"
  target   = "react"
}

// Плагин для генерации Zod схем с UI метаданными
plugin formSchema {
  provider = "../../libs/zenstack-form-plugin/dist/index.js"
  output   = "./src/generated/form-schemas"
}

enum PrinterMode {
  /// Реальный принтер
  REAL
  /// Тестовый режим (сохраняет в файлы)
  MOCK
}

enum LabelPrintMode {
  /// Bitmap режим: отправляет готовое изображение
  BITMAP
  /// Native режим: использует команды TSPL для DataMatrix и штрихкода
  NATIVE
}

/// Настройки приложения (singleton)
model Settings {
  id              String  @id @default("default")

  // Принтер
  printerName     String  @default("TSC_TE300") @meta("form.title", "Имя принтера") @meta("form.placeholder", "TSC TE300")

  printerMode     PrinterMode @default(REAL) @meta("form.title", "Режим работы") @meta("form.fieldType", "radioCard")

  labelPrintMode  LabelPrintMode @default(BITMAP) @meta("form.title", "Режим печати этикетки") @meta("form.description", "BITMAP: отправляет готовое изображение. NATIVE: использует команды принтера для кодов") @meta("form.fieldType", "radioCard")

  printerSpeed    Int     @default(4) @meta("form.title", "Скорость печати") @meta("form.fieldType", "slider") @meta("form.props.min", 1) @meta("form.props.max", 14) @meta("form.props.showValue", true)

  printerDensity  Int     @default(8) @meta("form.title", "Плотность печати") @meta("form.fieldType", "slider") @meta("form.props.min", 0) @meta("form.props.max", 15) @meta("form.props.showValue", true)

  copies          Int     @default(1) @meta("form.title", "Количество копий") @meta("form.fieldType", "numberInput") @meta("form.props.min", 1) @meta("form.props.max", 100)

  // Шаблон этикетки
  templateId      String? @meta("form.title", "Шаблон") @meta("form.relation.model", "Template") @meta("form.relation.labelField", "name")
  template        Template? @relation(fields: [templateId], references: [id])

  // Позиция DataMatrix
  datamatrixX     Int     @default(26) @meta("form.title", "DataMatrix X") @meta("form.fieldType", "numberInput") @meta("form.props.min", 0)

  datamatrixY     Int     @default(160) @meta("form.title", "DataMatrix Y") @meta("form.fieldType", "numberInput") @meta("form.props.min", 0)

  datamatrixSize  Int     @default(160) @meta("form.title", "Размер DataMatrix") @meta("form.description", "Размер в пикселях (рекомендуется 160)") @meta("form.fieldType", "numberInput") @meta("form.props.min", 50) @meta("form.props.max", 200)

  // Позиция GTIN
  gtinX           Int     @default(526) @meta("form.title", "GTIN X") @meta("form.fieldType", "numberInput") @meta("form.props.min", 0)

  gtinY           Int     @default(10) @meta("form.title", "GTIN Y") @meta("form.fieldType", "numberInput") @meta("form.props.min", 0)

  gtinWidth       Int     @default(140) @meta("form.title", "Ширина GTIN") @meta("form.fieldType", "numberInput") @meta("form.props.min", 50) @meta("form.props.max", 300)

  gtinHeight      Int     @default(440) @meta("form.title", "Высота GTIN") @meta("form.fieldType", "numberInput") @meta("form.props.min", 100) @meta("form.props.max", 500)

  // Поведение
  allowDuplicates Boolean @default(false) @meta("form.title", "Разрешить дубликаты") @meta("form.fieldType", "switch") @meta("form.description", "Печатать этикетки для уже использованных кодов")

  autoReconnect   Boolean @default(true) @meta("form.title", "Автопереподключение") @meta("form.fieldType", "switch")

  autoUpdate      Boolean @default(false) @meta("form.title", "Автообновление") @meta("form.fieldType", "switch") @meta("form.description", "Автоматически проверять обновления при запуске")

  retryAttempts   Int     @default(3) @meta("form.title", "Попыток при ошибке") @meta("form.fieldType", "numberInput") @meta("form.props.min", 0) @meta("form.props.max", 10)

  // Сканер
  scannerPort     String? @default("") @meta("form.title", "COM-порт сканера") @meta("form.placeholder", "COM5") @meta("form.description", "Оставьте пустым для USB HID режима (клавиатура)")

  scannerBaudRate Int     @default(9600) @meta("form.title", "Скорость порта (baud)") @meta("form.fieldType", "select") @meta("form.props.options", [9600,19200,38400,57600,115200])

  scannerEnabled  Boolean @default(true) @meta("form.title", "Сканер включен") @meta("form.fieldType", "switch")

  updatedAt       DateTime @updatedAt

  // Desktop приложение без аутентификации — полный доступ
  @@allow('all', true)
}

/// Шаблон этикетки
model Template {
  id          String   @id @default(cuid())

  name        String @meta("form.title", "Название")

  path        String @meta("form.title", "Путь к файлу") @meta("form.description", "Относительный путь к PNG файлу")

  width       Int      @default(685) @meta("form.title", "Ширина (px)") @meta("form.fieldType", "numberInput") @meta("form.props.min", 100) @meta("form.props.max", 2000)

  height      Int      @default(461) @meta("form.title", "Высота (px)") @meta("form.fieldType", "numberInput") @meta("form.props.min", 100) @meta("form.props.max", 2000)

  isDefault   Boolean  @default(false) @meta("form.title", "По умолчанию") @meta("form.fieldType", "switch")

  settings    Settings[]
  createdAt   DateTime @default(now())

  // Desktop приложение без аутентификации — полный доступ
  @@allow('all', true)
}

/// Товар (база GTIN)
model Product {
  id           String     @id @default(cuid())

  gtin         String     @unique @meta("form.title", "GTIN") @meta("form.placeholder", "4610000000007") @meta("form.description", "13-14 цифр штрихкода товара")

  name         String @meta("form.title", "Название товара") @meta("form.placeholder", "Галстук Детский")

  articleCode  String? @meta("form.title", "Артикул") @meta("form.placeholder", "ГМ")

  composition  String? @meta("form.title", "Состав") @meta("form.placeholder", "100% полиэстер")

  color        String? @meta("form.title", "Цвет") @meta("form.placeholder", "разноцветный")

  size         String? @meta("form.title", "Размер") @meta("form.placeholder", "42")

  manufacturer String? @meta("form.title", "Производитель")

  category     String? @meta("form.title", "Категория")

  printJobs    PrintJob[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([gtin])
  @@index([name])

  // Desktop приложение без аутентификации — полный доступ
  @@allow('all', true)
}

/// Напечатанная этикетка (история)
model PrintJob {
  id            String   @id @default(cuid())

  fullCode      String   @unique @meta("form.exclude", true)

  gtin          String @meta("form.title", "GTIN")

  serialNumber  String @meta("form.title", "Серийный номер")

  cryptoCode    String? @meta("form.exclude", true)

  templateId    String? @meta("form.exclude", true)

  /// Связь с товаром (опционально)
  productId     String?
  product       Product?  @relation(fields: [productId], references: [id])

  scanCount     Int      @default(1) @meta("form.title", "Сканирований")

  printed       Boolean  @default(false) @meta("form.title", "Напечатано") @meta("form.fieldType", "switch")

  firstScannedAt DateTime @default(now())
  lastScannedAt  DateTime @default(now())

  @@index([gtin])
  @@index([printed])
  @@index([firstScannedAt])
  @@index([productId])

  // Desktop приложение без аутентификации — полный доступ
  @@allow('all', true)
}

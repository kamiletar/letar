{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "outDir": "out-tsc/playwright",
    "rootDir": "../..",
    "sourceMap": false,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@letar/env-load": ["../../libs/env-load/src/index.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.js",
    "playwright.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.js",
    "src/**/*.test.ts",
    "src/**/*.test.js",
    "src/**/*.d.ts",
    "../../libs/env-load/src/**/*.ts"
  ],
  "exclude": [
    "out-tsc",
    "test-output",
    "eslint.config.js",
    "eslint.config.mjs",
    "eslint.config.cjs",
    "../../libs/env-load/src/**/*.spec.ts"
  ]
}

# ============================================
# Domain Configuration (for Nginx Proxy Manager)
# ============================================
# Все домены через запятую: основной и алиасы
DOMAIN=imot.yourdomain.com

# ============================================
# Database Configuration
# ============================================
DB_PASSWORD=your_secure_db_password

# ============================================
# Auth.js Configuration
# ============================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3001

# ============================================
# Google OAuth (Optional)
# ============================================
# Get from: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# ============================================
# Yandex OAuth (Optional)
# ============================================
# Get from: https://oauth.yandex.ru/
AUTH_YANDEX_ID=your-yandex-client-id
AUTH_YANDEX_SECRET=your-yandex-client-secret

# ============================================
# Telegram Login Widget (Optional)
# ============================================
# Инструкция по получению:
# 1. Создайте бота через @BotFather в Telegram
# 2. Отправьте /newbot и следуйте инструкциям
# 3. Сохраните Bot Token (формат: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
# 4. Отправьте /setdomain боту @BotFather
# 5. Выберите вашего бота и установите домен
AUTH_TELEGRAM_BOT_ID=your-telegram-bot-id
AUTH_TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ============================================
# Yandex SMTP Configuration (Email)
# ============================================
# Для отправки email уведомлений через Yandex
# Инструкция:
# 1. Перейдите на https://passport.yandex.ru/profile
# 2. Безопасность → Пароли приложений
# 3. Создайте пароль для приложения "Почта"
# 4. Используйте этот пароль в SMTP_PASSWORD
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@yandex.ru"
SMTP_PASSWORD="your-app-password-from-yandex"
SMTP_FROM="ИМОТ <your-email@yandex.ru>"

# ============================================
# Application Configuration
# ============================================
# URL приложения (для email ссылок и OAuth callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Cron Secret (для защиты API endpoints)
# Generate with: openssl rand -hex 32
CRON_SECRET="your-secret-key-change-in-production"

# ============================================
# Optional APIs
# ============================================
# DaData API (для автодополнения адресов)
NEXT_PUBLIC_DADATA_API_KEY=your-dadata-api-key

# Yandex Metrika (для аналитики)
NEXT_PUBLIC_YM_COUNTER_ID=

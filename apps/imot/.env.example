# ============================================
# Database Configuration
# ============================================
DATABASE_URL="postgresql://username:password@localhost:5432/imot?schema=public"

# ============================================
# Auth.js Configuration
# ============================================
# Generate with: openssl rand -base64 32
# или используйте: https://generate-secret.vercel.app/32
AUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# ============================================
# Google OAuth (Optional)
# ============================================
# Инструкция по получению:
# 1. Перейдите на https://console.cloud.google.com/
# 2. Создайте проект или выберите существующий
# 3. Включите Google+ API
# 4. Credentials → Create Credentials → OAuth 2.0 Client ID
# 5. Application type: Web application
# 6. Authorized redirect URIs: http://localhost:3001/api/auth/callback/google
# Документация: https://next-auth.js.org/providers/google
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# ============================================
# Yandex OAuth (Optional)
# ============================================
# Инструкция по получению:
# 1. Перейдите на https://oauth.yandex.ru/
# 2. Зарегистрируйте приложение
# 3. Платформы: Веб-сервисы
# 4. Redirect URI: http://localhost:3001/api/auth/callback/yandex
# 5. Доступы: login:email, login:info, login:avatar
# Документация: https://next-auth.js.org/providers/yandex
AUTH_YANDEX_ID="your-yandex-client-id"
AUTH_YANDEX_SECRET="your-yandex-client-secret"

# ============================================
# Telegram Login Widget (Optional)
# ============================================
# Инструкция по получению:
# 1. Создайте бота через @BotFather в Telegram
# 2. Отправьте /newbot и следуйте инструкциям
# 3. Сохраните Bot Token (формат: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
# 4. Отправьте /setdomain боту @BotFather
# 5. Выберите вашего бота и установите домен: localhost:3001
# Документация: https://core.telegram.org/widgets/login
AUTH_TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"

# ============================================
# Yandex SMTP Configuration (Email)
# ============================================
# Для отправки email уведомлений через Yandex
# Инструкция:
# 1. Перейдите на https://passport.yandex.ru/profile
# 2. Безопасность → Пароли приложений
# 3. Создайте пароль для приложения "Почта"
# 4. Используйте этот пароль в SMTP_PASSWORD
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@yandex.ru"
SMTP_PASSWORD="your-app-password-from-yandex"
SMTP_FROM="ИМОТ <your-email@yandex.ru>"

# ============================================
# Application Configuration
# ============================================
# URL приложения (для email ссылок и OAuth callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Cron Secret (для защиты API endpoints)
# Generate with: openssl rand -hex 32
CRON_SECRET="your-secret-key-change-in-production"

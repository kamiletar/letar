# Dockerfile.production - для уже собранных приложений
# Используется когда сборка выполнена на сервере с nx build
# Build context: workspace root (/home/deploy/letar)

FROM letar-node-runtime:24 AS runner
WORKDIR /app

# Копируем уже собранный standalone output
COPY --chown=nextjs:nodejs apps/aira-web/.next/standalone ./

# Копируем статику и public (не включаются в standalone автоматически)
COPY --chown=nextjs:nodejs apps/aira-web/.next/static ./apps/aira-web/.next/static
COPY --chown=nextjs:nodejs apps/aira-web/public ./apps/aira-web/public

USER nextjs

EXPOSE 3017

ENV PORT=3017
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/aira-web/server.js"]

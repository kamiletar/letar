# Dockerfile.production - для dashboard приложения
# Используется когда сборка выполнена на сервере с nx build affected
# Build context: workspace root (C:\web\letar)

FROM letar-node-runtime:24 AS runner
WORKDIR /app

# letar-node-runtime уже создал nodejs/nextjs (uid/gid 1001) и настроил TZ — здесь только
# добавка поверх базы: docker-cli для управления контейнерами через сокет (§129).
# Alpine-пакеты ставим с зеркала, а не с dl-cdn.alpinelinux.org: с s3 (188.127.235.141) до
# Fastly-адресов dl-cdn нет пути вообще — ни по IPv4 (все 4 адреса), ни по IPv6, ни с хоста,
# ни из контейнера. При этом GitHub, npm, Docker registry и сами зеркала Alpine с того же
# хоста доступны, так что дело не в сети сервера и не в BuildKit — недоступен ровно этот CDN.
# Симптом без зеркала: `WARNING: fetching APKINDEX.tar.gz: TLS: unspecified error` и
# `no such package`, три сборки подряд, стабильно. Разбор — .claude/docs/alpine-cdn-unreachable-s3.md
ARG ALPINE_MIRROR=https://mirror.yandex.ru/mirrors/alpine
RUN sed -i "s|https://dl-cdn.alpinelinux.org/alpine|${ALPINE_MIRROR}|g" /etc/apk/repositories

# Install Docker CLI for container management
# Dashboard needs docker CLI to communicate with Docker daemon via socket
# openssh-client needed for git operations with SSH remotes
RUN apk add --no-cache docker-cli git openssh-client

# Add nextjs user to docker group for socket access
# The actual group GID will be mapped at runtime via volume mount
RUN addgroup -g 999 docker || true
RUN addgroup nextjs docker || true

# Copy already built standalone output
# Standalone includes all necessary node_modules
COPY --chown=nextjs:nodejs apps/dashboard/.next/standalone ./

# Copy static assets and public folder (not included in standalone automatically)
COPY --chown=nextjs:nodejs apps/dashboard/.next/static ./apps/dashboard/.next/static
COPY --chown=nextjs:nodejs apps/dashboard/public ./apps/dashboard/public

# Create directories for dashboard data persistence
RUN mkdir -p /app/dashboard-data && chown -R nextjs:nodejs /app/dashboard-data

# Run as root to access Docker socket
# In production, consider proper group mapping instead
# USER nextjs

EXPOSE 3002

ENV PORT=3002
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/dashboard/server.js"]

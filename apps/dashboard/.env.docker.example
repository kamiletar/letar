# Dashboard Docker Environment Configuration
# Copy this file to .env.docker and fill in the values

# =============================================================================
# Domain Configuration (for Nginx Proxy Manager)
# =============================================================================
# Все домены через запятую: основной и алиасы
DOMAIN=dash.letar.best

# =============================================================================
# Auth.js Configuration
# =============================================================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-random-auth-secret-here
NEXTAUTH_URL=https://dash.letar.best

# =============================================================================
# Dashboard Admin Credentials
# =============================================================================
DASHBOARD_ADMIN_USERNAME=admin
DASHBOARD_ADMIN_PASSWORD=change-this-to-strong-password-kdjhjbhfkhsdfsdfdsfdsfdsfsdfjhgdskfhkjdsfsdfds

DASHBOARD_VIEWER_USERNAME=viewer
DASHBOARD_VIEWER_PASSWORD=change-this-to-strong-password-sdfljkbsjdknbjhjbfjkshdjfghskjdfkhsdgfkhdshkf

# =============================================================================
# Dashboard API Protection
# =============================================================================
# Generate with: openssl rand -hex 32
DASHBOARD_SECRET_KEY=your-random-api-key-here

# =============================================================================
# Workspace Path (on host machine)
# =============================================================================
# Path to the Nx monorepo on the host machine
WORKSPACE_PATH=/home/lena

# =============================================================================
# Dashboard PostgreSQL Database
# =============================================================================
# Generate secure password: openssl rand -base64 24
DB_PASSWORD=change-this-to-strong-password

# =============================================================================
# External PostgreSQL Databases (read-only secrets)
# =============================================================================
# Конфигурация БД других приложений автоматически читается из смонтированных файлов
# (см. volumes секцию docker-compose.production.yml).
# Никаких настроек внешних БД здесь указывать НЕ нужно!

# =============================================================================
# Local Dashboard Agent
# =============================================================================
# Токен для доступа к dashboard-agent на localhost:3100
# Должен совпадать с AGENT_TOKEN в apps/dashboard-agent/.env.docker на этом сервере
# Generate with: openssl rand -hex 32
LOCAL_AGENT_TOKEN=your-agent-token-here

# =============================================================================
# Monitoring Service
# =============================================================================
# Auto-start background monitoring on server start
AUTO_START_MONITORING=true

# =============================================================================
# Telegram Bot (Optional - for notifications)
# =============================================================================
# Create a bot via @BotFather and get the token
# Get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================================================
# Yandex SMTP (Optional - for email notifications)
# =============================================================================
# Инструкция:
# 1. Перейдите на https://passport.yandex.ru/profile
# 2. Безопасность → Пароли приложений
# 3. Создайте пароль для приложения "Почта"
# 4. Используйте этот пароль в SMTP_PASSWORD
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=elena@rosstil.ru
SMTP_PASSWORD=
SMTP_FROM="Dashboard <elena@rosstil.ru>"

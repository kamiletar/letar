// ZenStack schema file for Dashboard application
// Панель мониторинга серверной инфраструктуры

import "../../libs/zenstack-fragments/src/better-auth"

datasource db {
  provider = "postgresql"
}

plugin prisma {
  provider = '@core/prisma'
  output = './src/generated/schema.prisma'
}

generator client {
  provider      = "prisma-client"
  output        = "./prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}


// TypeScript plugin (v3) — генерирует schema.ts для ZenStackClient
plugin typescript {
  provider = '@core/typescript'
  output = './src/generated'
}

// Access control plugin (v3)
plugin policy {
  provider = '@zenstackhq/plugin-policy'
}

// ============================================================================
// BETTER AUTH MODELS
// ============================================================================

/// Роли пользователей Dashboard
enum UserRole {
  /// Новый пользователь без доступа (по умолчанию)
  USER
  /// Администратор с полным доступом
  ADMIN
  /// Только просмотр
  VIEWER
}

/// Пользователи Dashboard
model User {
  id              String    @id @default(cuid())
  name            String?
  username        String?   @unique
  displayUsername String?   /// Для Better Auth username plugin
  email           String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(USER)

  accounts      Account[]
  sessions      Session[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@auth
  @@allow('all', true)
}

/// OAuth аккаунты (Better Auth)
model Account with AccountFields {
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@allow('all', true)
}

/// Сессии пользователей (Better Auth)
model Session with SessionFields {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@allow('all', auth() == user)
}

/// Токены верификации (Better Auth)
model Verification with VerificationFields {
  type       String   @default("EMAIL_VERIFICATION")

  @@index([identifier])
  @@deny('all', true)
}

// ============================================================================
// ENUMS
// ============================================================================

/// Типы алертов системы мониторинга
enum AlertType {
  /// Высокая загрузка CPU
  CPU_HIGH
  /// Высокое использование памяти
  MEMORY_HIGH
  /// Мало места на диске
  DISK_HIGH
  /// Docker контейнер упал
  CONTAINER_DOWN
  /// Docker контейнер перезапустился (crash/OOM)
  CONTAINER_RESTARTED
  /// База данных недоступна
  DATABASE_DOWN
  /// Ошибка деплоя
  DEPLOY_FAILED
  /// Ошибка бэкапа
  BACKUP_FAILED
  /// Ошибка cron задачи
  CRON_FAILED
  /// SSL сертификат скоро истекает или уже истёк
  SSL_EXPIRING
  /// Найдены уязвимые зависимости (§25 PLAN-INFRA.md)
  DEPS_VULNERABLE
  /// Lock-файл давно не обновлялся (§25 PLAN-INFRA.md)
  DEPS_STALE
}

/// Уровни серьёзности алертов
enum AlertSeverity {
  /// Информационное сообщение
  INFO
  /// Предупреждение
  WARNING
  /// Ошибка
  ERROR
  /// Критическая проблема
  CRITICAL
}

/// Статусы алертов
enum AlertStatus {
  /// Активный алерт
  ACTIVE
  /// Подтверждённый оператором
  ACKNOWLEDGED
  /// Проблема решена
  RESOLVED
}

/// Статусы выполнения cron задач
enum CronStatus {
  /// Успешно выполнено
  SUCCESS
  /// Ошибка выполнения
  ERROR
  /// В процессе выполнения
  RUNNING
}

/// Статусы health check приложений
enum HealthStatus {
  /// Приложение работает
  UP
  /// Приложение недоступно
  DOWN
}

/// Типы приложений
enum AppType {
  /// Веб-приложение с портом
  WEB
  /// CLI утилита
  CLI
  /// Фоновый сервис
  SERVICE
}

/// Тип доступного обновления пакета (§25 PLAN-INFRA.md)
enum DepUpdateKind {
  MAJOR
  MINOR
  PATCH
  NONE
}

/// Уровень серьёзности уязвимости по шкале npm/bun audit (low/moderate/high/critical) —
/// отдельный enum, не переиспользует AlertSeverity: шкалы не совпадают, маппинг делается в коде
enum DepVulnSeverity {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

/// Итоговый уровень риска пакета (устаревание + уязвимости + критичность пакета)
enum DepRiskLevel {
  NONE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Статус разбора changelog моделью для пакета с высоким риском
enum DepAnalysisStatus {
  NOT_REQUIRED
  PENDING
  DONE
  FAILED
}

// ============================================================================
// MODELS
// ============================================================================

/// Алерты системы мониторинга
model Alert {
  id             String        @id @default(cuid())
  type           AlertType
  severity       AlertSeverity
  status         AlertStatus   @default(ACTIVE)
  title          String
  message        String
  metadata       Json?
  createdAt      DateTime      @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  /// Сервер, с которого пришёл алерт (опционально для обратной совместимости)
  server         Server?       @relation(fields: [serverId], references: [id], onDelete: SetNull)
  serverId       String?

  // Dashboard: все операции требуют авторизации
  @@allow('all', auth() != null)
  @@index([status, createdAt])
  @@index([type])
  @@index([serverId])
}

/// Настройки системы алертов (singleton)
model AlertSettings {
  id               String   @id @default("default")
  enabled          Boolean  @default(true)
  cpuThreshold     Int      @default(90)
  memoryThreshold  Int      @default(90)
  diskThreshold    Int      @default(90)
  checkInterval    Int      @default(30)
  telegramEnabled  Boolean  @default(false)
  telegramBotToken String?
  telegramChatId   String?
  updatedAt        DateTime @updatedAt

  @@allow('all', auth() != null)
}

/// Лог выполнения cron задач
model CronExecutionLog {
  id           String     @id @default(cuid())
  jobId        String
  startedAt    DateTime   @default(now())
  completedAt  DateTime?
  status       CronStatus
  statusCode   Int?
  responseBody String?    @db.Text
  error        String?    @db.Text
  duration     Int?       // миллисекунды

  @@allow('all', auth() != null)
  @@index([jobId, startedAt(sort: Desc)])
}

/// Health check результаты приложений
model HealthCheck {
  id           String       @id @default(cuid())
  app          String
  timestamp    DateTime     @default(now())
  status       HealthStatus
  responseTime Int          // миллисекунды
  statusCode   Int?
  error        String?

  @@allow('all', auth() != null)
  @@index([app, timestamp(sort: Desc)])
}

/// Системные метрики (CPU, RAM, Disk)
model SystemMetric {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  tier        String   @default("realtime") // realtime, hourly, daily
  cpu         Float
  memory      Float
  memoryUsed  BigInt
  memoryTotal BigInt
  disk        Float
  diskUsed    BigInt
  diskTotal   BigInt
  networkRx   BigInt?
  networkTx   BigInt?

  @@allow('all', auth() != null)
  @@index([tier, timestamp(sort: Desc)])
}

/// Аудит действий пользователей
model AuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  username  String
  role      String
  action    String
  resource  String?
  details   Json?
  success   Boolean  @default(true)
  error     String?

  @@allow('all', auth() != null)
  @@index([timestamp(sort: Desc)])
  @@index([action])
  @@index([username])
}

/// Грубый счётчик просмотров по домену/дню — агрегат без ПДн (без IP/UA/cookie/идентификатора
/// посетителя), заполняется парсингом access-логов Nginx Proxy Manager (lib/pageview-counter.ts).
/// Дополняет Umami там, где cookie-consent gate не пропускает часть трафика (см. PLAN.md).
model PageViewCount {
  id     String @id @default(cuid())
  /// YYYY-MM-DD (не DateTime — избегаем сдвига дня при чтении в другом TZ)
  date   String
  domain String
  count  Int    @default(0)

  @@unique([date, domain])
  @@allow('all', auth() != null)
  @@index([domain, date(sort: Desc)])
}

/// Байтовый offset последнего прочитанного access-лога NPM на домен — инкрементальный парсинг
/// без повторного чтения всего файла и без хранения самих строк лога.
model PageViewLogOffset {
  domain     String   @id
  byteOffset BigInt   @default(0)
  updatedAt  DateTime @updatedAt

  @@allow('all', auth() != null)
}

// ============================================================================
// MULTI-SERVER SUPPORT
// ============================================================================

/// Сервер для мониторинга (локальный или удалённый через агента)
model Server {
  id          String    @id @default(cuid())
  /// Уникальное имя сервера (slug)
  name        String    @unique
  /// Отображаемое имя
  displayName String
  /// Хост агента (IP или hostname)
  host        String
  /// Порт агента
  port        Int       @default(3100)
  /// Локальный сервер (не требует агента)
  isLocal     Boolean   @default(false)
  /// Активен ли сервер для мониторинга
  isActive    Boolean   @default(true)
  /// Токен для аутентификации агента (зашифрован)
  agentToken  String?   @db.Text
  /// Последний успешный heartbeat
  lastSeen    DateTime?
  /// Порядок отображения в списке
  sortOrder   Int       @default(0)

  // === Nginx Proxy Manager ===
  /// URL NPM API (например http://localhost:81)
  npmUrl      String?
  /// Email для авторизации в NPM
  npmEmail    String?
  /// Пароль для авторизации в NPM (зашифрован)
  npmPassword String?   @db.Text

  /// Приложения, развёрнутые на этом сервере
  apps        DeployedApp[]
  /// Алерты с этого сервера
  alerts      Alert[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Чтение — для авторизованных, CRUD — только ADMIN
  @@allow('read', auth() != null)
  @@allow('create,update,delete', auth() != null && auth().role == 'ADMIN')
  @@index([isActive, sortOrder])
}

/// Приложение, развёрнутое на сервере
model DeployedApp {
  id            String    @id @default(cuid())
  /// Имя приложения (slug)
  name          String
  /// Отображаемое имя
  displayName   String
  /// Имя Docker контейнера
  containerName String?
  /// Порт приложения
  port          Int?
  /// Тип приложения
  type          AppType   @default(WEB)
  /// Docker образ (например, letar/driving-school:latest)
  imageName     String?
  /// Домен приложения (например, driving-school.letar.best)
  domain        String?
  /// Время последнего деплоя
  lastDeployed  DateTime?
  /// Umami website ID для аналитики (хранится в БД, не в .env.docker)
  umamiWebsiteId String?

  /// Сервер, на котором развёрнуто приложение
  server        Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId      String

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Одно приложение на сервер
  @@unique([name, serverId])
  // Чтение — для авторизованных, CRUD — только ADMIN
  @@allow('read', auth() != null)
  @@allow('create,update,delete', auth() != null && auth().role == 'ADMIN')
  @@index([serverId])
}

// ============================================================================
// §25 PLAN-INFRA.md — еженедельный контроль зависимостей
// ============================================================================

/// Снапшот одного запуска `scripts/deps-scan.ts` (агрегаты денормализованы — карточки и
/// порог алерта считаются без чтения `DepPackage[]`)
model DepScan {
  id                  String             @id @default(cuid())
  createdAt           DateTime           @default(now())
  /// Время запуска на машине разработчика (может отличаться от createdAt — POST с задержкой)
  scannedAt           DateTime
  /// Источник данных: `local` (bun outdated/audit) или `local-fallback` (npm registry, Этап 3)
  source              String             @default("local")
  gitCommit           String
  gitBranch           String
  /// Дата последнего изменения bun.lock — сигнал «давно не обновляли» (см. риски §25 п.2)
  lockfileUpdatedAt   DateTime?
  lockfileCommit      String?
  bunVersion          String
  /// Версия самого скрипта-сканера — чтобы при поломке парсера было видно, где сменился формат
  scannerVersion      String
  totalPackages       Int
  outdatedCount       Int
  majorCount          Int
  minorCount           Int
  patchCount          Int
  vulnCount           Int
  vulnCritical        Int                @default(0)
  vulnHigh            Int                @default(0)
  vulnModerate        Int                @default(0)
  vulnLow             Int                @default(0)
  pinnedOutdatedCount Int                @default(0)
  riskScore           Int
  durationMs          Int
  analysisStatus      DepAnalysisStatus  @default(NOT_REQUIRED)
  analysisSummary     String?            @db.Text
  analysisAt          DateTime?
  analysisModel       String?
  reviewedAt          DateTime?
  reviewedBy          String?
  /// Сырой вывод `bun audit --json` — позволяет переразобрать историю без повторного скана
  rawAudit            Json?

  packages            DepPackage[]

  @@allow('all', auth() != null)
  @@index([createdAt(sort: Desc)])
  @@index([analysisStatus])
}

/// Строка внутри скана — один пакет
model DepPackage {
  id                  String            @id @default(cuid())
  createdAt           DateTime          @default(now())
  scan                DepScan           @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId              String
  name                String
  /// null у транзитивных пакетов, которые видит только audit, не outdated
  currentVersion      String?
  wantedVersion       String?
  latestVersion       String?
  updateKind          DepUpdateKind     @default(NONE)
  /// dependencies / devDependencies / transitive
  depType             String
  /// В `resolutions`/`overrides` корневого package.json
  isPinned            Boolean           @default(false)
  vulnerable          Boolean           @default(false)
  maxSeverity         DepVulnSeverity?
  advisoryCount       Int               @default(0)
  advisories          Json?
  riskLevel           DepRiskLevel      @default(NONE)
  analysisNote        String?           @db.Text
  analysisAt          DateTime?
  /// ID скана, из которого перенесена заметка анализа (Этап 2) — показывается в UI как «не свежая»
  analysisCarriedFrom String?
  breakingChanges     Boolean?

  @@unique([scanId, name])
  @@index([scanId, riskLevel])
  @@index([name, createdAt])
  @@allow('all', auth() != null)
}

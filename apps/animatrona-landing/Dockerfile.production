# Dockerfile.production - для уже собранных приложений
# Используется когда сборка выполнена на сервере с nx build
# Build context: workspace root (C:\web\letar)

FROM letar-node-runtime:24 AS runner
WORKDIR /app

# Копируем уже собранный standalone output
# Standalone включает в себя все необходимые node_modules
COPY --chown=nextjs:nodejs apps/animatrona-landing/.next/standalone ./

# Копируем статику и public (не включаются в standalone автоматически)
COPY --chown=nextjs:nodejs apps/animatrona-landing/.next/static ./apps/animatrona-landing/.next/static
COPY --chown=nextjs:nodejs apps/animatrona-landing/public ./apps/animatrona-landing/public

USER nextjs

EXPOSE 3008

ENV PORT=3008
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/animatrona-landing/server.js"]

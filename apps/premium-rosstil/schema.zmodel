// ZenStack schema file with access control policies
// This extends Prisma schema with authorization rules

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./prisma"
}

plugin prisma {
  provider = '@core/prisma'
  output = './src/generated/schema.prisma'
}

// TypeScript plugin (v3) - генерирует schema.ts для ZenStackClient
plugin typescript {
  provider = '@core/typescript'
  output = './src/generated'
}

// Access control plugin (v3)
plugin policy {
  provider = '@zenstackhq/plugin-policy'
}

plugin formSchema {
  provider = '../../libs/zenstack-form-plugin/dist/index.js'
  output = './src/generated/form-schemas'
}


enum UserRole {
  /// Пользователь
  USER
  /// Продавец (маркетплейс)
  SELLER
  /// Администратор
  ADMIN
}

enum Gender {
  /// Мужской
  MALE
  /// Женский
  FEMALE
}

enum OrderStatus {
  /// Новый заказ
  NEW
  /// Предзаказ (ожидание поступления)
  PREORDER
  /// Подтверждён
  CONFIRMED
  /// В обработке
  PROCESSING
  /// Отправлен
  SHIPPED
  /// Доставлен
  DELIVERED
  /// Отменён
  CANCELLED
}

enum CustomOrderType {
  /// На заказ (выбор модели + размер + мерки)
  MADE_TO_ORDER
  /// Индивидуальный заказ (свой дизайн)
  CUSTOM_DESIGN
  /// Сотрудничество (B2B)
  B2B_PARTNERSHIP
}

enum CustomOrderStatus {
  /// Новая заявка
  NEW
  /// Подтверждена
  CONFIRMED
  /// В производстве
  IN_PRODUCTION
  /// Выполнена
  COMPLETED
  /// Отменена
  CANCELLED
}

enum ImageCategory {
  /// Изображения товаров
  PRODUCT
  /// Аватары пользователей
  AVATAR
  /// Фото-ориентиры кастомных заказов
  REFERENCE
  /// Изображения уведомлений
  NOTIFICATION
}

enum WishlistPriority {
  /// Мечта — когда-нибудь
  DREAM
  /// Хочу — в ближайшее время
  WANT
  /// Может быть — надо подумать
  MAYBE
}

// ==================== Маркетплейс enum'ы ====================

enum SellerStatus {
  /// Ожидает модерации
  PENDING
  /// Активный продавец
  ACTIVE
  /// Приостановлен
  SUSPENDED
  /// Закрыт
  CLOSED
}

enum ApplicationStatus {
  /// Ожидает рассмотрения
  PENDING
  /// На проверке
  UNDER_REVIEW
  /// Одобрена
  APPROVED
  /// Отклонена
  REJECTED
}

enum SubOrderStatus {
  /// Ожидает оплаты
  PENDING_PAYMENT
  /// Оплачен
  PAID
  /// В обработке продавцом
  PROCESSING
  /// Отправлен
  SHIPPED
  /// Доставлен
  DELIVERED
  /// Завершён (protection period прошёл)
  COMPLETED
  /// Запрошен возврат
  RETURN_REQUESTED
  /// Возвращён
  RETURNED
  /// Отменён
  CANCELLED
}

enum PaymentStatus {
  /// Ожидает оплаты
  PENDING
  /// Успешная оплата
  SUCCEEDED
  /// Отменён
  CANCELLED
  /// Возвращён полностью
  REFUNDED
  /// Возвращён частично
  PARTIALLY_REFUNDED
}

enum PayoutStatus {
  /// Запланирована
  SCHEDULED
  /// В обработке
  PROCESSING
  /// Выполнена
  COMPLETED
  /// Ошибка
  FAILED
}

enum SellerTaxSystem {
  /// ИП на УСН
  IP_USN
  /// ИП на ОСНО
  IP_OSNO
  /// ИП на патенте
  IP_PATENT
  /// ООО
  OOO
  /// Самозанятый (НПД, ФЗ-422)
  SELF_EMPLOYED
}

enum LoyaltyLevel {
  /// Бронзовый (начальный)
  BRONZE
  /// Серебряный (от 10 000 ₽ покупок)
  SILVER
  /// Золотой (от 50 000 ₽ покупок)
  GOLD
}

enum LoyaltyTransactionType {
  /// Начисление баллов
  EARN
  /// Списание баллов
  SPEND
  /// Ручная корректировка (админ)
  ADJUSTMENT
}

enum Season {
  /// Весна-Лето
  SPRING_SUMMER
  /// Осень-Зима
  FALL_WINTER
  /// Круизная коллекция
  CRUISE
  /// Вне сезона
  ALL_SEASON
}

enum PayoutRequestStatus {
  /// Создан продавцом, ожидает чека
  DRAFT
  /// Чек приложен, ожидает проверки админа
  PENDING_REVIEW
  /// Одобрен, ожидает выплаты
  APPROVED
  /// Выплата выполнена
  PAID
  /// Отклонён (проблема с чеком)
  REJECTED
}

enum ReturnStatus {
  /// Запрошен
  REQUESTED
  /// Одобрен
  APPROVED
  /// Отклонён
  REJECTED
  /// Товар отправлен назад
  SHIPPED_BACK
  /// Товар получен продавцом
  RECEIVED
  /// Деньги возвращены
  REFUNDED
}

enum ReviewStatus {
  /// Опубликован
  PUBLISHED
  /// Скрыт модератором
  HIDDEN
  /// Удалён
  DELETED
}

enum PromoType {
  /// Процент от суммы
  PERCENTAGE
  /// Фиксированная сумма
  FIXED_AMOUNT
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String                   @unique
  emailVerified           Boolean                  @default(false) // Better Auth: Boolean вместо DateTime
  image                   String?
  role                    UserRole                 @default(USER)

  // Relations
  accounts                Account[]
  sessions                Session[]
  profile                 UserProfile?             // Personal info (gender, birthdate, phone, avatar)
  companyProfile          CompanyProfile?          // B2B company info
  cart                    Cart?                    // User's shopping cart
  orders                  Order[]                  // User's orders
  measurements            UserMeasurements?        // User's body measurements
  wishlist                Wishlist?                // User's wishlist
  addresses               Address[]                // User's delivery addresses
  notificationPreferences NotificationPreferences? // User's notification preferences
  customOrders            CustomOrder[]            // User's custom orders
  pushSubscriptions       PushSubscription[]       // User's push notification subscriptions
  stockNotifications      StockNotification[]      // Подписки на поступление товара
  newsletterSubscription  NewsletterSubscriber?    // Подписка на рассылку
  loyaltyAccount          LoyaltyAccount?          // Программа лояльности

  // Маркетплейс
  seller                  Seller?                  // Профиль магазина (если продавец)
  sellerApplications      SellerApplication[]      // Заявки на становление продавцом
  reviews                 Review[]                 @relation("ReviewAuthor") // Отзывы пользователя

  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  // Access control policies
  @@allow('read', auth() == this || auth().role == ADMIN)
  @@allow('update', auth() == this)
  @@allow('create', true)
  @@allow('all', auth().role == ADMIN)
}

// Personal profile info (separated from User for normalization)
model UserProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Avatar - связь с Image (для локальных изображений)
  avatarId    String?
  avatar      Image?    @relation("ProfileAvatar", fields: [avatarId], references: [id], onDelete: SetNull)

  // OAuth аватары (внешние URL от Google, Yandex и т.д.)
  oauthImage  String?   // Внешний URL аватара от OAuth провайдера

  gender      Gender?   // Gender from OAuth providers
  birthdate   DateTime? // Date of birth
  phoneNumber String?   // Phone number

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Access control: only the user and admins can access profile
  @@allow('all', auth() == user)
  @@allow('read', auth().role == ADMIN)
}

// Company profile for B2B users
model CompanyProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName    String   // Company name
  companyINN     String?  // Tax ID (INN)
  companyAddress String?  // Legal address
  contactPerson  String?  // Contact person name
  companyPhone   String?  // Company phone
  companyEmail   String?  // Company email

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Access control: only the user and admins can access company profile
  @@allow('all', auth() == user)
  @@allow('read', auth().role == ADMIN)
}

model UserMeasurements {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  gender        Gender   // Пол для подбора размера

  // Измерения в сантиметрах
  bust          Int?     // Обхват груди
  waist         Int?     // Обхват талии
  hips          Int?     // Обхват бедер
  height        Int?     // Рост

  preferredSize String?  // Предпочтительный размер (RU)
  notes         String?  // Дополнительные заметки

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Access control: only the user and admins can access measurements
  @@allow('all', auth() == user)
  @@allow('read', auth().role == ADMIN)
}

// ==================== Централизованное хранилище изображений ====================

model Image {
  id            String         @id @default(cuid())
  filename      String        // Имя файла на диске (уникальное)
  path          String         @unique // Полный путь (products/xxx.jpg, avatars/xxx.jpg)
  mimeType      String        // image/jpeg, image/png, image/webp
  size          Int           // Размер в байтах
  width         Int?          // Ширина в пикселях
  height        Int?          // Высота в пикселях

  category      ImageCategory // Категория изображения

  // Метаданные
  uploadedById  String?      // userId кто загрузил
  uploadedAt    DateTime       @default(now())

  // Обратные связи
  variantImages    VariantImage[]
  userProfiles     UserProfile[]  @relation("ProfileAvatar")
  sellerLogos      Seller[]       @relation("SellerLogo")
  collectionCovers Collection[]   @relation("CollectionCover")

  @@index([category])
  @@index([uploadedAt])

  // Access control: все могут читать, только админы могут удалять
  @@allow('read', true)
  @@allow('create', auth() != null) // Авторизованные пользователи могут загружать
  @@allow('delete', auth().role == ADMIN)
}

// Better Auth Account model
model Account {
  id                    String    @id @default(cuid())
  userId                String
  providerId            String    // Было: provider
  accountId             String    // Было: providerAccountId
  accessToken           String?   // Было: access_token
  refreshToken          String?   // Было: refresh_token
  accessTokenExpiresAt  DateTime? // Было: expires_at (Int)
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?   // Было: id_token
  password              String?   // Better Auth: пароль хранится здесь

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])

  // Access control policies - only the user who owns the account can read it
  @@allow('all', auth() == user)
}

// Better Auth Session model
model Session {
  id        String   @id @default(cuid())
  token     String   @unique  // Было: sessionToken
  userId    String
  expiresAt DateTime          // Было: expires
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  // Access control policies - only the user who owns the session can read it
  @@allow('all', auth() == user)
}

// Better Auth Verification model (было VerificationToken)
model Verification {
  id         String   @id @default(cuid())
  identifier String   // email пользователя
  value      String   // Было: token
  expiresAt  DateTime // Было: expires
  type       String   @default("EMAIL_VERIFICATION") // EMAIL_VERIFICATION или PASSWORD_RESET

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])

  // Access control: никто не может читать токены напрямую
  @@deny('all', true)
}

model LoginAttempt {
  id           String    @id @default(cuid())
  identifier   String    // IP адрес или email
  type         String    // 'IP' или 'EMAIL'
  attempts     Int       @default(1)
  blockedUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([identifier, type])

  // Access control: никто не может читать попытки напрямую
  @@deny('all', true)
}

model Category {
  id        String    @id @default(cuid())

  /// @form.title("Название категории")
  /// @form.placeholder("Платья")
  name      String    @unique

  /// @form.title("URL-адрес")
  /// @form.placeholder("dresses")
  slug      String    @unique

  /// @form.title("Порядок сортировки")
  sortOrder Int       @default(0)

  /// @form.exclude
  products  Product[]

  /// @form.exclude
  createdAt DateTime  @default(now())
  /// @form.exclude
  updatedAt DateTime  @updatedAt

  @@allow('read', true)
  @@allow('all', auth().role == ADMIN)
}

model Product {
  id              String           @id @default(cuid())

  /// @form.title("Название товара")
  /// @form.placeholder("Платье вечернее")
  name            String

  /// @form.title("Описание")
  /// @form.fieldType("richText")
  description     String?

  /// @form.title("Пол")
  /// @form.fieldType("radioCard")
  gender          Gender           @default(FEMALE)

  /// @form.title("Порядок сортировки")
  sortOrder       Int              @default(0)

  /// @form.title("Новая коллекция")
  /// @form.fieldType("switch")
  isNewCollection Boolean          @default(true)

  /// @form.title("Категория")
  /// @form.relation({ labelField: "name" })
  categoryId      String?
  /// @form.exclude
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// @form.exclude
  variants        ProductVariant[]
  /// @form.exclude
  customOrders    CustomOrder[]

  // Маркетплейс: продавец-владелец товара (обязательный)
  /// @form.exclude
  sellerId        String
  /// @form.exclude
  seller          Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  // Рейтинг (агрегированный)
  /// @form.exclude
  averageRating   Float?                    // Средний рейтинг (1-5)
  /// @form.exclude
  reviewCount     Int              @default(0) // Количество отзывов
  /// @form.exclude
  reviews         Review[]
  /// @form.exclude
  collectionProducts CollectionProduct[]  // Участие в коллекциях

  /// @form.exclude
  createdAt       DateTime         @default(now())
  /// @form.exclude
  updatedAt       DateTime         @updatedAt

  // Все могут читать, управлять могут ADMIN и владелец-продавец
  @@allow('read', true)
  @@allow('all', auth().role == ADMIN)
  @@allow('create,update', auth().role == SELLER && auth() == seller.user)
}

/// Справочник цветов для фильтрации и отображения
model Color {
  id        String           @id @default(cuid())

  /// @form.title("Название")
  /// @form.placeholder("Чёрный")
  name      String           @unique

  /// @form.title("Slug")
  /// @form.placeholder("black")
  /// @form.pattern("^[a-z0-9-]+$")
  slug      String           @unique

  /// @form.title("HEX код")
  /// @form.placeholder("#000000")
  /// @form.pattern("^#[0-9A-Fa-f]{6}$")
  hex       String

  /// @form.exclude
  variants  ProductVariant[]

  /// @form.exclude
  createdAt DateTime         @default(now())
  /// @form.exclude
  updatedAt DateTime         @updatedAt

  @@allow('read', true)
  @@allow('all', auth().role == ADMIN)
}

model ProductVariant {
  id            String         @id @default(cuid())

  /// @form.exclude
  productId     String
  /// @form.exclude
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// @form.title("Состав")
  /// @form.placeholder("100% хлопок")
  composition   String

  /// @form.title("Цвет (текст)")
  /// @form.placeholder("Чёрный")
  /// @form.description("Устаревшее поле. Используйте colorRef для выбора цвета.")
  color         String

  /// @form.title("Цвет")
  /// @form.exclude
  colorId       String?
  /// @form.title("Цвет")
  colorRef      Color?         @relation(fields: [colorId], references: [id])

  /// @form.exclude
  items         ProductItem[]
  /// @form.exclude
  images        VariantImage[]
  /// @form.exclude
  wishlistItems WishlistItem[]
  /// @form.exclude
  customOrders  CustomOrder[]

  /// @form.exclude
  createdAt     DateTime       @default(now())
  /// @form.exclude
  updatedAt     DateTime       @updatedAt

  @@allow('read', true)
  @@allow('all', auth().role == ADMIN)
}

model ProductItem {
  id             String         @id @default(cuid())
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  sizeId         String
  size           ProductSize    @relation(fields: [sizeId], references: [id])
  price          Decimal        @db.Decimal(15, 2) // Цена с копейками (до 13 цифр до запятой)
  availableCount Int            @default(0)
  /// Предзаказ — товар ещё не в наличии, но доступен для заказа
  isPreOrder     Boolean        @default(false)
  /// Дата начала продаж (для предзаказов)
  availableFrom  DateTime?
  cartItems            CartItem[]           // Items in shopping carts
  customOrders         CustomOrder[]        // Custom orders for this specific item/size
  stockNotifications   StockNotification[]  // Подписки на уведомление о поступлении

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Access control: everyone can read, only admins can manage
  @@allow('read', true)
  @@allow('all', auth().role == ADMIN || auth().role == SELLER)
}

model ProductSize {
  id             String               @id @default(cuid())
  gender         Gender               @default(FEMALE)
  international  String
  ru             String
  de             String
  it             String
  fr             String
  uk             String
  us             String
  jeansFrom      String
  jeansTo        String

  // Measurements in centimeters (Измерения в сантиметрах)
  bustMin        Int                  // Обхват груди от
  bustMax        Int                  // Обхват груди до
  waistMin       Int                  // Обхват талии от
  waistMax       Int                  // Обхват талии до
  hipsMin        Int                  // Обхват бедер от
  hipsMax        Int                  // Обхват бедер до

  // Custom sort order for display (Порядок сортировки для отображения)
  sortOrder      Int                  @default(0)

  items          ProductItem[]
  wholesaleItems WholesaleOrderItem[] // Wholesale order items

  @@unique([ru, gender])

  // Access control: everyone can read, only admins can manage
  @@allow('read', true)
  @@allow('all', auth().role == ADMIN)
}

model VariantImage {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // Связь с централизованным хранилищем изображений
  imageId   String
  image     Image          @relation(fields: [imageId], references: [id], onDelete: Cascade)

  alt       String?        // Альтернативный текст для доступности
  order     Int            @default(0) // Порядок отображения изображений

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // Access control: everyone can read, only admins can manage
  @@allow('read', true)
  @@allow('all', auth().role == ADMIN)
}

model TestModel {
  id        String   @id @default(cuid())
  text      String   @unique
  gender    Gender

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Access control: admins have full access, everyone else can read
  @@allow('read', true)
  @@allow('all', auth().role == ADMIN)
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Access control: only the cart owner can access their cart
  @@allow('all', auth() == user)
  @@allow('read', auth().role == ADMIN)
}

model CartItem {
  id            String      @id @default(cuid())
  cartId        String
  cart          Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productItemId String
  productItem   ProductItem @relation(fields: [productItemId], references: [id], onDelete: Cascade)
  quantity      Int         @default(1)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Prevent duplicate items in cart - one size per cart
  @@unique([cartId, productItemId])

  // Access control: only the cart owner can access cart items
  @@allow('all', auth() == cart.user)
  @@allow('read', auth().role == ADMIN)
}

model Order {
  id                 String      @id @default(cuid())
  orderNumber        String      @unique // Уникальный номер заказа для пользователя
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             OrderStatus @default(NEW)
  totalAmount        Decimal     @db.Decimal(15, 2) // Общая сумма заказа (до 13 цифр до запятой)

  // Информация о покупателе
  customerName       String
  customerPhone      String
  customerEmail      String?

  // Адрес доставки (сохраняем полные данные от DaData)
  deliveryAddress    String      // Полный адрес
  deliveryCity       String?     // Город
  deliveryRegion     String?     // Регион
  deliveryPostalCode String?    // Почтовый индекс
  deliveryCountry    String?     @default("Россия") // Страна

  // Промокод и скидка
  promoId            String?
  promo              Promo?      @relation(fields: [promoId], references: [id], onDelete: SetNull)
  discountAmount     Decimal     @db.Decimal(15, 2) @default(0) // Сумма скидки по промокоду

  // Программа лояльности
  loyaltyPointsUsed   Int        @default(0) // Сколько баллов списано (1 балл = 1 ₽)
  loyaltyPointsEarned Int        @default(0) // Сколько баллов начислено за заказ

  // Дополнительная информация
  notes              String?     // Комментарий к заказу от покупателя
  adminNotes         String?     // Заметки администратора (внутренние)
  items              OrderItem[]

  // Маркетплейс
  subOrders          SubOrder[]  // Подзаказы по продавцам
  payments           Payment[]   // Платежи

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  // Access control: only the order owner and admins can access orders
  @@allow('read', auth() == user || auth().role == ADMIN)
  @@allow('create', auth() == user)
  @@allow('update', auth().role == ADMIN) // Only admins can update order status
  @@allow('delete', auth().role == ADMIN)
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productItemId String  // Сохраняем ID для связи с товаром
  quantity      Int      @default(1)
  price         Decimal  @db.Decimal(15, 2) // Цена на момент заказа (до 13 цифр до запятой)

  // Сохраняем информацию о товаре на момент заказа (для истории)
  productName   String  // Название продукта
  variantColor  String  // Цвет варианта
  sizeName      String  // Размер (RU)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Access control: only the order owner and admins can access order items
  @@allow('all', auth() == order.user || auth().role == ADMIN)
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // Access control: only the wishlist owner and admins can access
  @@allow('all', auth() == user)
  @@allow('read', auth().role == ADMIN)
}

model WishlistItem {
  id               String           @id @default(cuid())
  wishlistId       String
  wishlist         Wishlist         @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant   @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  // Оффлайн UX поля
  note             String?          // Заметка пользователя: "Хочу к свадьбе Маши"
  priority         WishlistPriority @default(WANT) // Приоритет: мечта, хочу, может быть
  tags             String[]         // Теги: ["лето", "офис", "особый случай"]

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([wishlistId, productVariantId])

  // Access control: only the wishlist owner and admins can access
  @@allow('all', auth() == wishlist.user)
  @@allow('read', auth().role == ADMIN)
}

model Address {
  id            String   @id @default(cuid())

  /// @form.exclude
  userId        String
  /// @form.exclude
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// @form.title("Название")
  /// @form.placeholder("Дом, Работа...")
  label         String

  /// @form.title("Полный адрес")
  fullAddress   String

  /// @form.title("Индекс")
  postalCode    String?

  /// @form.title("Страна")
  country       String   @default("Россия")

  /// @form.title("Регион")
  region        String?

  /// @form.title("Город")
  city          String?

  /// @form.title("Улица")
  street        String?

  /// @form.title("Дом")
  house         String?

  /// @form.title("Корпус")
  block         String?

  /// @form.title("Подъезд")
  entrance      String?

  /// @form.title("Этаж")
  floor         String?

  /// @form.title("Квартира")
  flat          String?

  /// @form.title("Получатель")
  recipientName String

  /// @form.title("Телефон")
  /// @form.fieldType("phone")
  phone         String

  /// @form.title("По умолчанию")
  /// @form.fieldType("switch")
  isDefault     Boolean  @default(false)

  /// @form.exclude
  createdAt     DateTime @default(now())
  /// @form.exclude
  updatedAt     DateTime @updatedAt

  @@allow('all', auth() == user)
  @@allow('read', auth().role == ADMIN)
}

model NotificationPreferences {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailOrderStatus Boolean  @default(true)  // Email при изменении статуса заказа
  emailPromotions  Boolean  @default(true)  // Email рекламных предложений
  emailNewsletter  Boolean  @default(false) // Email рассылка новостей
  smsOrderStatus   Boolean  @default(false) // SMS при изменении статуса

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Access control: only the user can manage their preferences
  @@allow('all', auth() == user)
  @@allow('read', auth().role == ADMIN)
}

model CustomOrder {
  id                String               @id @default(cuid())
  orderNumber       String               @unique // Уникальный номер заказа
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              CustomOrderType
  status            CustomOrderStatus    @default(NEW)

  // Связь с продуктом (опциональна для CUSTOM_DESIGN)
  productId         String?
  product           Product?             @relation(fields: [productId], references: [id])
  variantId         String?
  variant           ProductVariant?      @relation(fields: [variantId], references: [id])

  // Для MADE_TO_ORDER: какой размер нужен
  productItemId     String?
  productItem       ProductItem?         @relation(fields: [productItemId], references: [id])
  quantity          Int?               // Количество

  // Для MADE_TO_ORDER: индивидуальные мерки в см
  customBust        Int?               // Обхват груди
  customWaist       Int?               // Обхват талии
  customHips        Int?               // Обхват бедер
  customHeight      Int?               // Рост
  customDetails     String?            // Дополнительные детали/пожелания по кастомизации

  // Для CUSTOM_DESIGN: индивидуальный заказ без модели
  // Массив ID изображений из централизованного хранилища
  referenceImageIds String[]         // ID изображений из таблицы Image

  designDescription String?          // Описание желаемого изделия

  // Для B2B_PARTNERSHIP: реквизиты компании
  companyName       String?            // Название организации
  companyINN        String?            // ИНН
  companyAddress    String?            // Юридический адрес
  preferredColor    String?            // Предпочитаемый цвет
  wholesaleItems    WholesaleOrderItem[] // Количество по размерам

  // Контактные данные (могут отличаться от профиля)
  customerName      String
  customerPhone     String
  customerEmail     String?

  // Дополнительная информация
  notes             String?            // Комментарий/пожелания
  adminNotes        String?            // Заметки администратора

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  // Access control: владелец заказа и админы
  @@allow('read', auth() == user || auth().role == ADMIN)
  @@allow('create', auth() == user)
  @@allow('update', auth().role == ADMIN) // Только админы могут менять статус
  @@allow('delete', auth().role == ADMIN)
}

model WholesaleOrderItem {
  id        String      @id @default(cuid())
  orderId   String
  order     CustomOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sizeId    String
  size      ProductSize @relation(fields: [sizeId], references: [id])
  quantity  Int          // Количество единиц этого размера

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Access control: через order
  @@allow('all', auth() == order.user || auth().role == ADMIN)
}

// ==================== Маркетплейс: Продавцы ====================

/// Профиль магазина продавца
model Seller {
  id                String           @id @default(cuid())

  // Владелец
  userId            String           @unique
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Данные магазина
  shopName          String           @unique  // Название магазина
  slug              String           @unique  // URL-slug (/shop/[slug])
  description       String?                   // Описание магазина
  logoId            String?
  logo              Image?           @relation("SellerLogo", fields: [logoId], references: [id], onDelete: SetNull)

  // Юридические данные
  taxSystem         SellerTaxSystem?          // Система налогообложения
  inn               String?                   // ИНН
  legalName         String?                   // Юридическое название
  legalAddress      String?                   // Юр. адрес
  ogrn              String?                   // ОГРН/ОГРНИП

  // Банковские реквизиты
  bankAccount       String?                   // Расчётный счёт
  bik               String?                   // БИК
  bankName          String?                   // Название банка

  // ЮKassa
  yookassaAccountId String?                   // ID в ЮKassa (для сплитования)

  // Комиссия
  commissionRate    Decimal          @default(0.2000) @db.Decimal(5, 4) // 0.2000 = 20%

  // Статус
  status            SellerStatus     @default(PENDING)

  // Контакты
  contactEmail      String?
  contactPhone      String?
  telegramChatId    String?                   // Для Telegram уведомлений

  // Обратные связи
  products          Product[]
  subOrders         SubOrder[]
  payouts           Payout[]
  payoutRequests    PayoutRequest[]
  balance           SellerBalance?
  promos            Promo[]

  // Рейтинг (агрегированный по всем товарам)
  averageRating     Float?                   // Средний рейтинг продавца
  reviewCount       Int              @default(0) // Количество отзывов

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Access control: все могут читать публичную инфу, владелец и админ — полный доступ
  @@allow('read', true)
  @@allow('update', auth() == user || auth().role == ADMIN)
  @@allow('create,delete', auth().role == ADMIN)
}

/// Заявка на становление продавцом
model SellerApplication {
  id             String            @id @default(cuid())

  // Заявитель
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Статус
  status         ApplicationStatus @default(PENDING)

  // Данные заявки
  shopName       String                      // Желаемое название магазина
  description    String?                     // О магазине
  inn            String?                     // ИНН
  legalName      String?                     // Юр. название
  ogrn           String?                     // ОГРН/ОГРНИП
  contactEmail   String                      // Контактный email
  contactPhone   String                      // Контактный телефон
  portfolioLinks String?                     // Ссылки на соцсети/портфолио

  // Рассмотрение
  reviewedBy     String?                     // ID админа-рецензента
  reviewNote     String?                     // Комментарий к рассмотрению
  reviewedAt     DateTime?                   // Дата рассмотрения

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Access control: заявитель и админ видят, USER может создать, ADMIN обновляет
  @@allow('read', auth() == user || auth().role == ADMIN)
  @@allow('create', auth() != null)
  @@allow('update', auth().role == ADMIN)
  @@allow('delete', auth().role == ADMIN)
}

// ==================== Маркетплейс: Подзаказы и платежи ====================

/// Подзаказ продавца (часть Order, сгруппированная по продавцу)
model SubOrder {
  id               String         @id @default(cuid())

  subOrderNumber   String         @unique  // SUB-YYYYMMDD-XXXXX

  // Связи
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId         String
  seller           Seller         @relation(fields: [sellerId], references: [id])

  // Статус
  status           SubOrderStatus @default(PENDING_PAYMENT)

  // Финансы (snapshot на момент оплаты)
  subtotal         Decimal        @db.Decimal(15, 2) // Сумма товаров
  commissionRate   Decimal        @db.Decimal(5, 4)  // Комиссия (snapshot)
  commissionAmount Decimal        @db.Decimal(15, 2) // Сумма комиссии
  sellerAmount     Decimal        @db.Decimal(15, 2) // К выплате (subtotal - commission)

  // Доставка
  trackingNumber   String?                            // Трек-номер
  shippedAt        DateTime?                          // Дата отправки
  deliveredAt      DateTime?                          // Дата доставки
  protectionEndsAt DateTime?                          // deliveredAt + 7 дней

  // Обратные связи
  items            SubOrderItem[]
  payouts          Payout[]
  returns          Return[]

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([orderId])
  @@index([sellerId])
  @@index([status])

  // Access control: покупатель, продавец, админ
  @@allow('read', auth() == order.user || auth() == seller.user || auth().role == ADMIN)
  @@allow('update', auth() == seller.user || auth().role == ADMIN)
  @@allow('create,delete', auth().role == ADMIN)
}

/// Позиция подзаказа (snapshot данных товара)
model SubOrderItem {
  id             String   @id @default(cuid())

  subOrderId     String
  subOrder       SubOrder @relation(fields: [subOrderId], references: [id], onDelete: Cascade)

  productItemId  String                      // SKU (ProductItem)
  quantity       Int                          // Количество
  price          Decimal  @db.Decimal(15, 2) // Snapshot цены

  // Snapshot данных товара (не меняются при изменении товара)
  productName    String                      // Название
  variantColor   String                      // Цвет
  sizeName       String                      // Размер

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Access control: через subOrder
  @@allow('all', auth() == subOrder.order.user || auth() == subOrder.seller.user || auth().role == ADMIN)
}

/// Платёж через ЮKassa
model Payment {
  id              String        @id @default(cuid())

  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status          PaymentStatus @default(PENDING)

  // ЮKassa данные
  yookassaId      String?       @unique  // ID платежа в ЮKassa
  yookassaStatus  String?                // Статус в ЮKassa
  confirmationUrl String?                // URL для оплаты

  // Сумма
  amount          Decimal       @db.Decimal(15, 2)
  currency        String        @default("RUB")

  paidAt          DateTime?              // Дата оплаты
  metadata        Json?                  // Дополнительные данные

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderId])

  // Access control: покупатель и админ
  @@allow('read', auth() == order.user || auth().role == ADMIN)
  @@allow('create,update,delete', auth().role == ADMIN)
}

// ==================== Маркетплейс: Финансы ====================

/// Выплата продавцу (фактический перевод денег)
model Payout {
  id               String      @id @default(cuid())

  sellerId         String
  seller           Seller      @relation(fields: [sellerId], references: [id])

  subOrderId       String?
  subOrder         SubOrder?   @relation(fields: [subOrderId], references: [id])

  // Связь с запросом на выплату
  payoutRequestId  String?
  payoutRequest    PayoutRequest? @relation(fields: [payoutRequestId], references: [id])

  status           PayoutStatus @default(SCHEDULED)

  // Суммы
  amount           Decimal     @db.Decimal(15, 2)  // Общая сумма
  reserveAmount    Decimal     @db.Decimal(15, 2)  // Удержано в резерв
  netAmount        Decimal     @db.Decimal(15, 2)  // Фактическая выплата

  // Обработка
  processedAt      DateTime?                        // Когда обработана
  processedBy      String?                          // ID админа, выполнившего выплату
  transactionId    String?                           // ID банковской транзакции

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([sellerId])
  @@index([status])

  // Access control: продавец и админ
  @@allow('read', auth() == seller.user || auth().role == ADMIN)
  @@allow('create,update,delete', auth().role == ADMIN)
}

/// Запрос продавца на выплату (с прикладыванием чека для самозанятых)
model PayoutRequest {
  id               String             @id @default(cuid())

  sellerId         String
  seller           Seller             @relation(fields: [sellerId], references: [id])

  status           PayoutRequestStatus @default(DRAFT)

  // Запрошенная сумма
  requestedAmount  Decimal            @db.Decimal(15, 2)  // Сколько продавец просит

  // Чек (обязателен для самозанятых, опционален для ИП/ООО)
  receiptImageIds  String[]                                // ID фотографий чека из "Мой налог"
  receiptNumber    String?                                 // Номер чека
  receiptDate      DateTime?                               // Дата чека
  receiptAmount    Decimal?           @db.Decimal(15, 2)   // Сумма в чеке

  // Комментарий продавца
  sellerNote       String?

  // Рассмотрение админом
  reviewedBy       String?                                 // ID админа
  reviewNote       String?                                 // Комментарий админа
  reviewedAt       DateTime?                               // Дата рассмотрения

  // Связь с фактической выплатой
  payouts          Payout[]

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([sellerId])
  @@index([status])

  // Access control: продавец создаёт и видит свои, админ управляет
  @@allow('read', auth() == seller.user || auth().role == ADMIN)
  @@allow('create', auth() == seller.user)
  @@allow('update', auth() == seller.user || auth().role == ADMIN)
  @@allow('delete', auth().role == ADMIN)
}

/// Баланс продавца (агрегированные данные)
model SellerBalance {
  id              String  @id @default(cuid())

  sellerId        String  @unique
  seller          Seller  @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  availableAmount Decimal @default(0) @db.Decimal(10, 2)  // Доступно к выплате
  pendingAmount   Decimal @default(0) @db.Decimal(10, 2)  // Ожидает подтверждения
  reservedAmount  Decimal @default(0) @db.Decimal(10, 2)  // Заморожено на возвраты

  updatedAt       DateTime @updatedAt

  // Access control: продавец и админ
  @@allow('read', auth() == seller.user || auth().role == ADMIN)
  @@allow('create,update,delete', auth().role == ADMIN)
}

// ==================== Маркетплейс: Возвраты ====================

/// Возврат товара
model Return {
  id           String       @id @default(cuid())

  subOrderId   String
  subOrder     SubOrder     @relation(fields: [subOrderId], references: [id], onDelete: Cascade)

  status       ReturnStatus @default(REQUESTED)

  // Данные возврата
  reason       String                            // Причина возврата
  description  String?                           // Описание проблемы
  images       String[]                          // ID фотографий

  // Рассмотрение
  reviewedBy   String?                           // ID админа
  reviewNote   String?                           // Комментарий
  reviewedAt   DateTime?                         // Дата рассмотрения

  // Финансы
  refundAmount Decimal?     @db.Decimal(15, 2)  // Сумма возврата
  refundedAt   DateTime?                         // Дата возврата денег

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([subOrderId])
  @@index([status])

  // Access control: покупатель, продавец, админ
  @@allow('read', auth() == subOrder.order.user || auth() == subOrder.seller.user || auth().role == ADMIN)
  @@allow('create', auth() == subOrder.order.user)
  @@allow('update', auth().role == ADMIN)
  @@allow('delete', auth().role == ADMIN)
}

// ==================== Отзывы и рейтинги ====================

/// Отзыв покупателя на товар
model Review {
  id             String       @id @default(cuid())

  // Автор отзыва
  authorId       String
  author         User         @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  // Товар
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Содержимое
  rating         Int                          // Рейтинг 1-5
  text           String?                      // Текст отзыва
  images         String[]                     // URL фотографий (до 3)

  // Статус
  status         ReviewStatus @default(PUBLISHED)

  // Модерация (скрытие админом)
  hiddenById     String?                      // ID админа, скрывшего отзыв
  hiddenReason   String?                      // Причина скрытия
  hiddenAt       DateTime?                    // Дата скрытия

  // Ответ продавца
  response       String?                      // Текст ответа
  respondedAt    DateTime?                    // Дата ответа
  respondedById  String?                      // ID продавца

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Один отзыв на товар от покупателя
  @@unique([authorId, productId])
  @@index([productId])
  @@index([status])

  // Access control
  @@allow('read', status == PUBLISHED)
  @@allow('read', auth() == author)
  @@allow('read', auth() == product.seller.user)
  @@allow('read', auth().role == ADMIN)
  @@allow('create', auth() != null)
  @@allow('update', auth() == author && status == PUBLISHED)
  @@allow('update', auth() == product.seller.user)
  @@allow('all', auth().role == ADMIN)
}

// ==================== Push Notifications ====================

enum NotificationType {
  /// Уведомление о новых товарах
  NEW_PRODUCT
  /// Статус заказа
  ORDER_STATUS
  /// Акции и скидки
  PROMOTION
  /// Напоминание о брошенной корзине
  CART_REMINDER
}

model PushSubscription {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Web Push subscription data
  endpoint     String   @unique // Push service URL
  p256dh       String   // Public key for encryption
  auth         String   // Auth secret

  // Device info
  userAgent    String?  // User agent string
  deviceType   String?  // desktop, mobile, tablet

  // Subscription preferences (can override user preferences for this device)
  newProducts  Boolean  @default(true)
  orderStatus  Boolean  @default(true)
  promotions   Boolean  @default(true)
  cartReminder Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Access control: user can manage their subscriptions, admins can read all
  @@allow('all', auth() == user)
  @@allow('create', true) // Allow anonymous subscriptions
  @@allow('read', auth().role == ADMIN)
}

model PushNotification {
  id           String           @id @default(cuid())
  type         NotificationType
  title        String
  body         String
  icon         String?          // URL иконки
  image        String?          // URL большого изображения
  url          String?          // URL для перехода при клике
  data         Json?            // Дополнительные данные (orderId, productId и т.д.)

  // Targeting
  targetUserId String?          // Конкретный пользователь (для ORDER_STATUS)
  targetAll    Boolean          @default(false) // Всем подписчикам

  // Stats
  sentCount    Int              @default(0)  // Сколько отправлено
  clickCount   Int              @default(0)  // Сколько кликов

  // Scheduling
  scheduledAt  DateTime?        // Отложенная отправка
  sentAt       DateTime?        // Когда фактически отправлено

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Access control: only admins can manage notifications
  @@allow('all', auth().role == ADMIN)
}

/// Подписка на уведомление о поступлении товара
model StockNotification {
  id            String      @id @default(cuid())

  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  productItemId String
  productItem   ProductItem @relation(fields: [productItemId], references: [id], onDelete: Cascade)

  email         String      // Email для уведомления
  notified      Boolean     @default(false)
  notifiedAt    DateTime?

  createdAt     DateTime    @default(now())

  @@unique([userId, productItemId]) // Одна подписка на SKU на пользователя
  @@index([productItemId, notified])

  // Access control: пользователь управляет своими подписками
  @@allow('read,create,delete', auth() == user)
  @@allow('read,update,delete', auth().role == ADMIN)
}

/// Промокод со скидкой (процент или фиксированная сумма)
model Promo {
  id           String    @id @default(cuid())
  code         String    @unique  // "WELCOME10", "SPRING2026"
  type         PromoType @default(PERCENTAGE)
  discount     Decimal   @db.Decimal(15, 2) // % или рубли

  description  String?   // Описание для админки

  // Условия действия
  isActive     Boolean   @default(true)
  dateFrom     DateTime  @default(now())
  dateTo       DateTime                      // Дата окончания

  // Минимальная сумма заказа для применения
  minAmount    Decimal?  @db.Decimal(15, 2)

  // Лимиты использования
  maxUsages    Int?                           // null = неограниченно
  usageCount   Int       @default(0)          // Текущее количество использований
  perCustomer  Int       @default(1)          // Максимум использований на пользователя

  // Маркетплейс: промокод конкретного продавца (null = для всего магазина)
  sellerId     String?
  seller       Seller?   @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  orders       Order[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([code])
  @@index([dateTo])

  // Access control: активные промокоды читают все, управление — админ
  @@allow('read', isActive || auth().role == ADMIN)
  @@allow('create,update,delete', auth().role == ADMIN)
}

// ============================================================
// Подписка на рассылку (для неавторизованных и авторизованных)
// ============================================================
model NewsletterSubscriber {
  id            String    @id @default(cuid())
  email         String    @unique
  /// Токен для отписки по ссылке
  unsubToken    String    @unique @default(cuid())
  isActive      Boolean   @default(true)
  /// Привязка к пользователю (опционально)
  userId        String?   @unique
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  unsubscribedAt DateTime?

  @@index([email])

  // Публичное создание (подписка), админ управляет
  @@allow('create', true)
  @@allow('read,update,delete', auth().role == ADMIN)
}

// ============================================================
// Программа лояльности
// ============================================================
model LoyaltyAccount {
  id            String              @id @default(cuid())
  userId        String              @unique
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Текущий баланс баллов (1 балл = 1 ₽ скидки)
  balance       Int                 @default(0)
  /// Всего заработано баллов (определяет уровень)
  totalEarned   Int                 @default(0)
  /// Уровень лояльности
  level         LoyaltyLevel        @default(BRONZE)
  transactions  LoyaltyTransaction[]

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([userId])

  // Пользователь видит свой аккаунт, админ — все
  @@allow('read', auth() == user || auth().role == ADMIN)
  @@allow('create', auth() != null)
  @@allow('update,delete', auth().role == ADMIN)
}

model LoyaltyTransaction {
  id          String                  @id @default(cuid())
  accountId   String
  account     LoyaltyAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Тип операции: начисление, списание, корректировка
  type        LoyaltyTransactionType
  /// Количество баллов (положительное для начисления, отрицательное для списания)
  amount      Int
  /// Баланс после операции
  balanceAfter Int
  /// Описание операции
  description String
  /// Связь с заказом (если баллы начислены/списаны по заказу)
  orderId     String?

  createdAt   DateTime                @default(now())

  @@index([accountId])
  @@index([orderId])

  // Пользователь видит свои транзакции, админ — все
  @@allow('read', auth().id == account.userId || auth().role == ADMIN)
  @@allow('create,update,delete', auth().role == ADMIN)
}

// ============================================================
// Lookbook / Коллекции
// ============================================================
model Collection {
  id          String              @id @default(cuid())
  /// Название коллекции (например "Весна-Лето 2026")
  name        String
  /// URL-slug для маршрутизации
  slug        String              @unique
  /// Описание коллекции
  description String?
  /// Обложка коллекции (ID изображения)
  coverImageId String?
  coverImage  Image?              @relation("CollectionCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  /// Сезон
  season      Season              @default(ALL_SEASON)
  /// Год (например 2026)
  year        Int?
  /// Опубликована
  isPublished Boolean             @default(false)
  /// Порядок сортировки
  sortOrder   Int                 @default(0)

  products    CollectionProduct[]

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([slug])
  @@index([season, year])

  // Публичные коллекции видны всем, админ управляет
  @@allow('read', isPublished || auth().role == ADMIN)
  @@allow('create,update,delete', auth().role == ADMIN)
}

model CollectionProduct {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Порядок отображения товара в коллекции
  sortOrder    Int        @default(0)

  createdAt    DateTime   @default(now())

  @@unique([collectionId, productId])
  @@index([collectionId])

  @@allow('read', true)
  @@allow('create,update,delete', auth().role == ADMIN)
}

# Domain Configuration (for Nginx Proxy Manager)
# Все домены через запятую: основной и алиасы
DOMAIN=shop.rosstil.ru,www.shop.rosstil.ru

# Database
DB_PASSWORD=your_secure_db_password

# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth
# Get from: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Yandex OAuth
# Get from: https://oauth.yandex.ru/
AUTH_YANDEX_ID=your-yandex-client-id
AUTH_YANDEX_SECRET=your-yandex-client-secret

# Telegram Bot (for auth and notifications)
AUTH_TELEGRAM_BOT_ID=your-telegram-bot-id
AUTH_TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Admin chat ID for order notifications
TELEGRAM_ADMIN_CHAT_ID=

# VK OAuth
AUTH_VK_ID=your-vk-app-id
AUTH_VK_SECRET=your-vk-app-secret

# Email (Nodemailer)
EMAIL_SERVER_USER=your-email@example.com
EMAIL_SERVER_PASSWORD=your-email-password
EMAIL_FROM=your-email@example.com

# DaData API
NEXT_PUBLIC_DADATA_API_KEY=your-dadata-api-key

# Yandex Metrika
NEXT_PUBLIC_YM_COUNTER_ID=

# Web Push (VAPID keys)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# ЮKassa (платежи)
# Get from: https://yookassa.ru/my/shop-settings
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Cron secret (для защиты cron endpoints)
CRON_SECRET=

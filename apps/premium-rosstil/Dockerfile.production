# Dockerfile.production - для уже собранных приложений
# Используется когда сборка выполнена на сервере с nx build affected
# Build context: workspace root (C:\web\lena)

FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# Ограничение памяти Node.js — 512MB heap (защита от OOM)
ENV NODE_OPTIONS="--max-old-space-size=512"

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Копируем уже собранный standalone output
# Standalone включает в себя все необходимые node_modules
COPY --chown=nextjs:nodejs apps/premium-rosstil/.next/standalone ./

# Копируем статику и public (не включаются в standalone автоматически)
COPY --chown=nextjs:nodejs apps/premium-rosstil/.next/static ./apps/premium-rosstil/.next/static
COPY --chown=nextjs:nodejs apps/premium-rosstil/public ./apps/premium-rosstil/public

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/premium-rosstil/server.js"]

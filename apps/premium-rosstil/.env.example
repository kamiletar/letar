# Database
DATABASE_URL="postgresql://username:password@localhost:5432/lena_premium?schema=public"
# Логирование SQL запросов (true/false, по умолчанию false)
PRISMA_LOG_QUERIES="false"

# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
# Get from: https://console.cloud.google.com/
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Yandex OAuth
# Get from: https://oauth.yandex.ru/
AUTH_YANDEX_ID="your-yandex-client-id"
AUTH_YANDEX_SECRET="your-yandex-client-secret"

# Yandex Metrika
NEXT_PUBLIC_YM_COUNTER_ID=""

# Web Push (VAPID keys)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:your-email@example.com"

# Email notifications
# SMTP settings for Yandex Mail (production)
EMAIL_SERVER_USER="your-email@yandex.ru"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="your-email@yandex.ru"
# Admin email for order notifications
ADMIN_EMAIL="elena@rosstil.ru"

# Mailhog (development/testing)
# Set to "true" to use Mailhog instead of Yandex SMTP
# Run: docker compose -f docker-compose.dev.yml up -d
# Web UI: http://localhost:8025
EMAIL_USE_MAILHOG="false"
EMAIL_SMTP_HOST="localhost"
EMAIL_SMTP_PORT="1025"

# Telegram Bot (for auth and notifications)
# Create bot via @BotFather, get token
AUTH_TELEGRAM_BOT_ID="your-bot-id"
AUTH_TELEGRAM_BOT_TOKEN="your-bot-token"
# Admin chat ID for order notifications (get via @userinfobot or forwarding message to @getidsbot)
TELEGRAM_ADMIN_CHAT_ID=""

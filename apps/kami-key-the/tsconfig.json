{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "paths": {
      "@/*": ["./src/*"],
      "@letar/electron-storage": ["../../libs/electron-storage/src/index.ts"]
    },
    "types": ["node"],
    "lib": ["ES2022"],
    "noUncheckedSideEffectImports": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts", "main/**/*.ts", "shared/**/*.ts", "../../libs/electron-storage/src/**/*.ts"],
  "exclude": ["node_modules", "dist", "app", "renderer", "../../libs/**/*.spec.ts"]
}

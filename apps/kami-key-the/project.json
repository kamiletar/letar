{
  "name": "kami-key-the",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": [
    "@letar/electron-storage"
  ],
  "sourceRoot": "apps/kami-key-the/src",
  "projectType": "application",
  "tags": [
    "type:app",
    "scope:infra",
    "owner:letar"
  ],
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Format files with dprint",
        "technologies": [
          "dprint"
        ]
      },
      "options": {
        "command": "dprint fmt",
        "cwd": "apps/kami-key-the"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/dev.js",
        "cwd": "apps/kami-key-the"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx webpack --config main/webpack.config.js",
          "npx vite build --config renderer/vite.config.ts"
        ],
        "cwd": "apps/kami-key-the",
        "parallel": false
      }
    },
    "build:win": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx webpack --config main/webpack.config.js --mode production",
          "npx vite build --config renderer/vite.config.ts",
          "npx electron-builder --win --publish never"
        ],
        "cwd": "apps/kami-key-the",
        "parallel": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{projectRoot}/eslint.config.mjs",
        {
          "externalDependencies": [
            "eslint"
          ]
        }
      ],
      "options": {
        "cwd": "apps/kami-key-the",
        "command": "eslint --no-error-on-unmatched-pattern main/**/*.ts renderer/src/**/*.{ts,tsx} shared/**/*.ts src/**/*.ts"
      }
    },
    "typecheck:tsgo": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsgo --noEmit -p apps/kami-key-the/tsconfig.json",
        "cwd": "."
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/kami-key-the/tsconfig.json",
        "cwd": "."
      }
    }
  }
}

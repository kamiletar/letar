{
  "name": "svoichuzhie-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/svoichuzhie-e2e/src",
  "tags": ["type:e2e", "scope:svoichuzhie", "owner:letar"],
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dprint fmt",
        "cwd": "apps/svoichuzhie-e2e"
      },
      "cache": false,
      "metadata": {
        "description": "Format files with dprint",
        "technologies": ["dprint"]
      }
    },
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "outputs": ["{workspaceRoot}/playwright-report/{projectName}"],
      "options": {
        "config": "apps/svoichuzhie-e2e/playwright.config.ts",
        "skipInstall": true
      }
    }
  }
}

{
  "name": "form-develop-app-shadcn-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": [
    "form-develop-app-shadcn",
    "form-develop-app-shadcn"
  ],
  "projectType": "application",
  "sourceRoot": "apps/form-develop-app-shadcn-e2e/src",
  "tags": [
    "type:e2e",
    "scope:form-develop-app-shadcn",
    "owner:letar"
  ],
  "targets": {
    "e2e": {
      "outputs": [
        "{workspaceRoot}/playwright-report/{projectName}"
      ]
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Format files with dprint (~30x faster than Prettier)",
        "technologies": [
          "dprint"
        ]
      },
      "options": {
        "command": "bunx dprint fmt \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "cwd": "apps/form-develop-app-shadcn-e2e"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/dprint.json"
      ],
      "metadata": {
        "description": "Check file formatting with dprint",
        "technologies": [
          "dprint"
        ]
      },
      "options": {
        "command": "bunx dprint check \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "cwd": "apps/form-develop-app-shadcn-e2e"
      }
    }
  }
}

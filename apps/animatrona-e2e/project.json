{
  "name": "animatrona-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/animatrona-e2e/src",
  "tags": [
    "owner:letar"
  ],
  "implicitDependencies": [
    "animatrona"
  ],
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Format files with dprint",
        "technologies": [
          "dprint"
        ]
      },
      "options": {
        "command": "dprint fmt",
        "cwd": "apps/animatrona-e2e"
      }
    },
    "e2e": {
      "outputs": [
        "{workspaceRoot}/playwright-report/{projectName}"
      ]
    },
    "fixtures:create": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx apps/animatrona-e2e/fixtures/create-test-videos.ts",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}

{
  "name": "animatrona-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/animatrona-e2e/src",
  "implicitDependencies": ["animatrona"],
  "targets": {
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "outputs": ["{workspaceRoot}/playwright-report/{projectName}"],
      "options": {
        "config": "apps/animatrona-e2e/playwright.config.ts"
      }
    },
    "fixtures:create": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx apps/animatrona-e2e/fixtures/create-test-videos.ts",
        "cwd": "{workspaceRoot}"
      }
    }
  },
  "tags": ["owner:letar"]
}

FROM node:24-slim AS tz

FROM nginx:alpine

# zoneinfo для Alpine — не `apk add tzdata`, причина: .claude/docs/docker-prune-cold-layer-network-flake.md
COPY --from=tz /usr/share/zoneinfo /usr/share/zoneinfo
ENV TZ=Europe/Moscow

# Копируем статический экспорт Next.js
COPY apps/pravda/out /usr/share/nginx/html

# Копируем конфигурацию nginx
COPY apps/pravda/nginx.conf /etc/nginx/conf.d/default.conf

# Исправляем права доступа для nginx
RUN chmod -R o+rX /usr/share/nginx/html/

EXPOSE 3007

CMD ["nginx", "-g", "daemon off;"]

{
  "name": "synth",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": [
    "@letar/chakra-provider",
    "@letar/analytics",
    "@letar/ui",
    "@letar/seo"
  ],
  "sourceRoot": "apps/synth/src",
  "projectType": "application",
  "tags": [
    "type:app",
    "scope:synth",
    "owner:letar"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/apps/synth/.next"
      ],
      "metadata": {
        "description": "Build production bundle",
        "technologies": [
          "next"
        ]
      },
      "options": {
        "command": "next build",
        "cwd": "apps/synth"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Start development server on port 3022",
        "technologies": [
          "next"
        ]
      },
      "options": {
        "command": "next dev -p 3022",
        "cwd": "apps/synth"
      }
    },
    "mcp:serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Run synth MCP server via stdio (ментор + DAW)",
        "technologies": [
          "mcp"
        ]
      },
      "options": {
        "command": "bunx tsx src/mcp/cli.ts",
        "cwd": "apps/synth"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "metadata": {
        "description": "Start production server",
        "technologies": [
          "next"
        ]
      },
      "options": {
        "command": "next start -p 3022",
        "cwd": "apps/synth"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "oxlint"
      ],
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintrc.json"
      ],
      "metadata": {
        "description": "Run ESLint",
        "technologies": [
          "eslint"
        ]
      },
      "options": {
        "command": "eslint .",
        "cwd": "apps/synth"
      }
    },
    "oxlint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/.oxlintrc.json"
      ],
      "metadata": {
        "description": "Fast lint with oxlint",
        "technologies": [
          "oxlint"
        ]
      },
      "options": {
        "command": "bunx oxlint src --config ../../.oxlintrc.json",
        "cwd": "apps/synth"
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Run ESLint with auto-fix",
        "technologies": [
          "eslint"
        ]
      },
      "options": {
        "command": "eslint . --fix",
        "cwd": "apps/synth"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Format files with dprint",
        "technologies": [
          "dprint"
        ]
      },
      "options": {
        "command": "bunx dprint fmt \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "cwd": "apps/synth"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/dprint.json"
      ],
      "metadata": {
        "description": "Check formatting with dprint",
        "technologies": [
          "dprint"
        ]
      },
      "options": {
        "command": "bunx dprint check \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "cwd": "apps/synth"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/tsconfig.base.json",
        "{projectRoot}/tsconfig.json"
      ],
      "metadata": {
        "description": "Type-check TypeScript files",
        "technologies": [
          "typescript"
        ]
      },
      "options": {
        "command": "tsc --noEmit",
        "cwd": "apps/synth"
      }
    },
    "typecheck:tsgo": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/tsconfig.base.json",
        "{projectRoot}/tsconfig.json"
      ],
      "metadata": {
        "description": "Type-check with tsgo (38x faster)",
        "technologies": [
          "typescript",
          "tsgo"
        ]
      },
      "options": {
        "command": "tsgo --noEmit",
        "cwd": "apps/synth"
      }
    },
    "test": {
      "metadata": {
        "description": "Run unit tests with Vitest"
      },
      "options": {
        "config": "vitest.config.ts"
      }
    }
  }
}

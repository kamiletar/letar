{
  "name": "synth",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/synth/src",
  "projectType": "application",
  "tags": ["type:app", "scope:synth", "owner:letar"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next build",
        "cwd": "apps/synth"
      },
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/apps/synth/.next"],
      "metadata": {
        "description": "Build production bundle",
        "technologies": ["next"]
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next dev -p 3022",
        "cwd": "apps/synth"
      },
      "cache": false,
      "metadata": {
        "description": "Start development server on port 3022",
        "technologies": ["next"]
      }
    },
    "mcp:serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsx src/mcp/cli.ts",
        "cwd": "apps/synth"
      },
      "cache": false,
      "metadata": {
        "description": "Run synth MCP server via stdio (ментор + DAW)",
        "technologies": ["mcp"]
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next start -p 3022",
        "cwd": "apps/synth"
      },
      "dependsOn": ["build"],
      "cache": false,
      "metadata": {
        "description": "Start production server",
        "technologies": ["next"]
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": ["oxlint"],
      "options": {
        "command": "eslint .",
        "cwd": "apps/synth"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/.eslintrc.json"],
      "metadata": {
        "description": "Run ESLint",
        "technologies": ["eslint"]
      }
    },
    "oxlint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx oxlint src --config ../../.oxlintrc.json",
        "cwd": "apps/synth"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/.oxlintrc.json"],
      "metadata": {
        "description": "Fast lint with oxlint",
        "technologies": ["oxlint"]
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint . --fix",
        "cwd": "apps/synth"
      },
      "cache": false,
      "metadata": {
        "description": "Run ESLint with auto-fix",
        "technologies": ["eslint"]
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx dprint fmt \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "cwd": "apps/synth"
      },
      "cache": false,
      "metadata": {
        "description": "Format files with dprint",
        "technologies": ["dprint"]
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx dprint check \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "cwd": "apps/synth"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/dprint.json"],
      "metadata": {
        "description": "Check formatting with dprint",
        "technologies": ["dprint"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "apps/synth"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/tsconfig.base.json", "{projectRoot}/tsconfig.json"],
      "metadata": {
        "description": "Type-check TypeScript files",
        "technologies": ["typescript"]
      }
    },
    "typecheck:tsgo": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsgo --noEmit",
        "cwd": "apps/synth"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/tsconfig.base.json", "{projectRoot}/tsconfig.json"],
      "metadata": {
        "description": "Type-check with tsgo (38x faster)",
        "technologies": ["typescript", "tsgo"]
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "config": "apps/synth/vitest.config.ts"
      },
      "metadata": {
        "description": "Run unit tests with Vitest",
        "technologies": ["vitest"]
      }
    }
  }
}

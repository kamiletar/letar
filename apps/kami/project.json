{
  "name": "kami",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": ["@letar/chakra-provider", "@letar/yandex-metrika"],
  "sourceRoot": "apps/kami/src",
  "projectType": "application",
  "tags": ["type:app", "scope:kami", "owner:letar"],
  "targets": {
    "db:generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma generate",
        "cwd": "apps/kami"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/generated/schema.prisma",
        "{projectRoot}/schema.zmodel",
        "{projectRoot}/prisma.config.ts"
      ],
      "outputs": ["{projectRoot}/src/generated/prisma"],
      "metadata": {
        "description": "Generate Prisma Client from schema",
        "technologies": ["prisma"]
      }
    },
    "db:push": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma db push",
        "cwd": "apps/kami"
      },
      "dependsOn": ["db:generate"],
      "metadata": {
        "description": "Push Prisma schema changes to database (development)",
        "technologies": ["prisma"]
      }
    },
    "db:migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cross-env CI= VERCEL= GITHUB_ACTIONS= GITLAB= NETLIFY= HEROKU= prisma migrate dev",
        "cwd": "apps/kami"
      },
      "dependsOn": ["db:generate"],
      "metadata": {
        "description": "Create and apply database migration",
        "technologies": ["prisma"]
      }
    },
    "db:studio": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma studio",
        "cwd": "apps/kami"
      },
      "metadata": {
        "description": "Open Prisma Studio database GUI",
        "technologies": ["prisma"]
      }
    },
    "db:seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma db seed",
        "cwd": "apps/kami"
      },
      "dependsOn": ["db:generate"],
      "metadata": {
        "description": "Seed database with initial data",
        "technologies": ["prisma"]
      }
    },
    "zenstack:generate": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "zenstack generate",
          "prisma generate",
          "node -e \"require('fs').writeFileSync('src/generated/prisma/index.ts', 'export * from \\'./browser\\'\\n')\""
        ],
        "cwd": "apps/kami",
        "parallel": false
      },
      "cache": true,
      "inputs": ["{projectRoot}/schema.zmodel"],
      "outputs": ["{projectRoot}/src/generated"],
      "metadata": {
        "description": "Generate Prisma schema from ZenStack",
        "technologies": ["zenstack", "prisma"]
      }
    },
    "update-sw-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/update-sw-version.mjs",
        "cwd": "apps/kami"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/package.json",
        "{projectRoot}/scripts/update-sw-version.mjs",
        "{projectRoot}/public/sw.template.js"
      ],
      "outputs": ["{projectRoot}/public/sw.js"],
      "metadata": {
        "description": "Генерация sw.js с версией из package.json"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["update-sw-version", "^build", "^typecheck"],
      "options": {
        "command": "next build --webpack",
        "cwd": "apps/kami"
      },
      "metadata": {
        "description": "Build production bundle (без Turbopack — OOM на s2: Turbopack — нативный Rust-процесс вне V8-хипа, NODE_OPTIONS=--max-old-space-size его не ограничивает, см. .claude/docs/nextjs16-turbopack-default-emotion-hydration.md)"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "apps/kami"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/tsconfig.next-app.json",
        "{projectRoot}/tsconfig.json"
      ],
      "metadata": {
        "description": "Type-check TypeScript files",
        "technologies": ["typescript"]
      }
    },
    "typecheck:tsgo": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsgo --noEmit",
        "cwd": "apps/kami"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/tsconfig.next-app.json",
        "{projectRoot}/tsconfig.json"
      ],
      "metadata": {
        "description": "Type-check TypeScript files with tsgo (38x faster)",
        "technologies": ["typescript", "tsgo"]
      }
    },
    "oxlint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx oxlint src --config ../../.oxlintrc.json",
        "cwd": "apps/kami"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/.oxlintrc.json"],
      "metadata": {
        "description": "Fast lint with oxlint (50-100x faster than ESLint)",
        "technologies": ["oxlint"]
      }
    },
    "lint": {
      "dependsOn": ["oxlint"]
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint . --fix",
        "cwd": "apps/kami"
      },
      "cache": false,
      "metadata": {
        "description": "Run ESLint with auto-fix",
        "technologies": ["eslint"]
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx dprint fmt \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "cwd": "apps/kami"
      },
      "cache": false,
      "metadata": {
        "description": "Format files with dprint (~30x faster than Prettier)",
        "technologies": ["dprint"]
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx dprint check \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "cwd": "apps/kami"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/dprint.json"],
      "metadata": {
        "description": "Check file formatting with dprint",
        "technologies": ["dprint"]
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "config": "apps/kami/vitest.config.ts"
      }
    }
  }
}

{
  "extends": "../../tsconfig.next-app.json",
  "compilerOptions": {
    "rootDir": "${configDir}/../..",
    "lib": ["dom", "dom.iterable", "esnext", "webworker"],
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@letar/consent": ["../../libs/consent/src/index.ts"],
      "@letar/auth": ["../../libs/auth/src/index.ts"],
      "@letar/auth/client": ["../../libs/auth/src/client/index.ts"],
      "@letar/auth/server": ["../../libs/auth/src/server/index.ts"],
      "@letar/analytics": ["../../libs/analytics/src/index.ts"],
      "@letar/chakra-provider": ["../../libs/chakra-provider/src/index.ts"],
      "@letar/image-upload/server": ["../../libs/image-upload/src/server/index.ts"],
      "@letar/yandex-metrika": ["../../libs/yandex-metrika/src/index.ts"],
      "@letar/forms": ["../../libs/forms/src/index.ts"],
      "@letar/email": ["../../libs/email/src/index.ts"],
      "@letar/ui": ["../../libs/ui/src/index.ts"]
    }
  },
  "include": [
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "keystatic.config.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}

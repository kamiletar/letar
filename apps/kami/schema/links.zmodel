// ========================================
// Ссылки (закладки из Android Share)
// ========================================

// Сохранённая ссылка — публичная витрина для чтения, пишет только владелец
model Link {
  id          String   @id @default(cuid())

  url         String
  title       String
  description String?

  // Классификация — свободные поля, без отдельных моделей категорий/меток (см. LearningItem)
  category    String?
  tags        String[]

  read        Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Публичный раздел для чтения (витрина закладок на сайте) — пишет только владелец (ADMIN)
  @@allow('read', true)
  @@allow('create,update,delete', auth() != null && 'ADMIN' in auth().roles)

  @@index([category])
  @@index([read])
}

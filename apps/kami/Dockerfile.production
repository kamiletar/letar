# Dockerfile.production - для уже собранных приложений
# Используется когда сборка выполнена на сервере с nx build affected
# Build context: workspace root (C:\web\letar)

FROM node:24-slim AS tz

FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# zoneinfo копируем из Debian-образа, а не ставим `apk add tzdata`: Alpine (musl) не
# содержит zoneinfo, а apk был единственным сетевым запросом в этом Dockerfile и падал
# с "TLS: unspecified error" каждый раз, когда ночной docker-prune сносил кеш слоя.
# Разбор — .claude/docs/docker-prune-cold-layer-network-flake.md
COPY --from=tz /usr/share/zoneinfo /usr/share/zoneinfo
ENV TZ=Europe/Moscow

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Копируем уже собранный standalone output
# Standalone включает в себя все необходимые node_modules
COPY --chown=nextjs:nodejs apps/kami/.next/standalone ./

# Копируем статику и public (не включаются в standalone автоматически)
COPY --chown=nextjs:nodejs apps/kami/.next/static ./apps/kami/.next/static
COPY --chown=nextjs:nodejs apps/kami/public ./apps/kami/public
COPY --chown=nextjs:nodejs apps/kami/messages ./apps/kami/messages
# Keystatic local reader (storage: 'local', используется когда KEYSTATIC_GITHUB_CLIENT_ID не
# задан — так staging сознательно настроен) читает файлы контента по process.cwd() в рантайме
# через fs, а не через статические импорты — трейсер standalone-сборки эти файлы не видит и не
# копирует сам (см. .claude/docs/nextjs-standalone-tracing.md).
COPY --chown=nextjs:nodejs apps/kami/src/content ./apps/kami/src/content

USER nextjs

EXPOSE 3005

ENV PORT=3005
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/kami/server.js"]

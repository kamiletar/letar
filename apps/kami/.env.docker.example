# ============================================
# Domain Configuration (for Nginx Proxy Manager)
# ============================================
# Все домены через запятую: основной и алиасы
DOMAIN=kami.yourdomain.com

# ============================================
# Database Configuration
# ============================================
DB_PASSWORD=your_secure_password_here

# ============================================
# Better Auth Configuration
# ============================================
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_auth_secret_here
BETTER_AUTH_URL=https://kami.yourdomain.com

# ============================================
# GitHub OAuth (Recommended for developer portfolio)
# ============================================
AUTH_GITHUB_ID=your_github_client_id
AUTH_GITHUB_SECRET=your_github_client_secret

# ============================================
# Google OAuth (Optional)
# ============================================
# AUTH_GOOGLE_ID=your_google_client_id
# AUTH_GOOGLE_SECRET=your_google_client_secret

# ============================================
# Yandex OAuth (Optional)
# ============================================
# AUTH_YANDEX_ID=your_yandex_client_id
# AUTH_YANDEX_SECRET=your_yandex_client_secret

# ============================================
# VK (ВКонтакте) OAuth (Optional)
# ============================================
# AUTH_VK_ID=your_vk_client_id
# AUTH_VK_SECRET=your_vk_client_secret

# ============================================
# Email Configuration (SMTP)
# ============================================
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@yandex.ru
SMTP_PASSWORD=your_app_password
SMTP_FROM=Kami <your_email@yandex.ru>

# ============================================
# Application
# ============================================
NEXT_PUBLIC_APP_URL=https://kami.yourdomain.com

# ============================================
# Yandex Metrica (Optional)
# ============================================
# NEXT_PUBLIC_YM_COUNTER_ID=12345678

# ============================================
# Telegram Notifications (Optional)
# ============================================
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# ============================================
# PWA / Service Worker
# ============================================
# Set to "true" to disable Service Worker (for debugging)
# NEXT_PUBLIC_DISABLE_SERVICE_WORKER=false

# GlitchTip (трекинг ошибок) — DSN получить в GlitchTip UI → Settings → Client Keys, см. infra/glitchtip/README.md
GLITCHTIP_DSN=<glitchtip_dsn>
GLITCHTIP_ENVIRONMENT=<glitchtip_environment>
NEXT_PUBLIC_GLITCHTIP_DSN=<next_public_glitchtip_dsn>
NEXT_PUBLIC_GLITCHTIP_ENVIRONMENT=<next_public_glitchtip_environment>

PORT=3005

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kami?schema=public"

# Better Auth — секреты только в .env.local (не коммитятся)
# BETTER_AUTH_SECRET=...  # openssl rand -base64 32
# BETTER_AUTH_URL=http://localhost:3005

# Ключница (auth.letar.best) — OIDC-клиент, единственный способ входа
# Секреты (OIDC_CLIENT_SECRET, OIDC_CLIENT_ID) — в .env.local
OIDC_DISCOVERY_URL=https://auth.letar.best/api/auth/.well-known/openid-configuration

# Email (@letar/email) — см. .env.local и docker-compose.production.yml

# PWA
NEXT_PUBLIC_DISABLE_SERVICE_WORKER=true

# Yandex Metrica
# NEXT_PUBLIC_YM_COUNTER_ID=... # ID счётчика Яндекс.Метрики

# AI Chatbot (Claude API)
# ANTHROPIC_API_KEY=... # API ключ Anthropic для чатбота

# Google Calendar API (опционально)
# GOOGLE_CALENDAR_ID=...                    # ID календаря (primary или email@group.calendar.google.com)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=...          # Email Service Account
# GOOGLE_PRIVATE_KEY=...                    # Приватный ключ (в одну строку, \n вместо переносов)

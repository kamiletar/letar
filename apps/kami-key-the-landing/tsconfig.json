{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@letar/analytics": [
        "../../libs/analytics/src/index.ts"
      ],
      "@letar/ui": [
        "../../libs/ui/src/index.ts"
      ],
      "@letar/seo": [
        "../../libs/seo/src/index.ts"
      ],
      "@letar/glitchtip": [
        "../../libs/glitchtip/src/index.ts"
      ],
      "@letar/glitchtip/client": [
        "../../libs/glitchtip/src/client/index.ts"
      ],
      "@letar/glitchtip/server": [
        "../../libs/glitchtip/src/server/index.ts"
      ],
      "@letar/github-releases": [
        "../../libs/github-releases/src/index.ts"
      ],
      "@letar/format-utils": [
        "../../libs/format-utils/src/index.ts"
      ],
      "@letar/ui/admin-edit-overlay": ["../../libs/ui/src/lib/admin-edit-overlay.tsx"],
      "@letar/ui/analytics-gate": ["../../libs/ui/src/lib/analytics-gate.tsx"],
      "@letar/ui/app-toaster": ["../../libs/ui/src/lib/app-toaster.tsx"],
      "@letar/ui/bar-chart": ["../../libs/ui/src/lib/bar-chart.tsx"],
      "@letar/ui/build-version": ["../../libs/ui/src/lib/build-version.tsx"],
      "@letar/ui/chakra-color-var": ["../../libs/ui/src/lib/chakra-color-var.ts"],
      "@letar/ui/confirm-dialog": ["../../libs/ui/src/lib/confirm-dialog.tsx"],
      "@letar/ui/consent-types": ["../../libs/ui/src/lib/consent-types.ts"],
      "@letar/ui/cookie-banner": ["../../libs/ui/src/lib/cookie-banner.tsx"],
      "@letar/ui/cookie-settings-button": ["../../libs/ui/src/lib/cookie-settings-button.tsx"],
      "@letar/ui/copy-to-clipboard-button": ["../../libs/ui/src/lib/copy-to-clipboard-button.tsx"],
      "@letar/ui/cover-image": ["../../libs/ui/src/lib/cover-image.tsx"],

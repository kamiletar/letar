      "@letar/ui/pressable-button": ["../../libs/ui/src/lib/pressable-button.tsx"],
      "@letar/ui/priority-nav": ["../../libs/ui/src/lib/priority-nav.tsx"],
      "@letar/ui/quantity-stepper": ["../../libs/ui/src/lib/quantity-stepper.tsx"],
      "@letar/ui/rating-display": ["../../libs/ui/src/lib/rating-display.tsx"],
      "@letar/ui/rating-distribution": ["../../libs/ui/src/lib/rating-distribution.tsx"],
      "@letar/ui/rating-stars": ["../../libs/ui/src/lib/rating-stars.tsx"],
      "@letar/ui/review-card": ["../../libs/ui/src/lib/review-card.tsx"],
      "@letar/ui/route-announcer": ["../../libs/ui/src/lib/route-announcer.tsx"],

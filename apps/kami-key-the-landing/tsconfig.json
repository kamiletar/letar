      "@letar/ui/file-trigger": ["../../libs/ui/src/lib/file-trigger.tsx"],
      "@letar/ui/header": ["../../libs/ui/src/lib/header/index.ts"],
      "@letar/ui/header-scroll-padding": ["../../libs/ui/src/lib/header-scroll-padding.tsx"],
      "@letar/ui/image-magnifier": ["../../libs/ui/src/lib/image-magnifier.tsx"],
      "@letar/ui/lightbox-viewer": ["../../libs/ui/src/lib/lightbox-viewer.tsx"],
      "@letar/ui/mobile-auth-section": ["../../libs/ui/src/lib/mobile-auth-section.tsx"],
      "@letar/ui/offline-consent-banner": ["../../libs/ui/src/lib/offline-consent-banner.tsx"],

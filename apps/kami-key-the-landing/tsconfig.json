      "@letar/ui/stat-card": ["../../libs/ui/src/lib/stat-card.tsx"],
      "@letar/ui/status-badge": ["../../libs/ui/src/lib/status-badge.tsx"],
      "@letar/ui/sticky-action-bar": ["../../libs/ui/src/lib/sticky-action-bar.tsx"],
      "@letar/ui/studio-credit": ["../../libs/ui/src/lib/studio-credit.tsx"],
      "@letar/ui/tooltip": ["../../libs/ui/src/lib/tooltip.tsx"],
      "@letar/ui/top-loader": ["../../libs/ui/src/lib/top-loader.tsx"],
      "@letar/ui/touch-link": ["../../libs/ui/src/lib/touch-link.tsx"],
      "@letar/ui/use-analytics-consent": ["../../libs/ui/src/lib/use-analytics-consent.ts"],
      "@letar/ui/use-copy-to-clipboard": ["../../libs/ui/src/lib/use-copy-to-clipboard.ts"],
      "@letar/ui/use-scroll-gate": ["../../libs/ui/src/lib/use-scroll-gate.ts"],
      "@letar/ui/use-service-worker": ["../../libs/ui/src/lib/use-service-worker.ts"],
      "@letar/ui/use-share": ["../../libs/ui/src/lib/use-share.ts"],
      "@letar/ui/user-menu": ["../../libs/ui/src/lib/user-menu.tsx"]
    },
    "types": [],
    "noUncheckedSideEffectImports": false,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}

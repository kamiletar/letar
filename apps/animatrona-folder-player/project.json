{
  "name": "animatrona-folder-player",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": [
    "@letar/forms",
    "@letar/icon-generator"
  ],
  "sourceRoot": "apps/animatrona-folder-player",
  "projectType": "application",
  "tags": [
    "type:app",
    "scope:animatrona-folder-player",
    "owner:letar",
    "platform:electron"
  ],
  "targets": {
    "dev": {
      "command": "node scripts/dev.js",
      "options": {
        "cwd": "apps/animatrona-folder-player"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "next build renderer",
          "npx webpack --config main/webpack.config.js"
        ],
        "cwd": "apps/animatrona-folder-player",
        "parallel": false
      }
    },
    "build:win": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "next build renderer",
          "npx webpack --config main/webpack.config.js",
          "npx electron-builder --win"
        ],
        "cwd": "apps/animatrona-folder-player",
        "parallel": false
      }
    },
    "build:linux": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "next build renderer",
          "npx webpack --config main/webpack.config.js",
          "npx electron-builder --linux"
        ],
        "cwd": "apps/animatrona-folder-player",
        "parallel": false
      }
    },
    "lint": {
      "options": {
        "args": [
          "main/**/*.{ts,tsx}",
          "renderer/**/*.{ts,tsx}"
        ]
      }
    },
    "typecheck:tsgo": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsgo --project apps/animatrona-folder-player/tsconfig.json --noEmit",
          "tsgo --project apps/animatrona-folder-player/renderer/tsconfig.json --noEmit"
        ],
        "parallel": false
      }
    },
    "format": {
      "command": "dprint fmt apps/animatrona-folder-player/**/*.{ts,tsx,json}"
    }
  }
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "sourceMap": false,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@letar/e2e-testing": ["../../libs/e2e-testing/src/index.ts"],
      "@letar/e2e-testing/prisma-cjs-wrapper": ["../../libs/e2e-testing/src/lib/prisma-cjs-wrapper.js"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.js",
    "playwright.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.js",
    "src/**/*.test.ts",
    "src/**/*.test.js",
    "src/**/*.d.ts",
    "../../libs/e2e-testing/src/**/*.ts"
  ],
  "exclude": ["out-tsc", "test-output", "eslint.config.js", "eslint.config.mjs", "eslint.config.cjs"]
}

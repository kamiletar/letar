# Staging-окружение на s3 (PLAN.md §18 Сессия D). Скопировать в .env.staging на s3 и заполнить секреты.
#
# По умолчанию БЕЗ публичного домена — e2e и ручная проверка идут через
# http://localhost:${PORT} прямо на s3 (docker-compose.staging.yml публикует хостовый порт).
# Публичный домен (NPM proxy host + DNS) — отдельная задача, не блокирует staging-gated пайплайн.

PORT=3018

# Пароль PostgreSQL для staging БД
POSTGRES_PASSWORD=change-me
DB_PASSWORD=change-me

# Better Auth
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3018

# OIDC (тот же клиент что и prod — в auth-hub добавлен redirect URI http://localhost:3018 для staging,
# см. apps/auth-hub/prisma/seed.ts, clientId grandslamcup-prod)
OIDC_CLIENT_ID=grandslamcup-prod
OIDC_CLIENT_SECRET=change-me

# Umami — пустой WEBSITE_ID чтобы не считать staging трафик
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://stats.letar.best/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Yandex Maps — можно тот же ключ
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=change-me

# Cron
CRON_SECRET=change-me

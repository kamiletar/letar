# Staging-окружение для gsc-test.letar.best (s1)
# Скопировать в .env.staging на сервере и заполнить секреты

DOMAIN=gsc-test.letar.best
PORT=3016

# Пароль PostgreSQL для staging БД
POSTGRES_PASSWORD=change-me
DB_PASSWORD=change-me

# Better Auth
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=https://gsc-test.letar.best

# OIDC (тот же клиент что и prod, но в auth-hub добавить redirect URI для staging домена)
OIDC_CLIENT_ID=grandslamcup-prod
OIDC_CLIENT_SECRET=change-me

# Umami — пустой WEBSITE_ID чтобы не считать staging трафик
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://stats.letar.best/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Yandex Maps — можно тот же ключ
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=change-me

# Cron
CRON_SECRET=change-me

# Staging-окружение на s3 (PLAN.md §18 Сессия D). Скопировать в .env.staging на s3 и заполнить секреты.
#
# Публичный HTTPS-домен — максимально близко к прод-окружению (cookie/CORS/OIDC-редиректы
# должны вести себя ровно как в проде, localhost для этого не годится: другой security-контекст
# браузера). Требует NPM proxy host (https://grandslamcup-stage.s3.letar.best → форвард на
# хост-порт staging-контейнера) — инфра-задача, см. deployment.md. Домен — один лейбл
# (grandslamcup-stage), попадает под существующий DNS-wildcard `*.s3 CNAME s3.letar.best`,
# новая DNS-запись не нужна.

# PORT — ВНУТРЕННИЙ порт, на котором слушает Next.js внутри контейнера (должен совпадать с
# правой частью маппинга портов в docker-compose.staging.yml, сейчас 3016). НЕ хостовый порт —
# хостовый порт (3018) захардкожен в docker-compose.staging.yml, а не берётся из этой переменной.
PORT=3016
DOMAIN=grandslamcup-stage.s3.letar.best

# Пароль PostgreSQL для staging БД
POSTGRES_PASSWORD=change-me
DB_PASSWORD=change-me

# Better Auth
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=https://grandslamcup-stage.s3.letar.best

# OIDC (тот же клиент что и prod — в auth-hub добавлен redirect URI для staging-домена,
# см. apps/auth-hub/prisma/seed.ts, clientId grandslamcup-prod)
OIDC_CLIENT_ID=grandslamcup-prod
OIDC_CLIENT_SECRET=change-me

# Umami — пустой WEBSITE_ID чтобы не считать staging трафик
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://stats.letar.best/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Yandex Maps — можно тот же ключ
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=change-me

# Cron
CRON_SECRET=change-me

# Dev-session (e2e/preview-авторизация без OIDC, @letar/auth/server createDevSessionRoute)
# ⚠️ Обе переменные — ТОЛЬКО здесь, в .env.staging. НИКОГДА не переносить в .env.docker/.env.docker.enc —
# это бэкдор-эндпоинт, создающий сессию для любого email без пароля/OIDC.
ALLOW_DEV_SESSION=true
DEV_SESSION_TOKEN=change-me

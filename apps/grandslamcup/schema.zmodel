// Grand Slam Cup — турнир поэтов
// Авторизация через ключницу (auth.letar.best)
//
// Схема разбита на доменные файлы в ./schema/ — циклические импорты между
// ними подтверждённо рабочие, см. .claude/docs/zenstack-multifile-schema-circular-imports.md

import "./schema/users"
import "./schema/geo"
import "./schema/competition"
import "./schema/teams"
import "./schema/matches"
import "./schema/judging"
import "./schema/content"
import "./schema/social"

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./prisma"
}

plugin prisma {
  provider = '@core/prisma'
  output = './src/generated/schema.prisma'
}

plugin typescript {
  provider = '@core/typescript'
  output = './src/generated'
}

plugin policy {
  provider = '@zenstackhq/plugin-policy'
}

// Генерация Zod схем с UI метаданными для @letar/forms
plugin formSchema {
  provider = '../../libs/zenstack-form-plugin/dist/index.js'
  output = './src/generated/form-schemas'
}

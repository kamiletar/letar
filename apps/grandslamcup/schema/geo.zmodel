import "./competition"
import "./teams"
import "./content"
import "./matches"
import "./users"

// ========================================
// Справочники
// ========================================

/// Город (СПб, Москва, ...)
model City {
  id        String   @id @default(cuid())
  /// Название города
  name      String   @unique @meta("form.title", "Название") @meta("form.placeholder", "Санкт-Петербург")
  /// URL-slug
  slug      String   @unique @meta("form.title", "Slug (URL)") @meta("form.placeholder", "spb")
  /// @deprecated Используй socialLinks
  telegramLink String? @meta("form.title", "Telegram") @meta("form.placeholder", "https://t.me/grandslamcup")
  /// ID Telegram-канала города (напр. @kbs_spb или -100...)
  telegramChatId String? @meta("form.title", "Telegram Chat ID") @meta("form.placeholder", "@kbs_spb или -1001234567890")
  /// Социальные ссылки JSON
  socialLinks  Json? @meta("form.exclude", true)
  /// Использовать терминологию «домашняя/гостевая» (для городов с домашними площадками)
  useHomeAway Boolean @default(false) @meta("form.title", "Домашние стадионы")
  createdAt DateTime @default(now()) @meta("form.exclude", true)
  updatedAt DateTime @updatedAt @meta("form.exclude", true)

  venues     Venue[]
  seasons    Season[]
  teams      Team[]
  players    Player[]
  organizers CityOrganizer[]
  newsPosts  NewsPost[]
  donateLinks DonateLink[]

  @@allow('read', true)
  @@allow('create,update,delete', auth() != null && 'ADMIN' in auth().roles)
}

/// Привязка организатора к городу (один пользователь может быть организатором нескольких городов)
model CityOrganizer {
  id        String   @id @default(cuid())
  userId    String
  cityId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([userId, cityId])
  @@allow('read', true)
  @@allow('create,update,delete', auth() != null && 'ADMIN' in auth().roles)
  @@index([userId])
  @@index([cityId])
}

/// Площадка (бар, клуб, библиотека — домашний стадион команды)
model Venue {
  id            String   @id @default(cuid())
  /// Название площадки
  name          String @meta("form.title", "Название") @meta("form.placeholder", "Бар Глагол")
  /// URL-slug
  slug          String   @unique @meta("form.title", "Slug (URL)") @meta("form.placeholder", "glagol")
  /// Город
  cityId        String @meta("form.title", "Город") @meta("form.fieldType", "select")
  /// Адрес
  address       String? @meta("form.title", "Адрес") @meta("form.placeholder", "Невский пр., 1")
  /// Широта (для карты)
  latitude      Float? @meta("form.exclude", true)
  /// Долгота (для карты)
  longitude     Float? @meta("form.exclude", true)
  /// Фото площадки
  photo         String? @meta("form.exclude", true)
  /// Описание
  description   String? @meta("form.title", "Описание") @meta("form.fieldType", "textarea")
  /// @deprecated Используй socialLinks
  telegramLink  String? @meta("form.title", "Telegram") @meta("form.placeholder", "https://t.me/glagol")
  /// @deprecated Используй socialLinks
  websiteUrl    String? @meta("form.title", "Сайт") @meta("form.placeholder", "https://glagol.bar")
  /// Социальные ссылки JSON
  socialLinks   Json? @meta("form.exclude", true)
  createdAt     DateTime @default(now()) @meta("form.exclude", true)
  updatedAt     DateTime @updatedAt @meta("form.exclude", true)

  city    City    @relation(fields: [cityId], references: [id])
  teams   Team[]
  matches Match[]
  friendlyMatchRequests FriendlyMatchRequest[]

  @@allow('read', true)
  @@allow('create,update,delete', auth() != null && 'ADMIN' in auth().roles)
  @@index([cityId])
}

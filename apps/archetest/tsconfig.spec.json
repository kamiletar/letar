{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./out-tsc/spec",
    "tsBuildInfoFile": "./out-tsc/spec/tsconfig.spec.tsbuildinfo",
    "jsx": "react-jsx",
    "types": ["vitest/globals", "node"],
    "rootDir": "."
  },
  "include": [
    "vitest.config.ts",
    "vitest.setup.tsx",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.d.ts"
  ],
  "exclude": ["out-tsc", "dist", "node_modules", ".next"]
}

FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Alpine (musl) не содержит zoneinfo по умолчанию - без tzdata TZ ниже молча не сработает
RUN apk add --no-cache tzdata
ENV TZ=Europe/Moscow

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Копируем standalone build
COPY --chown=nextjs:nodejs apps/archetest/.next/standalone ./
COPY --chown=nextjs:nodejs apps/archetest/.next/static ./apps/archetest/.next/static
COPY --chown=nextjs:nodejs apps/archetest/public ./apps/archetest/public

USER nextjs

EXPOSE 3012

ENV PORT=3012
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/archetest/server.js"]

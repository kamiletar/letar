# Staging-окружение на s3 (PLAN.md §18.7 Тираж M). Скопировать в .env.staging на s3 и заполнить секреты.
#
# time — hub-client (OIDC через Ключницу, clientId time-prod, см. apps/auth-hub/prisma/seed.ts).
# Публичный HTTPS-домен обязателен (не localhost) — OIDC callback должен совпасть с
# зарегистрированным redirect URI, cookie/CORS должны вести себя как в проде. Требует NPM
# proxy host (https://time-stage.s3.letar.best → форвард на хост-порт 3023 staging-контейнера).
# Домен — один лейбл (time-stage), попадает под существующий DNS-wildcard
# `*.s3 CNAME s3.letar.best`, новая DNS-запись не нужна.

# PORT — ВНУТРЕННИЙ порт, на котором слушает Next.js внутри контейнера (должен совпадать с
# правой частью маппинга портов в docker-compose.staging.yml, сейчас 3013). НЕ хостовый порт —
# хостовый порт (3023) захардкожен в docker-compose.staging.yml, а не берётся из этой переменной.
PORT=3013
DOMAIN=time-stage.s3.letar.best

# Пароль PostgreSQL для staging БД
DB_PASSWORD=change-me

# Better Auth
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=https://time-stage.s3.letar.best

# OIDC (тот же клиент что и прод — в auth-hub добавлен redirect URI для staging-домена,
# см. apps/auth-hub/prisma/seed.ts, clientId time-prod). Секрет — тот же, что у прод-клиента
# (OIDC_TIME_SECRET в auth-hub), т.к. это один и тот же зарегистрированный клиент.
# discoveryUrl указывает на ПРОД auth-hub (auth.letar.best) — clientId time-prod зарегистрирован
# там же, staging-домен добавлен только как ещё один redirect URI у того же клиента, отдельного
# staging-инстанса Ключницы нет.
OIDC_CLIENT_ID=time-prod
OIDC_CLIENT_SECRET=change-me
OIDC_DISCOVERY_URL=https://auth.letar.best/api/auth/.well-known/openid-configuration

# Dev-session (e2e/preview-авторизация без OIDC, @letar/auth/server createDevSessionRoute) —
# ⚠️ Обе переменные — ТОЛЬКО здесь, в .env.staging. НИКОГДА не переносить в .env.docker/.env.docker.enc —
# это бэкдор-эндпоинт, создающий сессию для любого email без пароля/OIDC.
ALLOW_DEV_SESSION=true
DEV_SESSION_TOKEN=change-me

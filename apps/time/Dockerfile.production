FROM node:24-slim AS tz

FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# zoneinfo копируем из Debian-образа, а не ставим `apk add tzdata`: Alpine (musl) не
# содержит zoneinfo, а apk был единственным сетевым запросом в этом Dockerfile и падал
# с "TLS: unspecified error" каждый раз, когда ночной docker-prune сносил кеш слоя.
# Разбор — .claude/docs/docker-prune-cold-layer-network-flake.md
COPY --from=tz /usr/share/zoneinfo /usr/share/zoneinfo
ENV TZ=Europe/Moscow

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Копируем standalone build
COPY --chown=nextjs:nodejs apps/time/.next/standalone ./
COPY --chown=nextjs:nodejs apps/time/.next/static ./apps/time/.next/static
COPY --chown=nextjs:nodejs apps/time/public ./apps/time/public

USER nextjs

EXPOSE 3013

ENV PORT=3013
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/time/server.js"]

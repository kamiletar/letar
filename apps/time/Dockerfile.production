# node:24-slim, не node:24-alpine — эксперимент, единственное отклонение от паттерна
# остальных приложений. Debian содержит zoneinfo из коробки, двухстадийный
# COPY --from=tz не нужен. Цена — образ на ~90MB тяжелее alpine-варианта (замер 2026-08-28).
# Не тиражировать на другие приложения без отдельного решения — разбор в PLAN-INFRA-4.md §130.
FROM node:24-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV TZ=Europe/Moscow

RUN groupadd --gid 1001 nodejs
RUN useradd --system --uid 1001 --gid nodejs nextjs

# Копируем standalone build
COPY --chown=nextjs:nodejs apps/time/.next/standalone ./
COPY --chown=nextjs:nodejs apps/time/.next/static ./apps/time/.next/static
COPY --chown=nextjs:nodejs apps/time/public ./apps/time/public

USER nextjs

EXPOSE 3013

ENV PORT=3013
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/time/server.js"]

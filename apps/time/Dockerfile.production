FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Alpine (musl) не содержит zoneinfo по умолчанию - без tzdata TZ ниже молча не сработает
RUN apk add --no-cache tzdata
ENV TZ=Europe/Moscow

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Копируем standalone build
COPY --chown=nextjs:nodejs apps/time/.next/standalone ./
COPY --chown=nextjs:nodejs apps/time/.next/static ./apps/time/.next/static
COPY --chown=nextjs:nodejs apps/time/public ./apps/time/public

USER nextjs

EXPOSE 3013

ENV PORT=3013
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/time/server.js"]

PORT=3013

# Auth (OIDC через ключницу)
BETTER_AUTH_SECRET=time-dev-secret-change-in-production
BETTER_AUTH_URL=http://localhost:3013
OIDC_CLIENT_ID=time-client-id
OIDC_CLIENT_SECRET=time-client-secret-dev-only
OIDC_DISCOVERY_URL=http://localhost:3014/api/auth/.well-known/openid-configuration

# Email (MailHog для dev)
EMAIL_USE_MAILHOG=true
SMTP_FROM_EMAIL=noreply@time.letar.best
SMTP_FROM_NAME=Unix Time

# Cron
CRON_SECRET=time-cron-dev-secret

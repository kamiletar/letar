# Dockerfile.production - для уже собранных приложений
# Используется когда сборка выполнена на сервере с nx build affected
# Build context: workspace root (C:\web\letar)

FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Копируем уже собранный standalone output
COPY --chown=nextjs:nodejs apps/form-docs/.next/standalone ./

# Копируем статику и public (не включаются в standalone автоматически)
COPY --chown=nextjs:nodejs apps/form-docs/.next/static ./apps/form-docs/.next/static
COPY --chown=nextjs:nodejs apps/form-docs/public ./apps/form-docs/public

USER nextjs

EXPOSE 3020

ENV PORT=3020
ENV HOSTNAME="0.0.0.0"

CMD ["node", "apps/form-docs/server.js"]

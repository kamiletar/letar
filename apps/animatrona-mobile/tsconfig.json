{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "module": "esnext",
    "strict": true,
    "ignoreDeprecations": "6.0",
    "lib": [
      "es2019",
      "es2020.bigint",
      "es2020.date",
      "es2020.number",
      "es2020.promise",
      "es2020.string",
      "es2020.symbol.wellknown",
      "es2021.promise",
      "es2021.string",
      "es2021.weakref",
      "es2022.array",
      "es2022.object",
      "es2022.string",
      "es2022.error"
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@letar/exoplayer-ass": ["../../libs/exoplayer-ass/src"],
      "@letar/exoplayer-ass/*": ["../../libs/exoplayer-ass/src/*"],
      "@letar/exoplayer-sync": ["../../libs/exoplayer-sync/src"],
      "@letar/exoplayer-sync/*": ["../../libs/exoplayer-sync/src/*"],
      "@letar/animatrona-shared": ["../../libs/animatrona-shared/src"],
      "@letar/animatrona-types": ["../../libs/animatrona-types/src"],
      "@letar/animatrona-utils": ["../../libs/animatrona-utils/src"]
    },
    "types": ["react-native"]
  },
  "include": ["src/**/*", "index.js", "App.tsx"],
  "exclude": ["node_modules", "android", "ios"]
}

{
  "name": "animatrona-tv",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/animatrona-tv/src",
  "projectType": "application",
  "tags": [
    "scope:animatrona",
    "type:tv",
    "owner:letar"
  ],
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Format files with dprint",
        "technologies": [
          "dprint"
        ]
      },
      "options": {
        "command": "dprint fmt",
        "cwd": "apps/animatrona-tv"
      }
    },
    "start": {
      "command": "react-native start --port 8083",
      "options": {
        "cwd": "apps/animatrona-tv"
      }
    },
    "android": {
      "command": "react-native run-android",
      "options": {
        "cwd": "apps/animatrona-tv"
      }
    },
    "build-android": {
      "command": ".\\gradlew.bat assembleDebug --no-daemon",
      "options": {
        "cwd": "apps/animatrona-tv/android",
        "env": {
          "JAVA_HOME": "C:\\Android\\jdk-17.0.13+11"
        }
      }
    },
    "build-android-release": {
      "command": "gradlew.bat assembleRelease --no-daemon",
      "options": {
        "cwd": "apps/animatrona-tv/android"
      }
    },
    "clean": {
      "command": "gradlew.bat clean",
      "options": {
        "cwd": "apps/animatrona-tv/android"
      }
    },
    "oxlint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/.oxlintrc.json"
      ],
      "metadata": {
        "description": "Fast lint with oxlint (50-100x faster than ESLint)",
        "technologies": [
          "oxlint"
        ]
      },
      "options": {
        "command": "bunx oxlint src --config ../../.oxlintrc.json",
        "cwd": "apps/animatrona-tv"
      }
    },
    "lint": {
      "dependsOn": [
        "oxlint"
      ]
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "options": {
        "cwd": "apps/animatrona-tv"
      }
    },
    "typecheck:tsgo": {
      "command": "tsgo --noEmit",
      "options": {
        "cwd": "apps/animatrona-tv"
      }
    }
  }
}

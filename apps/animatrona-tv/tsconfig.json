{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@letar/exoplayer-ass": ["../../libs/exoplayer-ass/src"],
      "@letar/exoplayer-sync": ["../../libs/exoplayer-sync/src"],
      "@letar/animatrona-shared": ["../../libs/animatrona-shared/src"],
      "@letar/animatrona-utils": ["../../libs/animatrona-utils/src"],
      "@letar/animatrona-types": ["../../libs/animatrona-types/src"]
    },
    "types": ["react-native"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*", "index.js", "App.tsx"],
  "exclude": ["node_modules", "android"]
}

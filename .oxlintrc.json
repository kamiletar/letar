{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "import", "nextjs"],
  "categories": {
    "correctness": "error",
    "suspicious": "off",
    "perf": "off"
  },
  "rules": {
    // Дублирующие ESLint правила — отключены в oxlint, проверяются ESLint
    "no-explicit-any": "off",
    "no-unused-vars": "off",
    "no-console": "off",
    "prefer-const": "off",
    "no-var": "error",
    "eqeqeq": "error",

    // React hooks — только rules-of-hooks как error, exhaustive-deps отдаём ESLint
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "off",

    // Next.js — отключаем, т.к. ESLint plugin next уже проверяет это,
    // а oxlint даёт ложные срабатывания в тестах и shared-библиотеках
    "nextjs/no-html-link-for-pages": "off",
    "nextjs/no-img-element": "off",

    // Отключаем правила, не актуальные для React 17+
    "react/react-in-jsx-scope": "off",

    // Отключаем слишком строгие правила
    "typescript/no-non-null-assertion": "off",
    "no-plusplus": "off",
    "no-await-in-loop": "off",
    "nextjs/no-assign-module-variable": "off"
  },
  "overrides": [
    {
      // Vue-библиотеки: composables названы по конвенции Vue `use*`, но не являются
      // React-хуками — эвристика react-hooks/rules-of-hooks и react/* ошибочно
      // матчит их как React-код (нет ни одного реального React-компонента в этих либах)
      "files": ["libs/forms-vue/**", "libs/forms-vue-shadcn/**"],
      "rules": {
        "react-hooks/rules-of-hooks": "off",
        "react/immutability": "off",
        "react/refs": "off",
        "react/set-state-in-effect": "off",
        "react/purity": "off",
        "react/preserve-manual-memoization": "off",
        "react/static-components": "off"
      }
    },
    {
      // Playwright E2E-фикстуры: параметр колбэка `use` (`async ({ page }, use) => { await use(page) }`)
      // матчится эвристикой react-hooks/rules-of-hooks как вызов React-хука `use()` — в тестовых
      // приложениях нет ни одного настоящего React-компонента, ложное срабатывание системное
      "files": ["apps/*-e2e/**"],
      "rules": {
        "react-hooks/rules-of-hooks": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/node_modules/**",
    "**/prisma/generated/**",
    "**/src/generated/**",
    "**/zod/**",
    "**/test-output/**",
    "**/public/**",
    "**/*.config.*",
    "**/types/**/*.d.ts"
  ],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "globals": {
    "React": "readonly",
    "JSX": "readonly"
  },
  "settings": {
    "react": {
      "version": "19"
    },
    "next": {
      "rootDir": ["apps/*"]
    }
  }
}

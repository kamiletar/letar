{
  "mcpServers": {
    "nx-mcp": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "bunx",
        "nx-mcp@0.25.0",
        "C:/web/letar",
        "--minimal",
        "false"
      ]
    },
    "letar": {
      "type": "stdio",
      "command": "bun",
      "args": [
        ".claude/mcp/letar.ts"
      ]
    },
    "letar-db": {
      "type": "stdio",
      "command": "bun",
      "args": [
        ".claude/mcp/letar-db.ts"
      ]
    },
    "agent-mail": {
      "type": "http",
      "url": "http://127.0.0.1:8765/mcp"
    }
  }
}

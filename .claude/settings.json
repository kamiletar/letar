{
  "env": {
    "NX_SKIP_FORMAT": "true"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('path'),f=require('fs'),n=process.argv[1];let d=process.cwd();for(;;){const s=p.join(d,'.claude','hooks',n);if(f.existsSync(s)){require(s);break}const u=p.dirname(d);if(u===d)break;d=u}\" start-agent-mail.js"
          }
        ]
      },
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('path'),f=require('fs'),n=process.argv[1];let d=process.cwd();for(;;){const s=p.join(d,'.claude','hooks',n);if(f.existsSync(s)){require(s);break}const u=p.dirname(d);if(u===d)break;d=u}\" time-resume-reminder.js"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('path'),f=require('fs'),n=process.argv[1];let d=process.cwd();for(;;){const s=p.join(d,'.claude','hooks',n);if(f.existsSync(s)){require(s);break}const u=p.dirname(d);if(u===d)break;d=u}\" validate-bash.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/kill-e2e-port.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('path'),f=require('fs'),n=process.argv[1];let d=process.cwd();for(;;){const s=p.join(d,'.claude','hooks',n);if(f.existsSync(s)){require(s);break}const u=p.dirname(d);if(u===d)break;d=u}\" auto-format.js"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('path'),f=require('fs'),n=process.argv[1];let d=process.cwd();for(;;){const s=p.join(d,'.claude','hooks',n);if(f.existsSync(s)){require(s);break}const u=p.dirname(d);if(u===d)break;d=u}\" time-heartbeat.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('path'),f=require('fs'),n=process.argv[1];let d=process.cwd();for(;;){const s=p.join(d,'.claude','hooks',n);if(f.existsSync(s)){require(s);break}const u=p.dirname(d);if(u===d)break;d=u}\" time-stop-check.js"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context-mode@claude-context-mode": true
  }
}

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./out-tsc/spec",
    "tsBuildInfoFile": "./out-tsc/spec/tsconfig.spec.tsbuildinfo",
    "jsx": "react-jsx",
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "vitest.config.ts",
    "__tests__/**/*.test.ts",
    "__tests__/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ],
  "exclude": ["out-tsc", "dist", "node_modules"]
}

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "jsx": "react-jsx",
    "types": ["vitest/globals", "node"],
    "rootDir": "."
  },
  "include": [
    "vitest.config.ts",
    "__tests__/**/*.test.ts",
    "__tests__/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ]
}

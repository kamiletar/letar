{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": ["vitest/globals", "node"],
    "rootDir": "..",
    "jsx": "react-jsx",
    "paths": {
      "@letar/folder-scan": ["../folder-scan/src/index.ts"],
      "@letar/folder-scan/media-extensions": ["../folder-scan/src/lib/media-extensions.ts"]
    }
  },
  "include": [
    "vitest.config.mts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "vitest.setup.ts",
    "../folder-scan/src/**/*.ts"
  ]
}

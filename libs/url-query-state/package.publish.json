{
  "name": "@letar/url-query-state",
  "description": "Filter toggles (facets, chips) as real <a href> links synchronised with the URL query string, for Next.js App Router.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "import": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "files": [
    "**/*.js",
    "**/*.js.map",
    "**/*.d.ts",
    "**/*.d.ts.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "nextjs",
    "url",
    "query-string",
    "filters",
    "facets",
    "search-params",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamiletar/letar.git",
    "directory": "libs/url-query-state"
  },
  "bugs": {
    "url": "https://github.com/kamiletar/letar/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": ">=19.0.0"
  }
}

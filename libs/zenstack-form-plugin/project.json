{
  "name": "@letar/zenstack-form-plugin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/zenstack-form-plugin/src",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:util",
    "owner:letar"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{projectRoot}/tsconfig.lib.json"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "metadata": {
        "description": "Build plugin to JavaScript",
        "technologies": [
          "typescript"
        ]
      },
      "options": {
        "command": "tsc --project tsconfig.lib.json",
        "cwd": "libs/zenstack-form-plugin"
      }
    },
    "build:npm": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{projectRoot}/tsconfig.lib.json",
        "{projectRoot}/package.publish.json",
        "{projectRoot}/scripts/write-publish-package-json.mjs"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "metadata": {
        "description": "Сборка @letar/zenstack-form-plugin для публикации на npm",
        "technologies": [
          "typescript"
        ]
      },
      "options": {
        "commands": [
          "tsc --project tsconfig.lib.json",
          "node scripts/write-publish-package-json.mjs",
          "cp README.en.md dist/README.md",
          "cp README.md dist/README.ru.md",
          "cp CHANGELOG.md dist/"
        ],
        "cwd": "libs/zenstack-form-plugin",
        "parallel": false
      }
    },
    "test": {
      "options": {
        "config": "vitest.config.ts"
      }
    },
    "oxlint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/.oxlintrc.json"
      ],
      "metadata": {
        "description": "Fast lint with oxlint",
        "technologies": [
          "oxlint"
        ]
      },
      "options": {
        "command": "bunx oxlint src --config ../../.oxlintrc.json",
        "cwd": "libs/zenstack-form-plugin"
      }
    },
    "lint": {
      "dependsOn": [
        "oxlint"
      ],
      "metadata": {
        "description": "Run ESLint on zenstack-form-plugin library"
      },
      "options": {
        "args": [
          "**/*.ts"
        ]
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Format files with dprint",
        "technologies": [
          "dprint"
        ]
      },
      "options": {
        "command": "dprint fmt",
        "cwd": "libs/zenstack-form-plugin"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^typecheck"
      ],
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.lib.json",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "outputs": [
        "{projectRoot}/dist/**/*.d.ts",
        "{projectRoot}/dist/**/*.d.ts.map",
        "{projectRoot}/dist/tsconfig.lib.tsbuildinfo"
      ],
      "metadata": {
        "description": "Type-check library and generate declarations",
        "technologies": [
          "typescript"
        ]
      },
      "options": {
        "command": "tsc --build tsconfig.lib.json --emitDeclarationOnly",
        "cwd": "libs/zenstack-form-plugin"
      }
    },
    "typecheck:tsgo": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^typecheck:tsgo"
      ],
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.lib.json",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "outputs": [
        "{projectRoot}/dist/**/*.d.ts",
        "{projectRoot}/dist/**/*.d.ts.map",
        "{projectRoot}/dist/tsconfig.lib.tsbuildinfo"
      ],
      "metadata": {
        "description": "Type-check library with tsgo (38x faster)",
        "technologies": [
          "typescript",
          "tsgo"
        ]
      },
      "options": {
        "command": "tsgo --build tsconfig.lib.json --emitDeclarationOnly",
        "cwd": "libs/zenstack-form-plugin"
      }
    }
  }
}

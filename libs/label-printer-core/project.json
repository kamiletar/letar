{
  "name": "label-printer-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/label-printer-core/src",
  "projectType": "library",
  "tags": [
    "scope:label-printer",
    "type:core",
    "owner:letar"
  ],
  "targets": {
    "oxlint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/.oxlintrc.json"
      ],
      "metadata": {
        "description": "Fast lint with oxlint (50-100x faster than ESLint)",
        "technologies": [
          "oxlint"
        ]
      },
      "options": {
        "command": "bunx oxlint src --config ../../.oxlintrc.json",
        "cwd": "libs/label-printer-core"
      }
    },
    "lint": {
      "dependsOn": [
        "oxlint"
      ],
      "options": {
        "args": [
          "**/*.ts"
        ]
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Format files with dprint",
        "technologies": [
          "dprint"
        ]
      },
      "options": {
        "command": "dprint fmt",
        "cwd": "libs/label-printer-core"
      }
    },
    "typecheck:tsgo": {
      "command": "tsgo --project libs/label-printer-core/tsconfig.lib.json --noEmit"
    },
    "test": {
      "options": {
        "config": "vitest.config.ts",
        "coverage.reportsDirectory": "../../coverage/libs/label-printer-core"
      }
    }
  }
}

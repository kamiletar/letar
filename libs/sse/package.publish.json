{
  "name": "@letar/sse",
  "description": "Server-Sent Events helper for Next.js Route Handlers built on periodic polling: heartbeat, interval polling, optional auto-close timeout, single cleanup on cancel and abort.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "files": [
    "**/*.js",
    "**/*.js.map",
    "**/*.d.ts",
    "**/*.d.ts.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "sse",
    "server-sent-events",
    "nextjs",
    "route-handler",
    "polling",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamiletar/letar.git",
    "directory": "libs/sse"
  },
  "bugs": {
    "url": "https://github.com/kamiletar/letar/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-native",
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "types": [],
    "paths": {
      "@letar/animatrona-utils": ["../animatrona-utils/src/index.ts"]
    },
    "noUncheckedSideEffectImports": false,
    "ignoreDeprecations": "6.0",
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "references": [{ "path": "../animatrona-utils" }]
}

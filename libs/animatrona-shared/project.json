{
  "name": "@letar/animatrona-shared",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/animatrona-shared/src",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:native-module",
    "owner:letar"
  ],
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Format files with dprint",
        "technologies": [
          "dprint"
        ]
      },
      "options": {
        "command": "dprint fmt",
        "cwd": "libs/animatrona-shared"
      }
    },
    "lint": {
      "options": {
        "args": [
          "**/*.{ts,tsx}"
        ]
      }
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "options": {
        "cwd": "libs/animatrona-shared"
      }
    },
    "test": {
      "options": {
        "config": "vitest.config.ts"
      }
    }
  }
}

{
  "name": "@letar/form-mcp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/form-mcp/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:tool"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx tsx src/cli.ts",
        "cwd": "libs/form-mcp"
      },
      "metadata": {
        "description": "Run form MCP server via stdio",
        "technologies": ["mcp"]
      }
    },
    "oxlint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx oxlint src --config ../../.oxlintrc.json",
        "cwd": "libs/form-mcp"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/.oxlintrc.json"],
      "metadata": {
        "description": "Fast lint with oxlint",
        "technologies": ["oxlint"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "dependsOn": ["oxlint"],
      "options": {
        "lintFilePatterns": ["libs/form-mcp/**/*.{ts,tsx}"]
      },
      "metadata": {
        "description": "Run ESLint on form-mcp library",
        "technologies": ["eslint"]
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dprint fmt",
        "cwd": "libs/form-mcp"
      },
      "cache": false,
      "metadata": {
        "description": "Format files with dprint",
        "technologies": ["dprint"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --build tsconfig.lib.json --emitDeclarationOnly",
        "cwd": "libs/form-mcp"
      },
      "dependsOn": ["^typecheck"],
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.lib.json",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "outputs": [
        "{projectRoot}/dist/**/*.d.ts",
        "{projectRoot}/dist/**/*.d.ts.map",
        "{projectRoot}/dist/tsconfig.lib.tsbuildinfo"
      ],
      "metadata": {
        "description": "Type-check library and generate declarations",
        "technologies": ["typescript"]
      }
    },
    "typecheck:tsgo": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsgo --build tsconfig.lib.json --emitDeclarationOnly",
        "cwd": "libs/form-mcp"
      },
      "dependsOn": ["^typecheck:tsgo"],
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.lib.json",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "outputs": [
        "{projectRoot}/dist/**/*.d.ts",
        "{projectRoot}/dist/**/*.d.ts.map",
        "{projectRoot}/dist/tsconfig.lib.tsbuildinfo"
      ],
      "metadata": {
        "description": "Type-check library with tsgo (faster)",
        "technologies": ["typescript", "tsgo"]
      }
    },
    "build:npm": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "bunx tsup",
          "bunx tsx scripts/copy-docs.ts",
          "cp package.publish.json dist/package.json",
          "cp README.md dist/README.md",
          "cp README.ru.md dist/README.ru.md",
          "cp CHANGELOG.md dist/ 2>/dev/null || true"
        ],
        "cwd": "libs/form-mcp",
        "parallel": false
      },
      "cache": true,
      "inputs": [
        "default",
        "{projectRoot}/tsup.config.ts",
        "{projectRoot}/package.publish.json",
        "{workspaceRoot}/libs/forms/docs/**/*.md"
      ],
      "outputs": ["{projectRoot}/dist"],
      "metadata": {
        "description": "Build npm package with bundled docs",
        "technologies": ["tsup"]
      }
    },
    "publish:npm": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm publish --access public",
        "cwd": "libs/form-mcp/dist"
      },
      "dependsOn": ["build:npm"],
      "cache": false,
      "metadata": {
        "description": "Publish to npm as @letar/form-mcp",
        "technologies": ["npm"]
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "passWithNoTests": true
      },
      "metadata": {
        "description": "Run unit tests",
        "technologies": ["vitest"]
      }
    }
  }
}

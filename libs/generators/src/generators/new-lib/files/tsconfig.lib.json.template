{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
<% if (react) { %>    "lib": ["es2022", "dom", "dom.iterable"],
<% } %>    "outDir": "dist",
    "types": ["node"],
    "rootDir": "src",
<% if (react) { %>    "jsx": "react-jsx",
<% } %>    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "ignoreDeprecations": "6.0"
  },
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
<% if (react) { %>    "src/**/*.spec.tsx",
    "src/**/*.test.tsx",
<% } %>    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "include": ["src/**/*.ts"<% if (react) { %>, "src/**/*.tsx"<% } %>]
}

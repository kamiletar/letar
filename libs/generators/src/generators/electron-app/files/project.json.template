{
  "name": "<%= name %>",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/<%= name %>",
  "projectType": "application",
  "tags": ["type:app", "scope:<%= name %>", "owner:letar", "platform:electron"],
  "targets": {
    "dev": {
      "command": "node scripts/dev.js",
      "options": {
        "cwd": "apps/<%= name %>"
      }
    },
    "build:win": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "next build renderer",
          "npx webpack --config main/webpack.config.js",
          "npx electron-builder --win"
        ],
        "cwd": "apps/<%= name %>",
        "parallel": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/<%= name %>/main/**/*.{ts,tsx}", "apps/<%= name %>/renderer/**/*.{ts,tsx}"]
      }
    },
    "typecheck:tsgo": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsgo --project apps/<%= name %>/tsconfig.json --noEmit",
          "tsgo --project apps/<%= name %>/renderer/tsconfig.json --noEmit"
        ],
        "parallel": false
      }
    },
    "format": {
      "command": "dprint fmt apps/<%= name %>/**/*.{ts,tsx,json}"
    }
  }
}

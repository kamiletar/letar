/**
 * Генерация PNG/ICO иконок из resources/icon.svg
 * Запуск: node scripts/generate-icons.mjs
 */
import pngToIco from 'png-to-ico'
import { readFileSync, writeFileSync } from 'fs'
import { dirname, join } from 'path'
import sharp from 'sharp'
import { fileURLToPath } from 'url'

const __dirname = dirname(fileURLToPath(import.meta.url))
const resourcesDir = join(__dirname, '..', 'resources')
const sizes = [16, 24, 32, 48, 64, 128, 256, 512]

async function generateIcons() {
  const svg = readFileSync(join(resourcesDir, 'icon.svg'))
  console.log('Генерация PNG иконок из SVG...')

  const pngPaths = []
  for (const size of sizes) {
    const outputPath = join(resourcesDir, `icon-${size}.png`)
    await sharp(svg, { density: 384 }).resize(size, size).png().toFile(outputPath)
    pngPaths.push(outputPath)
    console.log(`  ✓ ${outputPath}`)
  }

  await sharp(svg, { density: 384 }).resize(256, 256).png().toFile(join(resourcesDir, 'icon.png'))
  console.log('  ✓ icon.png (256x256)')

  const icoBuffer = await pngToIco(pngPaths.filter((p) => /icon-(16|32|48|256)\.png$/.test(p)))
  writeFileSync(join(resourcesDir, 'icon.ico'), icoBuffer)
  console.log('  ✓ icon.ico')

  console.log('\nИконки сгенерированы!')
}

generateIcons().catch((err) => {
  console.error(err)
  process.exit(1)
})

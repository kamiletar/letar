{
  "name": "@letar/video-player-react",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/video-player-react/src",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:lib",
    "owner:letar"
  ],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^typecheck"
      ],
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.lib.json",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "outputs": [
        "{projectRoot}/dist/**/*.d.ts",
        "{projectRoot}/dist/**/*.d.ts.map",
        "{projectRoot}/dist/tsconfig.lib.tsbuildinfo"
      ],
      "metadata": {
        "description": "Type-check library and generate declarations",
        "technologies": [
          "typescript"
        ]
      },
      "options": {
        "command": "tsc --build tsconfig.lib.json --emitDeclarationOnly",
        "cwd": "libs/video-player-react"
      }
    },
    "typecheck:tsgo": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^typecheck:tsgo"
      ],
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.lib.json",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "metadata": {
        "description": "Fast type-check with tsgo",
        "technologies": [
          "typescript"
        ]
      },
      "options": {
        "command": "tsgo --project tsconfig.lib.json --noEmit",
        "cwd": "libs/video-player-react"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Format source files with dprint",
        "technologies": [
          "dprint"
        ]
      },
      "options": {
        "command": "dprint fmt",
        "cwd": "libs/video-player-react"
      }
    },
    "oxlint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/.oxlintrc.json"
      ],
      "metadata": {
        "description": "Fast lint with oxlint",
        "technologies": [
          "oxlint"
        ]
      },
      "options": {
        "command": "bunx oxlint src --config ../../.oxlintrc.json",
        "cwd": "libs/video-player-react"
      }
    },
    "lint": {
      "dependsOn": [
        "oxlint"
      ]
    },
    "test": {
      "metadata": {
        "description": "Run unit tests with Vitest"
      },
      "options": {
        "config": "vitest.config.ts"
      }
    }
  }
}

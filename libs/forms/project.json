{
  "name": "@letar/forms",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/forms/src",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:ui",
    "owner:letar"
  ],
  "targets": {
    "oxlint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/.oxlintrc.json"
      ],
      "metadata": {
        "description": "Fast lint with oxlint",
        "technologies": [
          "oxlint"
        ]
      },
      "options": {
        "command": "bunx oxlint src --config ../../.oxlintrc.json",
        "cwd": "libs/forms"
      }
    },
    "lint": {
      "dependsOn": [
        "oxlint"
      ],
      "metadata": {
        "description": "Run ESLint on form-components library"
      },
      "options": {
        "args": [
          "**/*.{ts,tsx}"
        ]
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Run ESLint with auto-fix",
        "technologies": [
          "eslint"
        ]
      },
      "options": {
        "command": "eslint . --fix",
        "cwd": "libs/forms"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Format files with dprint",
        "technologies": [
          "dprint"
        ]
      },
      "options": {
        "command": "dprint fmt",
        "cwd": "libs/forms"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/dprint.json"
      ],
      "metadata": {
        "description": "Check file formatting with dprint",
        "technologies": [
          "dprint"
        ]
      },
      "options": {
        "command": "dprint check",
        "cwd": "libs/forms"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^typecheck"
      ],
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.lib.json",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "outputs": [
        "{projectRoot}/dist/**/*.d.ts",
        "{projectRoot}/dist/**/*.d.ts.map",
        "{projectRoot}/dist/tsconfig.lib.tsbuildinfo"
      ],
      "metadata": {
        "description": "Type-check library and generate declarations",
        "technologies": [
          "typescript"
        ]
      },
      "options": {
        "command": "tsc --build tsconfig.lib.json --emitDeclarationOnly",
        "cwd": "libs/forms"
      }
    },
    "typecheck:tsgo": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^typecheck:tsgo"
      ],
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.lib.json",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "outputs": [
        "{projectRoot}/dist/**/*.d.ts",
        "{projectRoot}/dist/**/*.d.ts.map",
        "{projectRoot}/dist/tsconfig.lib.tsbuildinfo"
      ],
      "metadata": {
        "description": "Type-check library and generate declarations with tsgo (38x faster)",
        "technologies": [
          "typescript",
          "tsgo"
        ]
      },
      "options": {
        "command": "tsgo --build tsconfig.lib.json --emitDeclarationOnly",
        "cwd": "libs/forms"
      }
    },
    "validate": {
      "executor": "nx:noop",
      "dependsOn": [
        "lint",
        "format:check",
        "typecheck"
      ],
      "metadata": {
        "description": "Run all validation checks"
      }
    },
    "test": {
      "metadata": {
        "description": "Run unit tests"
      },
      "options": {
        "config": "vitest.config.ts"
      }
    },
    "build:npm": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{projectRoot}/tsup.config.ts",
        "{projectRoot}/package.publish.json",
        "{projectRoot}/scripts/write-publish-package-json.mjs"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "metadata": {
        "description": "Сборка @letar/forms для публикации на npm",
        "technologies": [
          "tsup"
        ]
      },
      "options": {
        "commands": [
          "tsup",
          "node scripts/write-publish-package-json.mjs",
          "cp README.en.md dist/README.md",
          "cp README.md dist/README.ru.md",
          "cp CHANGELOG.md dist/",
          "cp LICENSE dist/"
        ],
        "cwd": "libs/forms",
        "parallel": false
      }
    },
    "bench": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Бенчмарки производительности (ре-рендеры)",
        "technologies": [
          "vitest"
        ]
      },
      "options": {
        "command": "vitest bench --config vitest.config.ts --run",
        "cwd": "libs/forms"
      }
    },
    "size": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build:npm"
      ],
      "cache": true,
      "inputs": [
        "{projectRoot}/dist/**/*.js",
        "{projectRoot}/.size-limit.json"
      ],
      "metadata": {
        "description": "Проверка размера bundle",
        "technologies": [
          "size-limit"
        ]
      },
      "options": {
        "command": "bun size-limit --config .size-limit.json",
        "cwd": "libs/forms"
      }
    },
    "publish:npm": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build:npm"
      ],
      "cache": false,
      "metadata": {
        "description": "Публикация @letar/forms на npmjs.com",
        "technologies": [
          "npm"
        ]
      },
      "options": {
        "command": "npm publish --access public",
        "cwd": "libs/forms/dist"
      }
    }
  }
}

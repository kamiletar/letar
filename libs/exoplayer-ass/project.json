{
  "name": "exoplayer-ass",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/exoplayer-ass/src",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:native-module",
    "owner:letar"
  ],
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "description": "Format files with dprint",
        "technologies": [
          "dprint"
        ]
      },
      "options": {
        "command": "dprint fmt",
        "cwd": "libs/exoplayer-ass"
      }
    },
    "lint": {
      "options": {
        "args": [
          "**/*.{ts,tsx}"
        ]
      }
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "options": {
        "cwd": "libs/exoplayer-ass"
      }
    }
  }
}

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-native",
    "declaration": true,
    "declarationMap": true,
    "types": ["react-native"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "noUncheckedSideEffectImports": false,
    "ignoreDeprecations": "6.0",
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "android", "dist"]
}

{
  "name": "@letar/driving-school-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./prisma": {
      "types": "./src/generated/prisma/index.ts",
      "import": "./src/generated/prisma/index.ts",
      "default": "./src/generated/prisma/index.ts"
    },
    "./prisma/enums": {
      "types": "./src/generated/prisma/enums.ts",
      "import": "./src/generated/prisma/enums.ts",
      "default": "./src/generated/prisma/enums.ts"
    },
    "./schema": {
      "types": "./src/generated/schema.ts",
      "import": "./src/generated/schema.ts",
      "default": "./src/generated/schema.ts"
    },
    "./models": {
      "types": "./src/generated/models.ts",
      "import": "./src/generated/models.ts",
      "default": "./src/generated/models.ts"
    },
    "./input": {
      "types": "./src/generated/input.ts",
      "import": "./src/generated/input.ts",
      "default": "./src/generated/input.ts"
    },
    "./form-schemas/enums/*": {
      "types": "./src/generated/form-schemas/enums/*",
      "import": "./src/generated/form-schemas/enums/*",
      "default": "./src/generated/form-schemas/enums/*"
    },
    "./form-schemas/*": {
      "types": "./src/generated/form-schemas/*",
      "import": "./src/generated/form-schemas/*",
      "default": "./src/generated/form-schemas/*"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "driving-school-db"
  }
}

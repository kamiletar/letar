{
  "name": "@letar/number-words",
  "description": "Convert numbers to words (cardinal and ordinal) in many locales, including RTL, on top of to-words.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "files": [
    "**/*.js",
    "**/*.js.map",
    "**/*.d.ts",
    "**/*.d.ts.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "number-to-words",
    "numbers",
    "ordinal",
    "i18n",
    "rtl",
    "russian",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamiletar/letar.git",
    "directory": "libs/number-words"
  },
  "bugs": {
    "url": "https://github.com/kamiletar/letar/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "dependencies": {
    "to-words": "^5.3.0"
  }
}

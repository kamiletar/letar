# PostgreSQL Backup Configuration for premium-rosstil (Docker)

# Database connection (inside Docker container)
# These values match docker-compose.production.yml configuration
DB_NAME=lena_premium
DB_USER=lena_user
DOCKER_CONTAINER=premium-rosstil-postgres

# Backup configuration
BACKUP_DIR=/backups/premium-rosstil/db
RETENTION_DAYS=30

# Note: DB_PASSWORD is not needed here because we use Docker exec
# which doesn't require password authentication from the host.
# The password is only in .env.docker for the application.

# Optional: Remote backup location (rsync, S3, etc.)
# REMOTE_BACKUP_ENABLED=true
# REMOTE_BACKUP_HOST=backup.example.com
# REMOTE_BACKUP_PATH=/backups/premium-rosstil
# REMOTE_BACKUP_USER=backup

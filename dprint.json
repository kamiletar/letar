{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 120,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "typescript": {
    "quoteStyle": "preferSingle",
    "semiColons": "asi",
    "trailingCommas": "onlyMultiLine",
    "arrowFunction.useParentheses": "force",
    "quoteProps": "asNeeded",
    "jsx.quoteStyle": "preferDouble",
    "useBraces": "always"
  },
  "json": {
    "indentWidth": 2,
    "useTabs": false,
    "trailingCommas": "never"
  },
  "markdown": {
    "lineWidth": 120,
    "textWrap": "maintain"
  },
  "includes": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs", "**/*.json", "**/*.md"],
  "excludes": [
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/.next",
    "**/out",
    "**/coverage",
    "**/.nx/cache",
    "**/.nx/workspace-data",
    "**/src/generated",
    "apps/archetest/docs/question-bank-audit.md",
    "apps/archetest/docs/question-bank-audit.json",
    "**/*.log",
    ".vscode",
    ".idea",
    "**/.env*.local",
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    "bun.lock",
    "bun.lockb",
    ".claude/worktrees",
    ".claude/private",
    "apps/aboi",
    "apps/aboi-e2e",
    "apps/aprel8008",
    "apps/domwellbes",
    "apps/domwellbes-e2e",
    "apps/driving-school",
    "apps/driving-school-e2e",
    "apps/dsperevod",
    "apps/poster-microtext-desktop",
    "apps/studio",
    "apps/studio-e2e",
    "apps/svoichuzhie",
    "libs/driving-school-db"
  ],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.95.3.wasm",
    "https://plugins.dprint.dev/json-0.19.4.wasm",
    "https://plugins.dprint.dev/markdown-0.17.8.wasm"
  ]
}

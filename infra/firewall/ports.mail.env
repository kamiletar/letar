# mail-сервер (31.56.180.161) — конфигурация docker-user-firewall.sh
# Источник значений — PLAN-INFRA.md §49 (раздел «Уровень 2 применён на mail-сервере»),
# .claude/docs/firewall.md.
# ⚠️ РЕКОНСТРУКЦИЯ по документации, не сверена побайтово с живым /etc/docker-user-firewall.env
# на сервере — см. infra/firewall/README.md, раздел «Статус сверки».

# 80,443 — сайты за NPM. 25,465,587,993 — почта (Maddy). 8080 — КОНТЕЙНЕРНЫЙ порт
# animatrona-relay (маппинг 41080:8080 не 1:1, DOCKER-USER видит порт после DNAT — см.
# .claude/docs/firewall.md, «В DOCKER-USER указывать порт КОНТЕЙНЕРА»). 81 (админка NPM) —
# намеренно НЕ в списке, доступ только через SSH-туннель.
TCP_PORTS=80,443,25,465,587,993,4001,8080
UDP_PORTS=

# ⚠️ На mail-сервере IPv6 INPUT уже закрыт другим механизмом: это единственный из трёх серверов,
# где ufw реально активен (-P INPUT DROP). НЕ включать здесь ip6tables-блок default-deny поверх —
# рассинхрон между ufw и этим скриптом обнаружится не сразу и может отрезать легитимный трафик
# или создать ложное чувство защищённости при рассогласовании списков портов.
ENABLE_IPV6_INPUT=0
# Интерфейс — не задокументирован явно в PLAN-INFRA §49 для mail; автоопределение должно сработать,
# EXT_IFACE_OVERRIDE не задан. Проверить при сверке с BlackCove.

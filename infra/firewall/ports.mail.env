# mail-сервер (31.56.180.161) — конфигурация docker-user-firewall.sh
# Источник значений — PLAN-INFRA.md §49 (раздел «Уровень 2 применён на mail-сервере»),
# .claude/docs/firewall.md.
# Сверено побайтово с реальным /usr/local/sbin/docker-user-firewall.sh (BlackCove, 2026-08-08,
# тред firewall-versioning) — см. infra/firewall/README.md, раздел «Статус сверки».

# 80,443 — сайты за NPM. 25,465,587,993 — почта (Maddy). 8080 — КОНТЕЙНЕРНЫЙ порт
# animatrona-relay (маппинг 41080:8080 не 1:1, DOCKER-USER видит порт после DNAT — см.
# .claude/docs/firewall.md, «В DOCKER-USER указывать порт КОНТЕЙНЕРА»). 81 (админка NPM) —
# намеренно НЕ в списке, доступ только через SSH-туннель.
TCP_PORTS=80,443,25,465,587,993,4001,8080
UDP_PORTS=

# ИСПРАВЛЕНО после сверки: изначальное предположение «ufw на mail заменяет этот блок» было
# неверным — реальный скрипт применяет ip6tables INPUT default-deny наравне с s2/s3, ufw (-P
# INPUT DROP) работает как независимый дополнительный слой, а не альтернатива.
ENABLE_IPV6_INPUT=1
# Интерфейс на mail — eth0 (подтверждено BlackCove; отличается от s3/ens3, совпадает с s2).
EXT_IFACE_OVERRIDE=eth0

# s3.letar.best — конфигурация docker-user-firewall.sh
# Источник значений — PLAN-INFRA.md §49, §57, .claude/docs/firewall.md.
# Сверено побайтово с реальным /usr/local/sbin/docker-user-firewall.sh (BlackCove, 2026-08-08,
# тред firewall-versioning) — см. infra/firewall/README.md, раздел «Статус сверки».

# 81 — админка NPM, HTTPS-пути к ней на s3 нет (все 16 proxy hosts проверены); резать нельзя,
#      пока не заведён домен с сертификатом (см. §48 — Traefik).
# 4001 — swarm kubo (IPFS), входящие нужны для пиринга; 5001/8080 у него уже на loopback.
# 443/udp — HTTP/3 (QUIC) у Traefik на боевом порту. ⚠️ Открыть UDP обязательно отдельно: TCP 443
#      уже был открыт под NPM, и на нём всё «работает», а HTTP/3 отвалится молча — браузер
#      откатится на TCP через Alt-Svc, ошибок нигде не будет.
# 8090, 8443 — пилотные порты Traefik. С 2026-08-08 не используются (переезд на 80/443, §48 M2),
#      но ОСТАВЛЕНЫ на время окна отката: вернуть NPM на 80/443 и Traefik на пилотные порты можно
#      будет без правки firewall. Убрать вместе с остальными путями отката — см. «Уборка после
#      недели без инцидентов» в §48 M2.
# 81 — админка NPM. Остаётся по той же причине: NPM остановлен, но не удалён.
TCP_PORTS=80,443,81,4001,8090,8443
UDP_PORTS=4001,443,8443
ENABLE_IPV6_INPUT=1
# Интерфейс на s3 — ens3, отличается от s2/eth0.
EXT_IFACE_OVERRIDE=ens3

# ipfsstor4 (NPM-форвард на 172.19.0.1:42080) слушает network_mode: host — мимо DOCKER-USER,
# закрыт точечным DROP в INPUT (§57). Сужено по интерфейсу — фильтр по source 127.0.0.1 ломал
# легитимный форвард с NPM через docker-бридж.
HOST_DENY_TCP_PORTS=42080

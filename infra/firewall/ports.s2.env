# s2.letar.best — конфигурация docker-user-firewall.sh
# Источник значений — PLAN-INFRA.md §49, .claude/docs/firewall.md.
# Сверено побайтово с реальным /usr/local/sbin/docker-user-firewall.sh (BlackCove, 2026-08-08,
# тред firewall-versioning) — значения совпали без изменений.

TCP_PORTS=80,443,53
# 443/udp — HTTP/3 (QUIC) у Traefik. Traefik на s2 уже анонсирует `Alt-Svc: h3` и слушает UDP 443,
# но без этого порта firewall молча дропал QUIC (2026-10-23): браузер ждал таймаут и откатывался
# на TCP. Так же устроен s3 (ports.s3.env) — открывать UDP нужно отдельно от TCP.
UDP_PORTS=53,443
ENABLE_IPV6_INPUT=1
# Интерфейс на s2 — eth0, автоопределение (ip route get 8.8.8.8) должно давать его само.
# EXT_IFACE_OVERRIDE не задан.

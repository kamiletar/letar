# Шаблон для infra/gateway-cache/.env на сервере (сам файл — в .gitignore, см. `infra/*/.env`
# в корневом .gitignore, не коммитится).
#
# Копировать один раз при первом деплое:
#   cp infra/gateway-cache/.env.example infra/gateway-cache/.env
#
# Список доменов для `valid_referers none blocked <тут>;` (см. nginx.conf) — слабая защита от
# прямого расшаривания ссылки (см. infra/media-server/nginx.conf — тот же приём), не полноценная
# авторизация: подделать Referer тривиально. Формат — как в самой nginx-директиве valid_referers
# (список через пробел, `*.domain.tld` работает как shell-подобный wildcard).
#
# letar.best — собственный домен студии, не коммерческий домен клиента, поэтому здесь безопасен.
# Единственный текущий потребитель gateway.letar.best — animatrona-tracker (*.letar.best).
GATEWAY_VALID_REFERERS=*.letar.best

# Если завтра появится клиентский домен-потребитель (коммерческий, не letar.best) — дописывать
# ТОЛЬКО в реальный .env на сервере, никогда в этот .example-файл и никогда в git
# (см. .claude/rules/public-repo-hygiene.md — запрет на коммерческие домены в публичном репо).

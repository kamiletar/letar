{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "cacheDirectory": ".nx/cache",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s"
    ],
    "sharedGlobals": []
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      },
      "exclude": [
        "libs/auth/*",
        "libs/*",
        "libs/admin-ui/*",
        "libs/hooks/*",
        "libs/query-provider/*",
        "libs/image-upload/*"
      ]
    },
    {
      "plugin": "@nx/next/plugin",
      "exclude": ["apps/form-docs/**"],
      "options": {
        "startTargetName": "start",
        "buildTargetName": "build",
        "devTargetName": "dev",
        "serveStaticTargetName": "serve-static",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e"
      }
    },
    {
      "plugin": "@nx/js/typescript",
      "include": [
        "libs/auth/*",
        "libs/*",
        "libs/admin-ui/*",
        "libs/hooks/*",
        "libs/query-provider/*",
        "libs/image-upload/*"
      ],
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        }
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "vitest:test",
        "ciTargetName": "test-ci",
        "testMode": "watch"
      }
    }
  ],
  "targetDefaults": {
    "test": {
      "dependsOn": ["^build"]
    },
    "@nx/esbuild:esbuild": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "oxlint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx oxlint {projectRoot}/src --config .oxlintrc.json",
        "cwd": "{workspaceRoot}"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/.oxlintrc.json"]
    },
    "dprint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx dprint fmt \"{projectRoot}/**/*.{ts,tsx,js,jsx,json,md}\"",
        "cwd": "{workspaceRoot}"
      },
      "cache": false,
      "metadata": {
        "description": "Format files with dprint (~30x faster than Prettier)",
        "technologies": ["dprint"]
      }
    },
    "dprint:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx dprint check \"{projectRoot}/**/*.{ts,tsx,js,jsx,json,md}\"",
        "cwd": "{workspaceRoot}"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/dprint.json"],
      "metadata": {
        "description": "Check formatting with dprint",
        "technologies": ["dprint"]
      }
    }
  },
  "generators": {
    "@nx/next": {
      "application": {
        "style": "css",
        "linter": "eslint"
      }
    },
    "@nx/react": {
      "library": {
        "unitTestRunner": "jest"
      }
    }
  },
  "sync": {
    "applyChanges": true,
    "disabledTaskSyncGenerators": ["@nx/js:typescript-sync"]
  },
  "nxCloudId": "68fa01460376c3d05dadaf77",
  "parallel": 3,
  "daemon": {
    "enabled": true
  },
  "analytics": true,
  "release": {
    "projectsRelationship": "independent",
    "version": {
      "conventionalCommits": true,
      "preserveLocalDependencyProtocols": true
    },
    "changelog": {
      "automaticFromRef": true,
      "projectChangelogs": {
        "createRelease": "github",
        "renderOptions": {
          "authors": true,
          "commitReferences": true,
          "versionTitleDate": true
        }
      },
      "workspaceChangelog": false
    },
    "git": {
      "commit": true,
      "commitMessage": "chore(release): publish {version}",
      "tag": true,
      "tagMessage": "{version}",
      "push": false
    }
  }
}

{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "cacheDirectory": ".nx/cache",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s"
    ],
    "sharedGlobals": []
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      },
      "exclude": [
        "libs/auth/*",
        "libs/*",
        "libs/admin-ui/*",
        "libs/hooks/*",
        "libs/query-provider/*",
        "libs/image-upload/*"
      ]
    },
    {
      "plugin": "@nx/next/plugin",
      "exclude": [
        "apps/form-docs/**"
      ],
      "options": {
        "startTargetName": "start",
        "buildTargetName": "build",
        "devTargetName": "dev",
        "serveStaticTargetName": "serve-static",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "exclude": [
        "eslint.config.mjs"
      ],
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e"
      }
    },
    {
      "plugin": "@nx/js/typescript",
      "include": [
        "libs/auth/*",
        "libs/*",
        "libs/admin-ui/*",
        "libs/hooks/*",
        "libs/query-provider/*",
        "libs/image-upload/*"
      ],
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        }
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "vitest:test",
        "ciTargetName": "test-ci",
        "testMode": "watch"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "testMode": "watch"
      },
      "include": [
        "apps/aboi/**/*",
        "apps/aira-web/**/*",
        "apps/animatrona/**/*",
        "apps/animatrona-tracker/**/*",
        "apps/aprel8008/**/*",
        "apps/archetest/**/*",
        "apps/auth-hub/**/*",
        "apps/dashboard-agent/**/*",
        "apps/driving-school/**/*",
        "apps/dsperevod/**/*",
        "apps/form-develop-app-shadcn/**/*",
        "apps/grandslamcup/**/*",
        "apps/kami/**/*",
        "apps/label-printer-desktop/**/*",
        "apps/mandala/**/*",
        "apps/poster-microtext-desktop/**/*",
        "apps/pravda/**/*",
        "apps/studio/**/*",
        "apps/svoichuzhie/**/*",
        "apps/synth/**/*",
        "apps/time/**/*",
        "libs/admin-ui/**/*",
        "libs/analytics/**/*",
        "libs/animatrona-franchise-graph/**/*",
        "libs/animatrona-shared/**/*",
        "libs/animatrona-ui/**/*",
        "libs/animatrona-utils/**/*",
        "libs/api-server/**/*",
        "libs/auth/**/*",
        "libs/chakra-provider/**/*",
        "libs/consent/**/*",
        "libs/contract-generator/**/*",
        "libs/demo-protection/**/*",
        "libs/deploy-engine/**/*",
        "libs/deploy-mcp/**/*",
        "libs/e2e-testing/**/*",
        "libs/electron-storage/**/*",
        "libs/email/**/*",
        "libs/form-mcp/**/*",
        "libs/format-utils/**/*",
        "libs/forms/**/*",
        "libs/forms-angular/**/*",
        "libs/forms-core/**/*",
        "libs/forms-react/**/*",
        "libs/forms-shadcn/**/*",
        "libs/forms-vue/**/*",
        "libs/forms-vue-shadcn/**/*",
        "libs/generators/**/*",
        "libs/github-releases/**/*",
        "libs/glitchtip/**/*",
        "libs/glitchtip-mcp/**/*",
        "libs/hooks/**/*",
        "libs/image-upload/**/*",
        "libs/infra-config/**/*",
        "libs/jobs/**/*",
        "libs/label-printer-core/**/*",
        "libs/mcp-server-kit/**/*",
        "libs/media-client/**/*",
        "libs/number-words/**/*",
        "libs/pin-auth/**/*",
        "libs/query-provider/**/*",
        "libs/redis-client/**/*",
        "libs/seo/**/*",
        "libs/studio-mcp/**/*",
        "libs/studio-time-mcp/**/*",
        "libs/tailwind-utils/**/*",
        "libs/ui/**/*",
        "libs/umami-mcp/**/*",
        "libs/validation-utils/**/*",
        "libs/video-player-core/**/*",
        "libs/video-player-react/**/*",
        "libs/yandex-metrika/**/*",
        "libs/zenstack-form-plugin/**/*",
        "libs/zenstack-fragments/**/*"
      ]
    }
  ],
  "targetDefaults": {
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "@nx/esbuild:esbuild": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ]
    },
    "oxlint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx oxlint {projectRoot}/src --config .oxlintrc.json",
        "cwd": "{workspaceRoot}"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/.oxlintrc.json"
      ]
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx dprint fmt \"{projectRoot}/**/*.{ts,tsx,js,jsx,json,md}\"",
        "cwd": "{workspaceRoot}"
      },
      "cache": false,
      "metadata": {
        "description": "Format files with dprint (~30x faster than Prettier)",
        "technologies": [
          "dprint"
        ]
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx dprint check \"{projectRoot}/**/*.{ts,tsx,js,jsx,json,md}\"",
        "cwd": "{workspaceRoot}"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/dprint.json"
      ],
      "metadata": {
        "description": "Check formatting with dprint",
        "technologies": [
          "dprint"
        ]
      }
    }
  },
  "generators": {
    "@nx/next": {
      "application": {
        "style": "css",
        "linter": "eslint"
      }
    },
    "@nx/react": {
      "library": {
        "unitTestRunner": "jest"
      }
    }
  },
  "sync": {
    "applyChanges": true,
    "disabledTaskSyncGenerators": [
      "@nx/js:typescript-sync"
    ]
  },
  "parallel": 3,
  "daemon": {
    "enabled": true
  },
  "analytics": true,
  "release": {
    "projectsRelationship": "independent",
    "version": {
      "conventionalCommits": true,
      "preserveLocalDependencyProtocols": true
    },
    "changelog": {
      "automaticFromRef": true,
      "projectChangelogs": {
        "createRelease": "github",
        "renderOptions": {
          "authors": true,
          "commitReferences": true,
          "versionTitleDate": true
        }
      },
      "workspaceChangelog": false
    },
    "git": {
      "commit": true,
      "commitMessage": "chore(release): publish {version}",
      "tag": true,
      "tagMessage": "{version}",
      "push": false
    }
  }
}
